@model IEnumerable<ThriftHub.Models.Notification>

@{
    ViewData["Title"] = "Notifications";

    var notifications = Model?.ToList()
        ?? new List<ThriftHub.Models.Notification>();

    var unreadCount = notifications.Count(n => !n.IsRead);
}

<div class="notification-page">

    <div class="notification-container">

        <!-- ========================================================
             HEADER
             ======================================================== -->

        <div class="notification-header">

            <div>
                <div class="notification-label">
                    THRIFTHUB
                </div>

                <h1>
                    Notifications
                </h1>

                <p>
                    Stay updated with activity on your account.
                </p>
            </div>

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="back-button">
                ← Dashboard
            </a>

        </div>


        <!-- ========================================================
             SUCCESS MESSAGE
             ======================================================== -->

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="success-message">
                ✓ @TempData["SuccessMessage"]
            </div>
        }


        <!-- ========================================================
             NOTIFICATION SUMMARY
             ======================================================== -->

        <div class="notification-toolbar">

            <div>
                <strong>
                    @notifications.Count
                </strong>

                notification@(notifications.Count == 1 ? "" : "s")

                @if (unreadCount > 0)
                {
                    <span class="unread-summary">
                        @unreadCount unread
                    </span>
                }
            </div>


            @if (unreadCount > 0)
            {
                <form asp-controller="Notifications"
                      asp-action="MarkAllAsRead"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="mark-all-button">

                        ✓ Mark all as read

                    </button>

                </form>
            }

        </div>


        <!-- ========================================================
             NOTIFICATIONS
             ======================================================== -->

        @if (notifications.Any())
        {
            <div class="notifications-list">

                @foreach (var notification in notifications)
                {
                    <div class="notification-card
                        @(notification.IsRead
                            ? "notification-read"
                            : "notification-unread")">

                        <div class="notification-icon">

                            @if (notification.IsRead)
                            {
                                <span>✓</span>
                            }
                            else
                            {
                                <span>🔔</span>
                            }

                        </div>


                        <div class="notification-content">

                            <div class="notification-message">

                                @notification.Message

                            </div>

                            <div class="notification-date">

                               @(notification.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt"))

                            </div>


                            <!-- =================================================
                                 ACTIONS
                                 ================================================= -->

                            <div class="notification-actions">

                                @if (!notification.IsRead)
                                {
                                    <form asp-controller="Notifications"
                                          asp-action="MarkAsRead"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@notification.Id" />

                                        <button type="submit"
                                                class="read-button">

                                            Mark as read

                                        </button>

                                    </form>
                                }


                                @if (!string.IsNullOrWhiteSpace(
                                    notification.Link))
                                {
                                    <!-- =================================================
                                         OPEN NOTIFICATION
                                         Marks as read BEFORE opening the message
                                         ================================================= -->

                                    <form asp-controller="Notifications"
                                          asp-action="MarkAsRead"
                                          method="post"
                                          style="margin:0;">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@notification.Id" />

                                        <button type="submit"
                                                class="open-button">

                                            Open →

                                        </button>

                                    </form>
                                }


                                <form asp-controller="Notifications"
                                      asp-action="Delete"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@notification.Id" />

                                    <button type="submit"
                                            class="delete-button"
                                            onclick="return confirm('Delete this notification?');">

                                        Delete

                                    </button>

                                </form>

                            </div>

                        </div>


                        @if (!notification.IsRead)
                        {
                            <div class="unread-dot"></div>
                        }

                    </div>
                }

            </div>
        }
        else
        {
            <!-- =====================================================
                 EMPTY STATE
                 ===================================================== -->

            <div class="empty-notifications">

                <div class="empty-icon">
                    🔔
                </div>

                <h2>
                    No notifications yet
                </h2>

                <p>
                    When there is activity on your ThriftHub account,
                    your notifications will appear here.
                </p>

                <a asp-controller="MarketPlace"
                   asp-action="Index"
                   class="browse-button">

                    Browse Marketplace

                </a>

            </div>
        }

    </div>

</div>


<style>

    /* ============================================================
       PAGE
       ============================================================ */

    .notification-page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 45px 20px 70px;
        font-family: Arial, Helvetica, sans-serif;
    }


    .notification-container {
        width: 100%;
    }


    /* ============================================================
       HEADER
       ============================================================ */

    .notification-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 30px;
    }


    .notification-label {
        color: #6f3cc3;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.5px;
        margin-bottom: 8px;
    }


    .notification-header h1 {
        margin: 0;
        font-size: 34px;
        color: #252238;
        font-weight: 800;
    }


    .notification-header p {
        margin: 8px 0 0;
        color: #777386;
        font-size: 14px;
    }


    .back-button {
        display: inline-block;
        text-decoration: none;
        background: #6f3cc3;
        color: white;
        padding: 11px 18px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
    }


    .back-button:hover {
        background: #54249c;
        color: white;
    }


    /* ============================================================
       SUCCESS
       ============================================================ */

    .success-message {
        background: #eaf8ef;
        border: 1px solid #c8ecd5;
        color: #19733a;
        padding: 14px 17px;
        border-radius: 9px;
        margin-bottom: 20px;
        font-size: 14px;
    }


    /* ============================================================
       TOOLBAR
       ============================================================ */

    .notification-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        background: white;
        border: 1px solid #eee9f5;
        border-radius: 12px;
        padding: 15px 18px;
        margin-bottom: 18px;
        color: #777386;
        font-size: 13px;
    }


    .notification-toolbar strong {
        color: #252238;
        font-size: 15px;
    }


    .unread-summary {
        margin-left: 8px;
        color: #6f3cc3;
        font-weight: 700;
    }


    .mark-all-button {
        border: none;
        background: #6f3cc3;
        color: white;
        padding: 9px 14px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
    }


    .mark-all-button:hover {
        background: #54249c;
    }


    /* ============================================================
       NOTIFICATION LIST
       ============================================================ */

    .notifications-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }


    .notification-card {
        position: relative;
        display: flex;
        gap: 15px;
        align-items: flex-start;
        padding: 19px;
        border-radius: 12px;
        border: 1px solid #eee9f5;
        transition: .2s ease;
    }


    .notification-card:hover {
        box-shadow: 0 8px 25px rgba(70,40,110,.08);
        transform: translateY(-1px);
    }


    .notification-unread {
        background: #f8f3ff;
        border-color: #ded0f5;
    }


    .notification-read {
        background: white;
    }


    /* ============================================================
       ICON
       ============================================================ */

    .notification-icon {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: #eee8ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
        flex-shrink: 0;
    }


    /* ============================================================
       CONTENT
       ============================================================ */

    .notification-content {
        flex: 1;
        min-width: 0;
    }


    .notification-message {
        color: #252238;
        font-size: 14px;
        font-weight: 600;
        line-height: 1.5;
    }


    .notification-date {
        margin-top: 6px;
        color: #9993a5;
        font-size: 11px;
    }


    /* ============================================================
       ACTIONS
       ============================================================ */

    .notification-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        margin-top: 12px;
    }


    .notification-actions form {
        margin: 0;
    }


    .read-button,
    .open-button,
    .delete-button {
        border: none;
        padding: 7px 11px;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
    }


    .read-button {
        background: #eee8ff;
        color: #6f3cc3;
    }


    .open-button {
        background: #6f3cc3;
        color: white;
    }


    .delete-button {
        background: #fff0f0;
        color: #b42318;
    }


    .read-button:hover {
        background: #ded2f5;
    }


    .open-button:hover {
        background: #54249c;
        color: white;
    }


    .delete-button:hover {
        background: #ffe0e0;
    }


    /* ============================================================
       UNREAD DOT
       ============================================================ */

    .unread-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #6f3cc3;
        flex-shrink: 0;
        margin-top: 6px;
    }


    /* ============================================================
       EMPTY STATE
       ============================================================ */

    .empty-notifications {
        text-align: center;
        background: white;
        border: 1px solid #eee9f5;
        border-radius: 16px;
        padding: 60px 25px;
    }


    .empty-icon {
        font-size: 45px;
        margin-bottom: 15px;
    }


    .empty-notifications h2 {
        margin: 0 0 8px;
        color: #252238;
        font-size: 22px;
    }


    .empty-notifications p {
        max-width: 500px;
        margin: 0 auto 20px;
        color: #777386;
        font-size: 13px;
        line-height: 1.6;
    }


    .browse-button {
        display: inline-block;
        background: #6f3cc3;
        color: white;
        text-decoration: none;
        padding: 11px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
    }


    .browse-button:hover {
        background: #54249c;
        color: white;
    }


    /* ============================================================
       MOBILE
       ============================================================ */

    @@media (max-width: 600px) {

        .notification-page {
            padding: 28px 15px 50px;
        }


        .notification-header {
            flex-direction: column;
            align-items: flex-start;
        }


        .notification-header h1 {
            font-size: 28px;
        }


        .back-button {
            width: 100%;
            text-align: center;
        }


        .notification-toolbar {
            flex-direction: column;
            align-items: flex-start;
        }


        .mark-all-button {
            width: 100%;
        }


        .notification-card {
            padding: 15px;
        }


        .notification-icon {
            width: 40px;
            height: 40px;
        }


        .unread-dot {
            display: none;
        }
    }

</style>