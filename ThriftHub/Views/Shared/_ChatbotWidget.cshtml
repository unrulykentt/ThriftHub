<div id="thChatbotRoot"
     class="th-chatbot-root"
     aria-live="polite">

    <div id="thChatbotPanel"
         class="th-chatbot-panel"
         hidden>

        <div class="th-chatbot-header">

            <div>

                <strong>ThriftHub Help</strong>

                <div class="th-chatbot-subtitle">
                    Ask about buying, selling, categories, and more
                </div>

            </div>

            <button type="button"
                    id="thChatbotClose"
                    class="th-chatbot-close"
                    aria-label="Close help chat">
                ×
            </button>

        </div>

        <div id="thChatbotMessages"
             class="th-chatbot-messages">

            <div class="th-chatbot-message th-chatbot-message-bot">

                Hi! I'm the ThriftHub assistant. Ask me anything about the site.

            </div>

        </div>

        <div id="thChatbotSuggestions"
             class="th-chatbot-suggestions">

            <button type="button"
                    class="th-chatbot-suggestion"
                    data-question="How do I buy an item?">
                How do I buy?
            </button>

            <button type="button"
                    class="th-chatbot-suggestion"
                    data-question="How do I sell on ThriftHub?">
                How do I sell?
            </button>

            <button type="button"
                    class="th-chatbot-suggestion"
                    data-question="What fashion categories are available?">
                Fashion categories
            </button>

            <button type="button"
                    class="th-chatbot-suggestion"
                    data-question="How do reviews work?">
                Reviews
            </button>

        </div>

        <form id="thChatbotForm"
              class="th-chatbot-form">

            <input type="text"
                   id="thChatbotInput"
                   class="th-chatbot-input"
                   placeholder="Type your question..."
                   maxlength="500"
                   autocomplete="off" />

            <button type="submit"
                    class="th-chatbot-send"
                    aria-label="Send question">
                ➤
            </button>

        </form>

    </div>

    <button type="button"
            id="thChatbotToggle"
            class="th-chatbot-toggle"
            aria-expanded="false"
            aria-controls="thChatbotPanel"
            aria-label="Open ThriftHub help chat">
        💬
    </button>

</div>

<style>

    .th-chatbot-root {
        position: fixed;
        right: 18px;
        bottom: 88px;
        z-index: 1200;
    }

    .th-chatbot-toggle {
        width: 56px;
        height: 56px;
        border: none;
        border-radius: 50%;
        background: #6c3dd9;
        color: #fff;
        font-size: 24px;
        line-height: 1;
        box-shadow: 0 10px 24px rgba(108, 61, 217, 0.35);
        cursor: pointer;
    }

    .th-chatbot-toggle:hover {
        background: #54249c;
    }

    .th-chatbot-panel {
        position: absolute;
        right: 0;
        bottom: 68px;
        width: min(360px, calc(100vw - 36px));
        height: 480px;
        display: flex;
        flex-direction: column;
        background: #fff;
        border: 1px solid #ece7f5;
        border-radius: 18px;
        box-shadow: 0 18px 40px rgba(37, 34, 56, 0.18);
        overflow: hidden;
    }

    .th-chatbot-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        padding: 14px 16px;
        background: #f7f4ff;
        border-bottom: 1px solid #ece7f5;
    }

    .th-chatbot-header strong {
        display: block;
        font-size: 15px;
        color: #252238;
    }

    .th-chatbot-subtitle {
        margin-top: 3px;
        font-size: 11px;
        color: #777386;
        font-weight: 600;
    }

    .th-chatbot-close {
        border: none;
        background: transparent;
        color: #777386;
        font-size: 24px;
        line-height: 1;
        cursor: pointer;
        padding: 0;
    }

    .th-chatbot-messages {
        flex: 1;
        overflow-y: auto;
        padding: 14px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        background: #fcfbfe;
    }

    .th-chatbot-message {
        max-width: 88%;
        padding: 10px 12px;
        border-radius: 14px;
        font-size: 13px;
        line-height: 1.5;
        white-space: pre-line;
    }

    .th-chatbot-message-bot {
        align-self: flex-start;
        background: #fff;
        border: 1px solid #ece7f5;
        color: #252238;
    }

    .th-chatbot-message-user {
        align-self: flex-end;
        background: #6c3dd9;
        color: #fff;
    }

    .th-chatbot-suggestions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 0 14px 10px;
        background: #fcfbfe;
    }

    .th-chatbot-suggestion {
        border: 1px solid #ddd0ff;
        background: #fff;
        color: #6c3dd9;
        border-radius: 999px;
        padding: 6px 10px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
    }

    .th-chatbot-form {
        display: flex;
        gap: 8px;
        padding: 12px 14px 14px;
        border-top: 1px solid #ece7f5;
        background: #fff;
    }

    .th-chatbot-input {
        flex: 1;
        min-width: 0;
        border: 1px solid #ddd;
        border-radius: 999px;
        padding: 10px 14px;
        font-size: 13px;
    }

    .th-chatbot-send {
        width: 42px;
        height: 42px;
        border: none;
        border-radius: 50%;
        background: #6c3dd9;
        color: #fff;
        font-size: 16px;
        cursor: pointer;
    }

    @@media (max-width: 600px) {

        .th-chatbot-root {
            right: 14px;
            bottom: calc(78px + env(safe-area-inset-bottom, 0px));
        }

        .th-chatbot-panel {
            height: min(70vh, 520px);
        }
    }

</style>

<script>

    (function () {

        const root =
            document.getElementById("thChatbotRoot");

        if (!root) {
            return;
        }

        const panel =
            document.getElementById("thChatbotPanel");

        const toggle =
            document.getElementById("thChatbotToggle");

        const closeButton =
            document.getElementById("thChatbotClose");

        const form =
            document.getElementById("thChatbotForm");

        const input =
            document.getElementById("thChatbotInput");

        const messages =
            document.getElementById("thChatbotMessages");

        const suggestionsContainer =
            document.getElementById("thChatbotSuggestions");


        function appendMessage(
            text,
            type) {

            const message =
                document.createElement("div");

            message.className =
                "th-chatbot-message th-chatbot-message-" + type;

            message.textContent =
                text;

            messages.appendChild(message);
            messages.scrollTop =
                messages.scrollHeight;

        }


        function renderSuggestions(
            items) {

            suggestionsContainer.innerHTML = "";

            if (!items || items.length === 0) {
                return;
            }

            items.forEach(function (item) {

                const button =
                    document.createElement("button");

                button.type = "button";
                button.className = "th-chatbot-suggestion";
                button.textContent = item;
                button.setAttribute("data-question", item);

                suggestionsContainer.appendChild(button);

            });

        }


        let isAsking = false;


        async function askQuestion(
            question) {

            const trimmed =
                (question || "").trim();

            if (!trimmed || isAsking) {
                return;
            }

            isAsking = true;

            appendMessage(trimmed, "user");
            input.value = "";

            try {

                const response =
                    await fetch("/Chatbot/Ask", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({
                            question: trimmed
                        })
                    });

                if (!response.ok) {
                    throw new Error("Request failed");
                }

                const data =
                    await response.json();

                appendMessage(
                    data.answer || "Sorry, I could not find an answer.",
                    "bot");

                renderSuggestions(data.suggestions || []);

            }
            catch (error) {

                appendMessage(
                    "Sorry, I could not reach the help service right now. Please try again.",
                    "bot");

            }
            finally {
                isAsking = false;
            }

        }


        function openPanel() {

            panel.hidden = false;
            toggle.setAttribute("aria-expanded", "true");
            input.focus();

        }


        function closePanel() {

            panel.hidden = true;
            toggle.setAttribute("aria-expanded", "false");

        }


        toggle.addEventListener("click", function () {

            if (panel.hidden) {
                openPanel();
            }
            else {
                closePanel();
            }

        });


        closeButton.addEventListener("click", closePanel);


        form.addEventListener("submit", function (event) {

            event.preventDefault();
            askQuestion(input.value);

        });


        suggestionsContainer.addEventListener("click", function (event) {

            const button =
                event.target.closest(".th-chatbot-suggestion");

            if (!button) {
                return;
            }

            askQuestion(
                button.getAttribute("data-question"));

        });

    })();

</script>
