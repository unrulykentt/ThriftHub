@{
    ViewData["Title"] = "Seller Subscription";

    var activeSubscription =
        ViewBag.ActiveSubscription
        as ThriftHub.Models.SellerSubscription;

    var durationMonths =
        ViewBag.DurationMonths ?? 4;

    var isWelcomeTrial =
        ViewBag.IsWelcomeTrialActive is bool trialActive &&
        trialActive;

    var trialDaysRemaining =
        ViewBag.TrialDaysRemaining is int days
            ? days
            : 0;

    var isPaidActive =
        activeSubscription != null &&
        !isWelcomeTrial;
}

<div class="subscription-page">

    <div class="subscription-container">

        <!-- ============================================================
             HEADER
             ============================================================ -->

        <div class="page-header">

            <div>

                <div class="small-heading">
                    THRIFTHUB SELLER ACCOUNT
                </div>

                <h1>
                    Seller Subscription
                </h1>

                <p>
                    @if (isWelcomeTrial)
                    {
                        <text>
                            Your first month is free. After that, choose a plan
                            to keep selling on ThriftHub.
                        </text>
                    }
                    else
                    {
                        <text>
                            Choose a subscription plan to keep your ThriftHub
                            seller account active.
                        </text>
                    }
                </p>

            </div>

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="dashboard-button">
                ← Back to Dashboard
            </a>

        </div>


        <!-- ============================================================
             SUCCESS MESSAGE
             ============================================================ -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert success-alert">

                <span class="alert-icon">
                    ✓
                </span>

                <span>
                    @TempData["SuccessMessage"]
                </span>

            </div>
        }


        <!-- ============================================================
             ERROR MESSAGE
             ============================================================ -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert error-alert">

                <span class="alert-icon">
                    !
                </span>

                <span>
                    @TempData["ErrorMessage"]
                </span>

            </div>
        }


        <!-- ============================================================
             ACTIVE SUBSCRIPTION
             ============================================================ -->
        @if (isPaidActive)
        {
            <div class="active-subscription-card">

                <!-- CHECK ICON -->

                <div class="active-icon">
                    ✓
                </div>


                <!-- SUBSCRIPTION DETAILS -->

                <div class="active-content">

                    <h2>
                        Your Subscription Is Active
                    </h2>


                    <!-- PLAN -->

                    <div class="subscription-detail">

                        <span class="detail-label">
                            Plan
                        </span>

                        <strong class="detail-value">
                            @activeSubscription!.PlanName
                        </strong>

                    </div>


                    <!-- AMOUNT -->

                    <div class="subscription-detail">

                        <span class="detail-label">
                            Amount
                        </span>

                        <strong class="detail-value">
                            GH₵@activeSubscription.Amount.ToString("0.00")
                        </strong>

                    </div>


                    <!-- DURATION -->

                    <div class="subscription-detail">

                        <span class="detail-label">
                            Duration
                        </span>

                        <strong class="detail-value">
                            @activeSubscription.DurationMonths months
                        </strong>

                    </div>


                    <!-- START DATE -->

                    <div class="subscription-detail">

                        <span class="detail-label">
                            Started
                        </span>

                        <strong class="detail-value">
                            @(activeSubscription.StartDate
                                .ToLocalTime()
                                .ToString("dd MMMM yyyy"))
                        </strong>

                    </div>


                    <!-- EXPIRY DATE -->

                    <div class="subscription-detail">

                        <span class="detail-label">
                            Expires
                        </span>

                        <strong class="detail-value expiry-date">
                            @(activeSubscription.EndDate
                                .ToLocalTime()
                                .ToString("dd MMMM yyyy"))
                        </strong>

                    </div>


                    <!-- ACTIVE MESSAGE -->

                    <div class="active-message">

                        Your seller subscription is currently active.
                        You can continue selling on ThriftHub until the
                        expiry date shown above.

                    </div>

                </div>

            </div>
        }
        else if (isWelcomeTrial && activeSubscription != null)
        {
            <div class="active-subscription-card trial-subscription-card">

                <div class="active-icon">
                    🎁
                </div>

                <div class="active-content">

                    <h2>
                        Your First Month Is Free
                    </h2>

                    <div class="subscription-detail">
                        <span class="detail-label">
                            Plan
                        </span>
                        <strong class="detail-value">
                            Welcome Trial
                        </strong>
                    </div>

                    <div class="subscription-detail">
                        <span class="detail-label">
                            Amount
                        </span>
                        <strong class="detail-value">
                            Free
                        </strong>
                    </div>

                    <div class="subscription-detail">
                        <span class="detail-label">
                            Days left
                        </span>
                        <strong class="detail-value expiry-date">
                            @trialDaysRemaining day@(trialDaysRemaining == 1 ? "" : "s")
                        </strong>
                    </div>

                    <div class="subscription-detail">
                        <span class="detail-label">
                            Free period ends
                        </span>
                        <strong class="detail-value expiry-date">
                            @(activeSubscription.EndDate
                                .ToLocalTime()
                                .ToString("dd MMMM yyyy"))
                        </strong>
                    </div>

                    <div class="active-message">
                        Every new ThriftHub account gets 1 free month to sell.
                        When your trial ends, you'll need to choose a paid plan
                        below to keep posting items.
                    </div>

                </div>

            </div>
        }

        @if (activeSubscription == null || isWelcomeTrial)
        {

            <div class="plans-grid">


                <!-- ====================================================
                     BASIC
                     ==================================================== -->

                <div class="plan-card">

                    <div class="plan-header">

                        <h2>
                            Basic
                        </h2>

                        <div class="price">
                            GH₵40

                            <span>
                                / 4 months
                            </span>
                        </div>

                    </div>


                    <div class="plan-divider"></div>


                    <div class="features">

                        <div class="feature">
                            <span>✓</span>
                            <span>
                                Sell thrift items
                            </span>
                        </div>

                        <div class="feature">
                            <span>✓</span>
                            <span>
                                Seller profile
                            </span>
                        </div>

                        <div class="feature">
                            <span>✓</span>
                            <span>
                                Receive customer messages
                            </span>
                        </div>

                        <div class="feature">
                            <span>✓</span>
                            <span>
                                Marketplace listing
                            </span>
                        </div>

                    </div>


                    <!-- BASIC PAYMENT -->

                    <form asp-controller="Subscription"
                          asp-action="SelectPlan"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="planName"
                               value="Basic" />

                        <input type="hidden"
                               name="amount"
                               value="40" />

                        <button type="submit"
                                class="choose-button">

                            Choose Basic

                        </button>

                    </form>

                </div>


                <!-- ====================================================
                     STANDARD
                     ==================================================== -->

                <div class="plan-card popular-card">

                    <div class="popular-badge">
                        Most Popular
                    </div>


                    <div class="plan-header">

                        <h2>
                            Standard
                        </h2>

                        <div class="price">
                            GH₵80

                            <span>
                                / 4 months
                            </span>
                        </div>

                    </div>


                    <div class="plan-divider"></div>


                    <div class="features">

                        <div class="feature">
                            <span>✓</span>
                            <span>
                                Everything in Basic
                            </span>
                        </div>

                        <div class="feature">
                            <span>✓</span>
                            <span>
                                More product listings
                            </span>
                        </div>

                        <div class="feature">
                            <span>✓</span>
                            <span>
                                Seller verification
                            </span>
                        </div>

                        <div class="feature">
                            <span>✓</span>
                            <span>
                                Better seller visibility
                            </span>
                        </div>

                        <div class="feature">
                            <span>✓</span>
                            <span>
                                Priority support
                            </span>
                        </div>

                    </div>


                    <!-- STANDARD PAYMENT -->

                    <form asp-controller="Subscription"
                          asp-action="SelectPlan"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="planName"
                               value="Standard" />

                        <input type="hidden"
                               name="amount"
                               value="80" />

                        <button type="submit"
                                class="choose-button">

                            Choose Standard

                        </button>

                    </form>

                </div>


                <!-- ====================================================
                     PREMIUM
                     ==================================================== -->

                <div class="plan-card">

                    <div class="plan-header">

                        <h2>
                            Premium
                        </h2>

                        <div class="price">
                            GH₵150

                            <span>
                                / 4 months
                            </span>
                        </div>

                    </div>


                    <div class="plan-divider"></div>


                    <div class="features">

                        <div class="feature">
                            <span>✓</span>
                            <span>
                                Everything in Standard
                            </span>
                        </div>

                        <div class="feature">
                            <span>✓</span>
                            <span>
                                Unlimited listings
                            </span>
                        </div>

                        <div class="feature">
                            <span>✓</span>
                            <span>
                                Featured products
                            </span>
                        </div>

                        <div class="feature">
                            <span>✓</span>
                            <span>
                                Premium seller visibility
                            </span>
                        </div>

                        <div class="feature">
                            <span>✓</span>
                            <span>
                                Priority support
                            </span>
                        </div>

                    </div>


                    <!-- PREMIUM PAYMENT -->

                    <form asp-controller="Subscription"
                          asp-action="SelectPlan"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="planName"
                               value="Premium" />

                        <input type="hidden"
                               name="amount"
                               value="150" />

                        <button type="submit"
                                class="choose-button">

                            Choose Premium

                        </button>

                    </form>

                </div>

            </div>


            <!-- ========================================================
                 PAYMENT INFORMATION
                 ======================================================== -->

            <div class="payment-information">

                <div class="payment-icon">
                    💳
                </div>

                <div>

                    <h3>
                        Secure Payment
                    </h3>

                    <p>
                        Payments are securely processed through Paystack.
                        You can pay using a bank card or supported Mobile
                        Money payment methods.
                    </p>

                </div>

            </div>

        }


        <!-- ============================================================
             HOW IT WORKS
             ============================================================ -->

        <div class="subscription-info">

            <h3>
                How it works
            </h3>


            <div class="steps">


                <!-- ====================================================
                     STEP 1
                     ==================================================== -->

                <div class="step">

                    <div class="step-number">
                        1
                    </div>

                    <div>

                        <strong>
                            Choose a plan
                        </strong>

                        <p>
                            Select Basic, Standard or Premium.
                            Every plan lasts for 4 months.
                        </p>

                    </div>

                </div>


                <!-- ====================================================
                     STEP 2
                     ==================================================== -->

                <div class="step">

                    <div class="step-number">
                        2
                    </div>

                    <div>

                        <strong>
                            Make payment
                        </strong>

                        <p>
                            Pay securely using your bank card or
                            Mobile Money through Paystack.
                        </p>

                    </div>

                </div>


                <!-- ====================================================
                     STEP 3
                     ==================================================== -->

                <div class="step">

                    <div class="step-number">
                        3
                    </div>

                    <div>

                        <strong>
                            Start selling
                        </strong>

                        <p>
                            Once payment is verified, your seller
                            subscription becomes active for 4 months.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    /* ============================================================
           PAGE
           ============================================================ */

    .subscription-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 45px 25px 70px;
        font-family: Arial, Helvetica, sans-serif;
    }


    .subscription-container {
        width: 100%;
    }


    /* ============================================================
           HEADER
           ============================================================ */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 25px;
        margin-bottom: 30px;
    }


    .small-heading {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.5px;
        color: #777;
        margin-bottom: 8px;
    }


    .page-header h1 {
        margin: 0;
        font-size: 34px;
        font-weight: 700;
        color: #252525;
    }


    .page-header p {
        margin: 8px 0 0;
        color: #777;
        font-size: 14px;
    }


    /* ============================================================
           DASHBOARD BUTTON
           ============================================================ */

    .dashboard-button {
        display: inline-block;
        background: #6c3df4;
        color: #fff;
        text-decoration: none;
        padding: 11px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
        transition: background 0.2s ease;
    }


        .dashboard-button:hover {
            background: #5830d4;
            color: #fff;
        }


    /* ============================================================
           ALERTS
           ============================================================ */

    .alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 18px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
    }


    .success-alert {
        background: #e9f9ef;
        color: #16803c;
        border: 1px solid #c7efd5;
    }


    .error-alert {
        background: #fff0f0;
        color: #b42318;
        border: 1px solid #f4c7c7;
    }


    .alert-icon {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        flex-shrink: 0;
    }


    /* ============================================================
           PLANS GRID
           ============================================================ */

    .plans-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 30px;
    }


    /* ============================================================
           PLAN CARD
           ============================================================ */

    .plan-card {
        position: relative;
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 14px;
        padding: 30px 22px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }


        .plan-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        }


    /* ============================================================
           POPULAR PLAN
           ============================================================ */

    .popular-card {
        border: 2px solid #6c3df4;
    }


    .popular-badge {
        position: absolute;
        top: -12px;
        left: 50%;
        transform: translateX(-50%);
        background: #6c3df4;
        color: #fff;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }


    /* ============================================================
           PLAN HEADER
           ============================================================ */

    .plan-header {
        text-align: center;
    }


        .plan-header h2 {
            margin: 0 0 15px;
            font-size: 22px;
            color: #333;
        }


    .price {
        font-size: 27px;
        font-weight: 700;
        color: #333;
    }


        .price span {
            font-size: 12px;
            font-weight: 400;
            color: #777;
        }


    .plan-divider {
        height: 1px;
        background: #eee;
        margin: 25px 0;
    }


    /* ============================================================
           FEATURES
           ============================================================ */

    .features {
        min-height: 190px;
    }


    .feature {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        padding: 9px 0;
        color: #555;
        font-size: 13px;
        line-height: 1.5;
    }


        .feature span:first-child {
            color: #22c55e;
            font-weight: 700;
            font-size: 15px;
        }


    /* ============================================================
           CHOOSE BUTTON
           ============================================================ */

    .choose-button {
        width: 100%;
        border: none;
        background: #6c3df4;
        color: #fff;
        padding: 13px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 20px;
        transition: background 0.2s ease, transform 0.1s ease;
    }


        .choose-button:hover {
            background: #5830d4;
        }


        .choose-button:active {
            transform: scale(0.98);
        }


    /* ============================================================
           ACTIVE SUBSCRIPTION
           ============================================================ */

    .active-subscription-card {
        display: flex;
        align-items: flex-start;
        gap: 22px;
        max-width: 750px;
        margin: 30px auto;
        padding: 30px;
        border-radius: 14px;
        background: #e9f9ef;
        border: 1px solid #c7efd5;
        border-top: 4px solid #22c55e;
    }


    /* ============================================================
           ACTIVE ICON
           ============================================================ */

    .active-icon {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #22c55e;
        color: white;
        font-size: 27px;
        font-weight: 700;
        flex-shrink: 0;
    }


    /* ============================================================
           ACTIVE CONTENT
           ============================================================ */

    .active-content {
        flex: 1;
    }


        .active-content h2 {
            margin: 0 0 20px;
            font-size: 21px;
            color: #16803c;
        }


    /* ============================================================
           SUBSCRIPTION DETAILS
           ============================================================ */

    .subscription-detail {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 8px 0;
        font-size: 13px;
        border-bottom: 1px solid rgba(22, 128, 60, 0.08);
    }


        .subscription-detail:last-of-type {
            border-bottom: none;
        }


    .detail-label {
        color: #666;
    }


    .detail-value {
        color: #333;
        text-align: right;
    }


    .expiry-date {
        color: #16803c;
        font-weight: 700;
    }


    /* ============================================================
           ACTIVE MESSAGE
           ============================================================ */

    .active-message {
        margin-top: 20px;
        padding: 13px 15px;
        background: rgba(255, 255, 255, 0.65);
        border-radius: 8px;
        color: #666;
        font-size: 12px;
        line-height: 1.6;
    }


    /* ============================================================
           PAYMENT INFORMATION
           ============================================================ */

    .payment-information {
        display: flex;
        align-items: center;
        gap: 15px;
        max-width: 800px;
        margin: 35px auto 0;
        padding: 20px;
        background: #f8f8f8;
        border: 1px solid #eee;
        border-radius: 10px;
    }


    .payment-icon {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: #f1ecff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
        flex-shrink: 0;
    }


    .payment-information h3 {
        margin: 0 0 6px;
        font-size: 15px;
        color: #333;
    }


    .payment-information p {
        margin: 0;
        color: #777;
        font-size: 13px;
        line-height: 1.6;
    }


    /* ============================================================
           HOW IT WORKS
           ============================================================ */

    .subscription-info {
        max-width: 900px;
        margin: 40px auto 0;
        padding: 25px;
        background: #fff;
        border: 1px solid #eee;
        border-radius: 12px;
    }


        .subscription-info h3 {
            margin: 0 0 20px;
            text-align: center;
            color: #333;
            font-size: 19px;
        }


    .steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }


    .step {
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }


    .step-number {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #6c3df4;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 700;
        flex-shrink: 0;
    }


    .step strong {
        display: block;
        margin-bottom: 5px;
        font-size: 13px;
        color: #333;
    }


    .step p {
        margin: 0;
        color: #777;
        font-size: 12px;
        line-height: 1.5;
    }


    /* ============================================================
           TABLET
           ============================================================ */

    @@media (max-width: 850px) {

        .plans-grid {
            grid-template-columns: 1fr;
        }


        .features {
            min-height: auto;
        }


        .steps {
            grid-template-columns: 1fr;
        }
    }


    /* ============================================================
           MOBILE
           ============================================================ */

    @@media (max-width: 600px) {

        .subscription-page {
            padding: 25px 15px 50px;
        }


        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }


            .page-header h1 {
                font-size: 27px;
            }


        .dashboard-button {
            width: 100%;
            text-align: center;
        }


        .active-subscription-card {
            flex-direction: column;
            text-align: left;
            padding: 22px;
        }


        .active-icon {
            margin: 0 auto;
        }


        .active-content {
            width: 100%;
        }


            .active-content h2 {
                text-align: center;
            }


        .subscription-detail {
            flex-direction: column;
            align-items: flex-start;
            gap: 3px;
        }


        .detail-value {
            text-align: left;
        }


        .payment-information {
            align-items: flex-start;
        }
    }

</style>