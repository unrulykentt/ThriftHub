@model IEnumerable<ThriftHub.Models.ApplicationUser>

@{
    ViewData["Title"] = "Sellers";
}

<div class="sellers-page">

    <div class="page-header">

        <div>
            <h1>Sellers</h1>

            <p>
                View and manage all seller accounts on ThriftHub.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="back-button">
            ← Admin Dashboard
        </a>

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert error">
            @TempData["ErrorMessage"]
        </div>
    }


    <div class="top-actions">

        <a asp-controller="Admin"
           asp-action="SellerVerification"
           class="verify-button">
            🏆 Seller Verification
        </a>

        <a asp-controller="Admin"
           asp-action="VerifiedSellers"
           class="verified-button">
            ✅ Verified Sellers
        </a>

    </div>


    @if (Model == null || !Model.Any())
    {
        <div class="empty-box">

            <div class="empty-icon">
                🏪
            </div>

            <h2>No Sellers Found</h2>

            <p>
                There are currently no seller accounts.
            </p>

        </div>
    }
    else
    {
        <div class="seller-list">

            @foreach (var seller in Model)
            {
                <div class="seller-card">

                    <div class="seller-info">

                        <div class="seller-avatar">

                            @if (!string.IsNullOrWhiteSpace(seller.ProfileImageUrl))
                            {
                                <img src="@seller.ProfileImageUrl"
                                     alt="@seller.FullName" />
                            }
                            else
                            {
                                <span>
                                    @(string.IsNullOrWhiteSpace(seller.FullName)
                                        ? "S"
                                        : seller.FullName.Substring(0, 1).ToUpper())
                                </span>
                            }

                        </div>


                        <div class="seller-details">

                            <h3>
                                @(seller.FullName ?? "Unnamed Seller")
                            </h3>

                            <p>
                                @(seller.Email ?? "No email")
                            </p>

                            <div class="seller-status">

                                @if (seller.IsVerified)
                                {
                                    <span class="status verified">
                                        ✓ Verified
                                    </span>
                                }
                                else if (seller.VerificationStatus == "Pending")
                                {
                                    <span class="status pending">
                                        ⏳ Pending
                                    </span>
                                }
                                else if (seller.VerificationStatus == "Rejected")
                                {
                                    <span class="status rejected">
                                        ✕ Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="status pending">
                                        Not Verified
                                    </span>
                                }

                            </div>

                        </div>

                    </div>


                    <div class="seller-actions">

                        @if (!seller.IsVerified)
                        {
                            <a asp-controller="Admin"
                               asp-action="SellerVerification"
                               class="action-button verify">
                                Review Verification
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Admin"
                               asp-action="VerifiedSellers"
                               class="action-button verified">
                                View Verified
                            </a>
                        }


                        <form asp-controller="Admin"
                              asp-action="DeleteUser"
                              method="post"
                              onsubmit="return confirm('Are you sure you want to delete this seller?');">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@seller.Id" />

                            <input type="hidden"
                                   name="returnTo"
                                   value="Sellers" />

                            <button type="submit"
                                    class="action-button delete">
                                Delete
                            </button>

                        </form>

                    </div>

                </div>
            }

        </div>
    }

</div>


<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #fafafa;
        font-family: Arial, Helvetica, sans-serif;
    }

    .sellers-page {
        width: 92%;
        max-width: 1100px;
        margin: 40px auto 70px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

        .page-header h1 {
            margin: 0 0 8px;
            font-size: 34px;
            color: #222;
        }

        .page-header p {
            margin: 0;
            color: #777;
        }

    .back-button {
        text-decoration: none;
        background: #eee;
        color: #333;
        padding: 11px 17px;
        border-radius: 8px;
        font-weight: 600;
    }

    .top-actions {
        display: flex;
        gap: 12px;
        margin-bottom: 25px;
    }

    .verify-button,
    .verified-button {
        text-decoration: none;
        padding: 12px 18px;
        border-radius: 8px;
        font-weight: 600;
    }

    .verify-button {
        background: #7650e8;
        color: white;
    }

    .verified-button {
        background: #e8f8ed;
        color: #23833e;
    }

    .alert {
        padding: 14px 18px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-weight: 600;
    }

        .alert.success {
            background: #e8f8ed;
            color: #23833e;
        }

        .alert.error {
            background: #ffe9e9;
            color: #b32626;
        }

    .seller-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .seller-card {
        background: white;
        border: 1px solid #eee;
        border-radius: 14px;
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.04);
    }

    .seller-info {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .seller-avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: #eee;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
        font-weight: bold;
        color: #7650e8;
    }

        .seller-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .seller-details h3 {
        margin: 0 0 5px;
        color: #222;
    }

    .seller-details p {
        margin: 0 0 8px;
        color: #777;
    }

    .seller-status {
        display: flex;
    }

    .status {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

        .status.verified {
            background: #e8f8ed;
            color: #23833e;
        }

        .status.pending {
            background: #fff6d9;
            color: #977000;
        }

        .status.rejected {
            background: #ffe9e9;
            color: #b32626;
        }

    .seller-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

        .seller-actions form {
            margin: 0;
        }

    .action-button {
        border: none;
        text-decoration: none;
        padding: 10px 14px;
        border-radius: 7px;
        cursor: pointer;
        font-weight: 600;
        font-size: 13px;
        display: inline-block;
    }

        .action-button.verify {
            background: #7650e8;
            color: white;
        }

        .action-button.verified {
            background: #e8f8ed;
            color: #23833e;
        }

        .action-button.delete {
            background: #ffe9e9;
            color: #b32626;
        }

    .empty-box {
        background: white;
        border: 1px solid #eee;
        border-radius: 14px;
        text-align: center;
        padding: 70px 20px;
    }

    .empty-icon {
        font-size: 45px;
        margin-bottom: 15px;
    }

    .empty-box h2 {
        margin: 0 0 8px;
    }

    .empty-box p {
        color: #777;
    }

    @@media (max-width: 700px) {

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .top-actions {
            flex-direction: column;
        }

        .seller-card {
            flex-direction: column;
            align-items: flex-start;
        }

        .seller-actions {
            width: 100%;
        }

        .action-button {
            text-align: center;
        }
    }

</style>