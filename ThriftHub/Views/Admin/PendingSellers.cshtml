@model IEnumerable<ThriftHub.Models.ApplicationUser>

@{
    ViewData["Title"] = "Pending Seller Verification";
}

<div class="container py-5">

    <!-- ============================================================
         HEADER
         ============================================================ -->

    <div class="mb-4">

        <h1 class="fw-bold mb-2">
            Seller Verification
        </h1>

        <p class="text-muted mb-0">
            Review seller information and identity documents before
            approving or rejecting their seller account.
        </p>

    </div>


    <!-- ============================================================
         SUCCESS MESSAGE
         ============================================================ -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            ✓ @TempData["SuccessMessage"]
        </div>
    }


    <!-- ============================================================
         ERROR MESSAGE
         ============================================================ -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            ⚠ @TempData["ErrorMessage"]
        </div>
    }


    <!-- ============================================================
         PENDING SELLERS
         ============================================================ -->
    @if (Model.Any())
    {
        <div class="row g-4">

            @foreach (var seller in Model)
            {
                <div class="col-12">

                    <div class="card shadow-sm border-0">

                        <!-- =================================================
                             CARD HEADER
                             ================================================= -->

                        <div class="card-header bg-dark text-white">

                            <div class="d-flex justify-content-between
                                align-items-center">

                                <div>

                                    <h5 class="mb-1">
                                        @(seller.FullName ?? "No name")
                                    </h5>

                                    <small>
                                        Seller Verification Request
                                    </small>

                                </div>

                                <span class="badge bg-warning text-dark">
                                    @seller.VerificationStatus
                                </span>

                            </div>

                        </div>


                        <!-- =================================================
                             CARD BODY
                             ================================================= -->

                        <div class="card-body">

                            <div class="row g-4">


                                <!-- =========================================
                                     SELLER INFORMATION
                                     ========================================= -->

                                <div class="col-12 col-lg-5">

                                    <h5 class="fw-bold mb-3">
                                        👤 Seller Information
                                    </h5>


                                    <!-- PROFILE IMAGE -->

                                    <div class="text-center mb-4">

                                        @if (!string.IsNullOrWhiteSpace(
                                            seller.ProfileImageUrl))
                                        {
                                            <img src="@seller.ProfileImageUrl"
                                                 alt="Seller profile"
                                                 class="rounded-circle"
                                                 style="
                                            width:120px;
                                            height:120px;
                                            object-fit:cover;
                                            border:4px solid #eee;
                                            " />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle
                                                bg-light
                                                d-flex
                                                align-items-center
                                                justify-content-center
                                                mx-auto"
                                                 style="
                                                width:120px;
                                                height:120px;
                                                font-size:45px;
                                                ">

                                                👤

                                            </div>
                                        }

                                    </div>


                                    <!-- FULL NAME -->

                                    <div class="info-row">

                                        <strong>
                                            Full Name
                                        </strong>

                                        <span>
                                            @(seller.FullName ?? "Not provided")
                                        </span>

                                    </div>


                                    <!-- EMAIL -->

                                    <div class="info-row">

                                        <strong>
                                            Email
                                        </strong>

                                        <span>
                                            @(seller.Email ?? "Not provided")
                                        </span>

                                    </div>


                                    <!-- PHONE -->

                                    <div class="info-row">

                                        <strong>
                                            Phone
                                        </strong>

                                        <span>
                                            @(seller.PhoneNumber ?? "Not provided")
                                        </span>

                                    </div>


                                    <!-- COUNTRY -->

                                    <div class="info-row">

                                        <strong>
                                            Country
                                        </strong>

                                        <span>
                                            @(seller.Country ?? "Not provided")
                                        </span>

                                    </div>


                                    <!-- CITY -->

                                    <div class="info-row">

                                        <strong>
                                            City
                                        </strong>

                                        <span>
                                            @(seller.City ?? "Not provided")
                                        </span>

                                    </div>


                                    <!-- ACCOUNT TYPE -->

                                    <div class="info-row">

                                        <strong>
                                            Account Type
                                        </strong>

                                        <span>
                                            @seller.UserType
                                        </span>

                                    </div>


                                    <!-- VERIFICATION STATUS -->

                                    <div class="info-row">

                                        <strong>
                                            Verification
                                        </strong>

                                        <span>

                                            @if (seller.IdCardVerified)
                                            {
                                                <span class="badge bg-success">
                                                    ✓ ID Verified
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    ⏳ ID Not Verified
                                                </span>
                                            }

                                        </span>

                                    </div>

                                </div>


                                <!-- =========================================
                                     ID CARD INFORMATION
                                     ========================================= -->

                                <div class="col-12 col-lg-7">

                                    <h5 class="fw-bold mb-3">
                                        🪪 Identity Verification
                                    </h5>


                                    <!-- ID TYPE -->

                                    <div class="mb-3">

                                        <label class="fw-bold">
                                            ID Type
                                        </label>

                                        <div class="form-control bg-light">

                                            @(seller.IdCardType ?? "Not provided")

                                        </div>

                                    </div>


                                    <!-- ID NUMBER -->

                                    <div class="mb-3">

                                        <label class="fw-bold">
                                            ID Number
                                        </label>

                                        <div class="form-control bg-light">

                                            @(seller.IdCardNumber ?? "Not provided")

                                        </div>

                                    </div>


                                    <!-- =====================================
                                         ID CARD IMAGES
                                         ===================================== -->

                                    <div class="row g-3">


                                        <!-- ID FRONT -->

                                        <div class="col-12 col-md-6">

                                            <label class="fw-bold d-block mb-2">
                                                ID Card Front
                                            </label>

                                            @if (!string.IsNullOrWhiteSpace(
                                                seller.IdCardFrontUrl))
                                            {
                                                <a href="@seller.IdCardFrontUrl"
                                                   target="_blank">

                                                    <img src="@seller.IdCardFrontUrl"
                                                         alt="ID card front"
                                                         class="img-fluid rounded border"
                                                         style="
                                                    width:100%;
                                                    height:220px;
                                                    object-fit:cover;
                                                    " />

                                                </a>

                                                <small class="text-muted d-block mt-2">
                                                    Click image to view full size.
                                                </small>
                                            }
                                            else
                                            {
                                                <div class="missing-document">

                                                    ⚠️

                                                    <div>
                                                        ID front not uploaded
                                                    </div>

                                                </div>
                                            }

                                        </div>


                                        <!-- ID BACK -->

                                        <div class="col-12 col-md-6">

                                            <label class="fw-bold d-block mb-2">
                                                ID Card Back
                                            </label>

                                            @if (!string.IsNullOrWhiteSpace(
                                                seller.IdCardBackUrl))
                                            {
                                                <a href="@seller.IdCardBackUrl"
                                                   target="_blank">

                                                    <img src="@seller.IdCardBackUrl"
                                                         alt="ID card back"
                                                         class="img-fluid rounded border"
                                                         style="
                                                    width:100%;
                                                    height:220px;
                                                    object-fit:cover;
                                                    " />

                                                </a>

                                                <small class="text-muted d-block mt-2">
                                                    Click image to view full size.
                                                </small>
                                            }
                                            else
                                            {
                                                <div class="missing-document">

                                                    ⚠️

                                                    <div>
                                                        ID back not uploaded
                                                    </div>

                                                </div>
                                            }

                                        </div>

                                    </div>


                                    <!-- =====================================
                                         ID CHECK WARNING
                                         ===================================== -->
                                    @if (string.IsNullOrWhiteSpace(
                                                                            seller.IdCardFrontUrl) ||
                                                                            string.IsNullOrWhiteSpace(
                                                                            seller.IdCardBackUrl))
                                    {
                                        <div class="alert alert-warning mt-4 mb-0">

                                            ⚠️

                                            <strong>
                                                ID document incomplete.
                                            </strong>

                                            Both the front and back of the
                                            identity document should be reviewed
                                            before approval.

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                             ACTIONS
                             ================================================= -->

                        <div class="card-footer bg-white p-3">

                            <div class="row g-2">


                                <!-- =========================================
                                     APPROVE
                                     ========================================= -->

                                <div class="col-12 col-md-6">

                                    <form asp-controller="Admin"
                                          asp-action="ApproveSeller"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@seller.Id" />


                                        <button type="submit"
                                                class="btn btn-success w-100"
                                                onclick="return confirm(
                                            'Are you sure you want to approve this seller?'
                                            );">

                                            ✓ Approve Seller

                                        </button>

                                    </form>

                                </div>


                                <!-- =========================================
                                     REJECT
                                     ========================================= -->

                                <div class="col-12 col-md-6">

                                    <form asp-controller="Admin"
                                          asp-action="RejectSeller"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@seller.Id" />


                                        <button type="submit"
                                                class="btn btn-danger w-100"
                                                onclick="return confirm(
                                            'Are you sure you want to reject this seller?'
                                            );">

                                            ✕ Reject Seller

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {

        <!-- ============================================================
             NO PENDING SELLERS
             ============================================================ -->

        <div class="text-center py-5">

            <div style="font-size:55px;">
                ✅
            </div>

            <h3 class="mt-3">
                No pending sellers
            </h3>

            <p class="text-muted">
                There are currently no sellers waiting for verification.
            </p>

        </div>

    }

</div>


<!-- ================================================================
     STYLING
     ================================================================ -->

<style>

    .info-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 10px 0;
        border-bottom: 1px solid #eee;
        font-size: 14px;
    }

        .info-row strong {
            color: #333;
        }

        .info-row span {
            color: #666;
            text-align: right;
        }

    .missing-document {
        height: 220px;
        border: 2px dashed #ddd;
        border-radius: 8px;
        background: #f8f8f8;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #999;
        text-align: center;
        font-size: 14px;
    }

        .missing-document:first-letter {
            font-size: 35px;
        }

    @@media (max-width: 600px) {

        .info-row {
            flex-direction: column;
            gap: 3px;
        }

            .info-row span {
                text-align: left;
            }
    }

</style>