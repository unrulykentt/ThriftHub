@model IEnumerable<ThriftHub.Models.ApplicationUser>

@{
    ViewData["Title"] = "Administrators";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">🛡️ Administrators</h1>
            <p class="text-muted">
                Manage ThriftHub administrator accounts.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-primary">
            ← Admin Dashboard
        </a>
    </div>


    <div class="card shadow-sm border-0">

        <div class="card-body">

            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">

                    <div style="font-size:50px;">
                        🛡️
                    </div>

                    <h4 class="mt-3">
                        No administrators found
                    </h4>

                    <p class="text-muted">
                        There are currently no administrator accounts.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Account Type</th>
                                <th>Verification</th>
                                <th>Created</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var admin in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @(admin.FullName ?? "Unknown")
                                        </strong>
                                    </td>

                                    <td>
                                        @admin.Email
                                    </td>

                                    <td>
                                        <span class="badge bg-primary">
                                            Administrator
                                        </span>
                                    </td>

                                    <td>
                                        @if (admin.IsVerified)
                                        {
                                            <span class="badge bg-success">
                                                ✓ Verified
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @admin.CreatedAt.ToString("dd MMM yyyy")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>