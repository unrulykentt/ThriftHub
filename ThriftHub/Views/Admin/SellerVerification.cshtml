@model IEnumerable<ThriftHub.Models.ApplicationUser>
@using ThriftHub.Services

@{
    ViewData["Title"] = "Seller Verification";
}

<style>
    .verification-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 20px 60px;
    }

    .verification-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

        .verification-header h1 {
            margin: 0 0 6px;
            font-size: 30px;
            color: #222;
        }

        .verification-header p {
            margin: 0;
            color: #777;
            font-size: 14px;
        }

    .back-button {
        display: inline-block;
        text-decoration: none;
        background: #6f42c1;
        color: white;
        padding: 11px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
    }

        .back-button:hover {
            background: #59339d;
            color: white;
        }

    .message {
        padding: 13px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .success-message {
        background: #e8f7ed;
        color: #217a3a;
        border: 1px solid #c8ead2;
    }

    .error-message {
        background: #fdecec;
        color: #a12626;
        border: 1px solid #f2caca;
    }

    .seller-list {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .seller-card {
        background: white;
        border: 1px solid #eee;
        border-radius: 14px;
        padding: 22px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.04);
    }

    .seller-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .seller-info h3 {
        margin: 0 0 5px;
        font-size: 18px;
    }

    .seller-email {
        color: #777;
        font-size: 13px;
    }

    .seller-details {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 18px;
    }

    .detail {
        background: #f7f7f7;
        padding: 7px 11px;
        border-radius: 20px;
        color: #555;
        font-size: 12px;
    }

    .status {
        display: inline-block;
        background: #fff4d6;
        color: #8a6700;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .seller-actions {
        display: flex;
        gap: 8px;
        margin-top: 20px;
        align-items: flex-end;
        flex-wrap: wrap;
    }

    .approve-form {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .waive-option {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: #555;
        margin: 0;
    }

    .approve-button,
    .reject-button {
        border: none;
        padding: 10px 16px;
        border-radius: 7px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .approve-button {
        background: #dff5e6;
        color: #217a3a;
    }

    .reject-button {
        background: #fde4e4;
        color: #a12626;
    }

    .empty-state {
        background: white;
        border: 1px solid #eee;
        border-radius: 14px;
        padding: 50px 20px;
        text-align: center;
        color: #777;
    }

        .empty-state .icon {
            font-size: 40px;
            margin-bottom: 15px;
        }

    @@media (max-width: 700px) {
        .verification-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .seller-top {
            flex-direction: column;
            align-items: flex-start;
        }

        .seller-actions {
            flex-direction: column;
        }

        .approve-button,
        .reject-button {
            width: 100%;
        }
    }
</style>


<div class="verification-page">

    <!-- HEADER -->

    <div class="verification-header">

        <div>
            <h1>🏆 Seller Verification</h1>

            <p>
                Review sellers who are waiting for approval.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="back-button">
            ← Admin Dashboard
        </a>

    </div>


    <!-- SUCCESS MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="message success-message">
            @TempData["SuccessMessage"]
        </div>
    }


    <!-- ERROR MESSAGE -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="message error-message">
            @TempData["ErrorMessage"]
        </div>
    }


    <!-- SELLERS -->
    @if (Model != null && Model.Any())
    {
        <div class="seller-list">

            @foreach (var seller in Model)
            {
                <div class="seller-card">

                    <div class="seller-top">

                        <div class="seller-info">

                            <h3>
                                @(seller.FullName ?? "Seller")
                            </h3>

                            <div class="seller-email">
                                @seller.Email
                            </div>

                        </div>

                        <div>
                            <span class="status">
                                Pending
                            </span>
                        </div>

                    </div>


                    <div class="seller-details">

                        @if (!string.IsNullOrWhiteSpace(seller.Country))
                        {
                            <span class="detail">
                                🌍 @seller.Country
                            </span>
                        }

                        @if (!string.IsNullOrWhiteSpace(seller.City))
                        {
                            <span class="detail">
                                📍 @seller.City
                            </span>
                        }

                        @if (!string.IsNullOrWhiteSpace(seller.PhoneNumber))
                        {
                            <span class="detail">
                                📞 @seller.PhoneNumber
                            </span>
                        }

                        <span class="detail">
                            📅 @seller.CreatedAt.ToString("dd/MM/yyyy")
                        </span>

                        <span class="detail">
                            🪪 ID: @seller.IdCardVerificationStatus
                        </span>

                    </div>


                    <div class="seller-actions">

                        <!-- APPROVE -->

                        @if (SellerVerificationRules.IsIdentityApproved(seller))
                        {
                        <form asp-controller="Admin"
                              asp-action="ApproveSeller"
                              method="post"
                              class="approve-form">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@seller.Id" />

                            <label class="waive-option">
                                <input type="checkbox"
                                       name="waiveSubscription"
                                       value="true" />
                                Grant free subscription
                            </label>

                            <button type="submit"
                                    class="approve-button">
                                ✓ Approve
                            </button>

                        </form>
                        }
                        else
                        {
                            <p class="text-muted small mb-2">
                                Verify this seller's ID in Identity Verification before approving.
                            </p>
                        }


                        <!-- REJECT -->

                        <form asp-controller="Admin"
                              asp-action="RejectSeller"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@seller.Id" />

                            <button type="submit"
                                    class="reject-button">
                                ✕ Reject
                            </button>

                        </form>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-state">

            <div class="icon">
                🎉
            </div>

            <h3>
                No Pending Sellers
            </h3>

            <p>
                There are currently no sellers waiting for verification.
            </p>

            <a asp-controller="Admin"
               asp-action="Index"
               class="back-button"
               style="margin-top:16px;display:inline-block;">
                ← Admin Dashboard
            </a>

        </div>
    }

</div>