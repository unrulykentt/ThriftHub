@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-5">

    <!-- ============================================================
         HEADER
         ============================================================ -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="fw-bold mb-1">
                ThriftHub Admin Dashboard
            </h1>

            <p class="text-muted mb-0">
                Manage users, sellers, identity verification,
                products and platform safety.
            </p>

        </div>

        <div>

            <span class="badge bg-dark px-3 py-2">
                Administrator
            </span>

        </div>

    </div>


    <!-- ============================================================
         SUCCESS MESSAGE
         ============================================================ -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ============================================================
         ERROR MESSAGE
         ============================================================ -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ============================================================
         STATISTICS
         ============================================================ -->

    <div class="row g-4 mb-5">

        <!-- TOTAL USERS -->

        <div class="col-12 col-sm-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="fs-1">
                        👥
                    </div>

                    <h6 class="text-muted mt-2">
                        Total Users
                    </h6>

                    <h2 class="fw-bold">
                        @ViewBag.TotalUsers
                    </h2>

                </div>

            </div>

        </div>


        <!-- SELLERS -->

        <div class="col-12 col-sm-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="fs-1">
                        🛍️
                    </div>

                    <h6 class="text-muted mt-2">
                        Sellers
                    </h6>

                    <h2 class="fw-bold">
                        @ViewBag.TotalSellers
                    </h2>

                </div>

            </div>

        </div>


        <!-- CUSTOMERS -->

        <div class="col-12 col-sm-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="fs-1">
                        👤
                    </div>

                    <h6 class="text-muted mt-2">
                        Customers
                    </h6>

                    <h2 class="fw-bold">
                        @ViewBag.TotalCustomers
                    </h2>

                </div>

            </div>

        </div>


        <!-- PRODUCTS -->

        <div class="col-12 col-sm-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="fs-1">
                        👗
                    </div>

                    <h6 class="text-muted mt-2">
                        Products
                    </h6>

                    <h2 class="fw-bold">
                        @ViewBag.TotalProducts
                    </h2>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================================
         VERIFICATION
         ============================================================ -->

    <h3 class="fw-bold mb-3">
        Verification
    </h3>


    <div class="row g-4 mb-5">

        <!-- IDENTITY VERIFICATION -->

        <div class="col-12 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="fs-1">
                                🪪
                            </div>

                            <h4 class="fw-bold mt-2">
                                Identity Verification
                            </h4>

                            <p class="text-muted">
                                Review government-issued identity
                                documents submitted by users.
                            </p>

                        </div>


                        <div>

                            <span class="badge bg-warning text-dark">

                                @(ViewBag.PendingIdentityVerification ?? 0)

                                Pending

                            </span>

                        </div>

                    </div>


                    <a asp-controller="Admin"
                       asp-action="IdentityVerification"
                       class="btn btn-dark mt-3">

                        Review Identity Documents

                    </a>

                </div>

            </div>

        </div>


        <!-- SELLER VERIFICATION -->

        <div class="col-12 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="fs-1">
                                🏪
                            </div>

                            <h4 class="fw-bold mt-2">
                                Seller Verification
                            </h4>

                            <p class="text-muted">
                                Review sellers waiting for approval.
                            </p>

                        </div>


                        <div>

                            <span class="badge bg-warning text-dark">

                                @(ViewBag.PendingVerification ?? 0)

                                Pending

                            </span>

                        </div>

                    </div>


                    <a asp-controller="Admin"
                       asp-action="SellerVerification"
                       class="btn btn-success mt-3">

                        Review Sellers

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================================
         MANAGEMENT
         ============================================================ -->

    <h3 class="fw-bold mb-3">
        Management
    </h3>


    <div class="row g-4">

        <!-- ========================================================
             USERS
             ======================================================== -->

        <div class="col-12 col-md-6 col-lg-3">

            <a asp-controller="Admin"
               asp-action="Users"
               class="text-decoration-none">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-body text-center">

                        <div class="fs-1">
                            👥
                        </div>

                        <h5 class="fw-bold mt-2">
                            Manage Users
                        </h5>

                        <p class="text-muted small">
                            View and manage registered users.
                        </p>

                    </div>

                </div>

            </a>

        </div>


        <!-- ========================================================
             SELLERS
             ======================================================== -->

        <div class="col-12 col-md-6 col-lg-3">

            <a asp-controller="Admin"
               asp-action="Sellers"
               class="text-decoration-none">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-body text-center">

                        <div class="fs-1">
                            🏪
                        </div>

                        <h5 class="fw-bold mt-2">
                            Manage Sellers
                        </h5>

                        <p class="text-muted small">
                            View registered sellers.
                        </p>

                    </div>

                </div>

            </a>

        </div>


        <!-- ========================================================
             PRODUCTS
             ======================================================== -->

        <div class="col-12 col-md-6 col-lg-3">

            <a asp-controller="Admin"
               asp-action="Products"
               class="text-decoration-none">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-body text-center">

                        <div class="fs-1">
                            👗
                        </div>

                        <h5 class="fw-bold mt-2">
                            Manage Products
                        </h5>

                        <p class="text-muted small">
                            Review and manage marketplace products.
                        </p>

                    </div>

                </div>

            </a>

        </div>


        <!-- ========================================================
             ADMINISTRATORS
             ======================================================== -->

        <div class="col-12 col-md-6 col-lg-3">

            <a asp-controller="Admin"
               asp-action="Administrators"
               class="text-decoration-none">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-body text-center">

                        <div class="fs-1">
                            🛡️
                        </div>

                        <h5 class="fw-bold mt-2">
                            Administrators
                        </h5>

                        <p class="text-muted small">
                            View ThriftHub administrators.
                        </p>

                    </div>

                </div>

            </a>

        </div>


        <!-- ========================================================
             REPORTS & SAFETY
             ======================================================== -->

        <div class="col-12 col-md-6 col-lg-3">

            <a asp-controller="Safety"
               asp-action="AdminReports"
               class="text-decoration-none">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-body text-center">

                        <div class="fs-1">
                            🚨
                        </div>

                        <h5 class="fw-bold mt-2">
                            Reports & Safety
                        </h5>

                        <p class="text-muted small">
                            Review user reports and safety issues.
                        </p>

                    </div>

                </div>

            </a>

        </div>

    </div>


    <!-- ============================================================
         VERIFIED SELLERS
         ============================================================ -->

    <div class="card shadow-sm border-0 mt-5">

        <div class="card-body">

            <div class="row align-items-center">

                <div class="col">

                    <h4 class="fw-bold mb-1">
                        Verified Sellers
                    </h4>

                    <p class="text-muted mb-0">
                        Sellers who have completed verification
                        and received approval.
                    </p>

                </div>


                <div class="col-auto">

                    <span class="display-6 fw-bold">
                        @(ViewBag.VerifiedSellers ?? 0)
                    </span>

                </div>


                <div class="col-12 col-md-auto mt-3 mt-md-0">

                    <a asp-controller="Admin"
                       asp-action="VerifiedSellers"
                       class="btn btn-outline-success">

                        View Verified Sellers

                    </a>

                </div>

            </div>

        </div>

    </div>


</div>