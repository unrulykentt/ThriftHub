        );


        async function acceptVoiceCall() {

            try {

                localStream =
                    await navigator.mediaDevices
                        .getUserMedia({
                            audio: true,
                            video: false
                        });


                await createPeerConnection(
                    currentCallUser
                );


                await connection.invoke(
                    "AcceptCall",
