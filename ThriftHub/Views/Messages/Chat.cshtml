            null;

        let remoteStream =
            null;

        let currentCallUser =
            null;

        let isMuted =
            false;


        /* =========================================================
           ADDED AUDIO FIX
           ========================================================= */

        let pendingIceCandidates =
            [];

        let remoteDescriptionSet =
            false;


        const rtcConfiguration = {

            iceServers: [

                {
                    urls:
                        "stun:stun.l.google.com:19302"
                },

                {
                    urls:
                        "stun:stun1.l.google.com:19302"
