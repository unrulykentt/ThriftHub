@model ThriftHub.Models.ConversationViewModel

@using System.Security.Claims
@using ThriftHub.Services

@{
    ViewData["Title"] = "Chat";

    var currentUserId =
        User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";

    var recipientId =
        Model.UserId?.ToString() ?? "";

    var recipientName =
        string.IsNullOrWhiteSpace(Model.UserName)
            ? "User"
            : Model.UserName;

    var recipientInitials =
        UserPresentationHelper.GetInitials(recipientName);

    var recipientPhoto =
        UserPresentationHelper.ResolveProfileImageUrl(
            Model.ProfileImageUrl);

    var currentUserDisplayName =
        ViewBag.CurrentUserDisplayName as string
        ?? "You";

    var currentUserInitials =
        UserPresentationHelper.GetInitials(
            currentUserDisplayName);

    var currentUserPhoto =
        ViewBag.CurrentUserProfileImage as string;

    string FormatRoleLabel(string? userType) =>
        UserPresentationHelper.GetRoleLabel(userType);

    var currentUserRole =
        ViewBag.CurrentUserRole as string
        ?? "Customer";

    var recipientRole =
        Model.UserRole ?? "Customer";

    var currentUserRoleLabel =
        FormatRoleLabel(currentUserRole);

    var recipientRoleLabel =
        FormatRoleLabel(recipientRole);

    var recipientRoleClass =
        recipientRoleLabel.Equals(
            "Seller",
            StringComparison.OrdinalIgnoreCase)
            ? "seller"
            : "buyer";

    var currentUserRoleClass =
        currentUserRoleLabel.Equals(
            "Seller",
            StringComparison.OrdinalIgnoreCase)
            ? "seller"
            : "buyer";
}

<link rel="stylesheet" href="~/css/chat-snap.css" asp-append-version="true" />


<div class="th-chat-page">

    @Html.AntiForgeryToken()

    <div class="chat-card">

        <!-- =====================================================
             HEADER
             ====================================================== -->

        <div class="chat-header">

            <div class="chat-user">

                <a href="@Url.Action("Index", "Messages")"
                   class="back-button">

                    ←

                </a>


                @if (!string.IsNullOrWhiteSpace(recipientPhoto))
                {
                    <img src="@recipientPhoto"
                         class="profile-picture"
                         alt="@recipientName" />
                }
                else
                {
                    <div class="profile-placeholder profile-avatar-initials"
                         aria-label="@recipientName">
                        @recipientInitials
                    </div>
                }


                <div class="user-info">

                    <div class="user-name">
                        @recipientName
                    </div>

                    <div class="user-meta-row">

                        <span class="role-badge @recipientRoleClass">
                            @recipientRoleLabel
                        </span>

                        <div class="online-status">
                            <span id="onlineDot" class="online-dot"></span>
                            <span id="onlineText">
                                @(Model.IsOnline ? "Online" : "Offline")
                            </span>
                        </div>

                    </div>

                </div>

            </div>


            <!-- VOICE CALL ONLY -->

            <div class="chat-actions">

                <button type="button"
                        id="voiceCallButton"
                        class="voice-call-button"
                        title="Voice call">

                    📞

                </button>

            </div>

        </div>


        <!-- =====================================================
             MESSAGES
             ====================================================== -->

        <div id="messagesContainer"
             class="messages-container">

            <div id="messagesList"
                 class="messages-list">

                @if  (Model.Messages !=null)
                {
                    DateTime? lastDate = null;

                    foreach (
                        var message
                        in Model.Messages)
                            
                    {
                        var messageDate =
                            message.SentAt
                                .ToLocalTime()
                                .Date;

                        if (
                            lastDate == null ||
                            lastDate.Value != messageDate)
                        {
                            <div class="date-divider">

                                <span>

                                    @(messageDate.ToString("ddd, dd MMM yyyy"))

                                </span>

                            </div>

                            lastDate =
                                messageDate;
                        }

                        var isSent =
                            message.SenderId ==
                            currentUserId;


                        <div class="message-row @(isSent ? "sent" : "received")"
                             @(message.Id > 0 ? $"data-message-id=\"{message.Id}\"" : "")>

                            @if (!isSent)
                            {
                                <div class="message-avatar">
                                    @if (!string.IsNullOrWhiteSpace(recipientPhoto))
                                    {
                                        <img src="@recipientPhoto" alt="@recipientName" />
                                    }
                                    else
                                    {
                                        <div class="message-avatar-fallback">@recipientInitials</div>
                                    }
                                </div>
                            }

                            <div class="message-stack">

                                @if (
                                    message.MessageType.Equals("audio", StringComparison.OrdinalIgnoreCase)
                                    && !string.IsNullOrWhiteSpace(message.FileUrl))
                                {
                                    <div class="message-bubble voice-bubble snap-voice-mount"
                                         data-audio-url="@message.FileUrl"
                                         data-is-sent="@(isSent ? "true" : "false")">
                                    </div>
                                }
                                else if (
                                    message.MessageType.Equals("image", StringComparison.OrdinalIgnoreCase)
                                    && !string.IsNullOrWhiteSpace(message.FileUrl))
                                {
                                    <div class="message-bubble image-message">
                                        <img src="@message.FileUrl"
                                             class="chat-image"
                                             alt="Shared image"
                                             loading="lazy"
                                             onclick="openImageLightbox(this.src)" />
                                    </div>
                                }
                                else if (
                                    message.MessageType.Equals("file", StringComparison.OrdinalIgnoreCase)
                                    && !string.IsNullOrWhiteSpace(message.FileUrl))
                                {
                                    <div class="message-bubble">
                                        <a href="@message.FileUrl"
                                           class="file-message"
                                           download="@message.FileName">
                                            <span class="file-icon">📎</span>
                                            <span class="file-name">
                                                @(string.IsNullOrWhiteSpace(message.FileName) ? "File" : message.FileName)
                                            </span>
                                        </a>
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(message.Content))
                                {
                                    <div class="message-bubble">@message.Content</div>
                                }

                                <div class="message-meta">
                                    <span>@(message.SentAt.ToLocalTime().ToString("hh:mm tt"))</span>
                                    @if (isSent)
                                    {
                                        <span class="message-read-status">@(message.IsRead ? "✓✓" : "✓")</span>
                                    }
                                </div>

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="empty-chat">

                        <div class="empty-chat-inner">

                            <div class="empty-icon">

                                💬

                            </div>

                            <h3>

                                Start a conversation

                            </h3>

                            <p>

                                Send a message to
                                @recipientName

                            </p>

                        </div>

                    </div>
                }

            </div>

        </div>


        <!-- =====================================================
             INPUT AREA
             ====================================================== -->

        <div class="chat-input-area">


            <!-- EMOJI PICKER -->

            <div id="emojiPicker"
                 class="emoji-picker">

                <div class="emoji-title">

                    Emojis

                </div>

                <div class="emoji-grid">

                    @{
                        var emojis = new[]
                        {
                            "😀","😃","😄","😁","😆","😅","😂","🤣",
                            "😊","😇","🙂","🙃","😉","😌","😍","🥰",
                            "😘","😗","😙","😚","😋","😛","😝","😜",
                            "🤪","🤨","🧐","🤓","😎","🤩","🥳","😏",
                            "😢","😭","😤","😠","😡","🤬","😱","😨",
                            "😳","🥺","😔","😞","😟","😕","🙁","☹️",
                            "❤️","🩷","🧡","💛","💚","🩵","💙","💜",
                            "🖤","🩶",
                            "👍","👎","👏","🙌","🙏","💪","🤝","🔥",
                            "✨","🎉","💯","❤️‍🔥","💔","💖","💗","💓",
                            "💞","💘","💝","🎂","🎁","⚽","🏆","🎵"
                        };
                    }

                    @foreach (var emoji in emojis)
                    {
                        <button type="button"
                                class="emoji-item"
                                data-emoji="@emoji">

                            @emoji

                        </button>
                    }

                </div>

            </div>


            <!-- RECORDING INDICATOR -->

            <div id="recordingIndicator"
                 class="recording-indicator">

                <span class="recording-dot">
                </span>

                <span id="recordingTime">

                    00:00

                </span>

                <span>

                    Recording...

                </span>

            </div>


            <!-- SELECTED FILE -->

            <div id="filePreview"
                 class="file-preview">

                <div class="file-preview-info">

                    <div id="filePreviewName"
                         class="file-preview-name">
                    </div>

                </div>

                <button type="button"
                        id="removeFileButton"
                        class="remove-file">

                    ×

                </button>

            </div>


            <div class="composer-tools">
                <button type="button" id="emojiButton" class="input-icon" title="Emoji">😊</button>
                <button type="button" id="fileButton" class="input-icon" title="Send file">📎</button>
            </div>

            <input type="file" id="imageInput" accept="image/*" hidden />
            <input type="file" id="fileInput" hidden />

            <div class="snap-composer">

                <button type="button"
                        id="imageButton"
                        class="snap-composer-icon"
                        title="Send photo">
                    📷
                </button>

                <div class="snap-input-shell">
                    <textarea id="messageInput"
                              class="message-input"
                              rows="1"
                              maxlength="5000"
                              placeholder="Send a chat..."
                              autocomplete="off"></textarea>
                </div>

                <button type="button"
                        id="recordButton"
                        class="snap-composer-icon"
                        title="Record voice note">
                    🎤
                </button>

                <button type="button"
                        id="sendButton"
                        class="send-button"
                        title="Send">
                    ➤
                </button>

            </div>

        </div>

    </div>

</div>


<div id="imageLightbox"
     class="image-lightbox"
     onclick="closeImageLightbox(event)">

    <button type="button"
            class="image-lightbox-close"
            onclick="closeImageLightbox(event)"
            aria-label="Close image preview">
        ×
    </button>

    <div class="image-lightbox-content"
         onclick="event.stopPropagation()">

        <img id="imageLightboxPreview"
             src=""
             alt="Chat image preview" />

    </div>

</div>


<!-- =========================================================
     VOICE CALL WINDOW
     ========================================================= -->

<div id="callOverlay"
     class="call-overlay">

    <div class="call-card">

        <div class="call-avatar">
            @if (!string.IsNullOrWhiteSpace(recipientPhoto))
            {
                <img src="@recipientPhoto" alt="@recipientName" />
            }
            else
            {
                @recipientInitials
            }
        </div>

        <div class="call-name">

            @recipientName

        </div>

        <div id="callStatus"
             class="call-status">

            Calling...

        </div>

        <div class="call-controls">

            <button type="button"
                    id="acceptCallButton"
                    class="call-control accept-call"
                    title="Answer">

                📞

            </button>

            <button type="button"
                    id="muteCallButton"
                    class="call-control mute-call"
                    title="Mute">

                🎤

            </button>

            <button type="button"
                    id="endCallButton"
                    class="call-control end-call"
                    title="End call">

                📵

            </button>

        </div>

    </div>

</div>


<!-- LIVE CALL AUDIO -->

<audio id="remoteAudio"
       autoplay
       playsinline>
</audio>


@section Scripts {

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.29/signalr.min.js"></script>

    <script>

        /* =========================================================
           BASIC DATA
           ========================================================= */

        const currentUserId =
            "@currentUserId";

        const recipientId =
            "@recipientId";

        const recipientName =
            "@recipientName";

        const currentUserRoleLabel =
            "@currentUserRoleLabel";

        const recipientRoleLabel =
            "@recipientRoleLabel";

        const currentUserRoleClass =
            "@currentUserRoleClass";

        const recipientRoleClass =
            "@recipientRoleClass";

        const recipientProfileImage =
            "@(recipientPhoto ?? "")";

        const recipientInitials =
            "@recipientInitials";


        /* =========================================================
           DOM
           ========================================================= */

        const messagesContainer =
            document.getElementById(
                "messagesContainer");

        const messagesList =
            document.getElementById(
                "messagesList");

        const messageInput =
            document.getElementById(
                "messageInput");

        const sendButton =
            document.getElementById(
                "sendButton");

        const emojiButton =
            document.getElementById(
                "emojiButton");

        const emojiPicker =
            document.getElementById(
                "emojiPicker");

        const imageButton =
            document.getElementById(
                "imageButton");

        const fileButton =
            document.getElementById(
                "fileButton");

        const imageInput =
            document.getElementById(
                "imageInput");

        const fileInput =
            document.getElementById(
                "fileInput");

        const recordButton =
            document.getElementById(
                "recordButton");

        const recordingIndicator =
            document.getElementById(
                "recordingIndicator");

        const recordingTime =
            document.getElementById(
                "recordingTime");

        const filePreview =
            document.getElementById(
                "filePreview");

        const filePreviewName =
            document.getElementById(
                "filePreviewName");

        const removeFileButton =
            document.getElementById(
                "removeFileButton");

        const voiceCallButton =
            document.getElementById(
                "voiceCallButton");

        const callOverlay =
            document.getElementById(
                "callOverlay");

        const callStatus =
            document.getElementById(
                "callStatus");

        const acceptCallButton =
            document.getElementById(
                "acceptCallButton");

        const muteCallButton =
            document.getElementById(
                "muteCallButton");

        const endCallButton =
            document.getElementById(
                "endCallButton");

        const remoteAudio =
            document.getElementById(
                "remoteAudio");


        /* =========================================================
           ANTI FORGERY TOKEN
           ========================================================= */

        const antiForgeryToken =
            document.querySelector(
                'input[name="__RequestVerificationToken"]'
            )?.value || "";


        function openImageLightbox(src) {

            const overlay =
                document.getElementById(
                    "imageLightbox"
                );

            const preview =
                document.getElementById(
                    "imageLightboxPreview"
                );


            if (!overlay || !preview || !src) {
                return;
            }


            preview.src = src;

            overlay.classList.add(
                "show"
            );

        }


        function closeImageLightbox(event) {

            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }


            const overlay =
                document.getElementById(
                    "imageLightbox"
                );

            const preview =
                document.getElementById(
                    "imageLightboxPreview"
                );


            if (!overlay) {
                return;
            }


            overlay.classList.remove(
                "show"
            );


            if (preview) {
                preview.src = "";
            }

        }


        function getAudioMimeType(fileUrl) {

            const url =
                String(fileUrl || "")
                    .toLowerCase();


            if (
                url.endsWith(".m4a") ||
                url.endsWith(".mp4")
            ) {
                return "audio/mp4";
            }


            if (url.endsWith(".ogg")) {
                return "audio/ogg";
            }


            if (url.endsWith(".mp3")) {
                return "audio/mpeg";
            }


            if (url.endsWith(".wav")) {
                return "audio/wav";
            }


            return "audio/webm";

        }


        function createAudioPlayer(fileUrl) {

            const wrapper =
                document.createElement("div");

            wrapper.className =
                "snap-voice-player";


            const playButton =
                document.createElement("button");

            playButton.type = "button";
            playButton.className = "snap-voice-play";
            playButton.textContent = "▶";


            const wave =
                document.createElement("div");

            wave.className = "snap-voice-wave";


            for (let index = 0; index < 14; index++) {

                const bar =
                    document.createElement("span");

                bar.className = "snap-voice-bar";
                bar.style.height =
                    `${24 + Math.random() * 56}%`;

                wave.appendChild(bar);

            }


            const duration =
                document.createElement("span");

            duration.className =
                "snap-voice-duration";

            duration.textContent = "0:00";


            const audio =
                document.createElement("audio");

            audio.preload = "metadata";
            audio.style.display = "none";


            const source =
                document.createElement("source");

            source.src = fileUrl;
            source.type = getAudioMimeType(fileUrl);

            audio.appendChild(source);


            playButton.addEventListener(
                "click",
                function () {

                    if (audio.paused) {
                        audio.play();
                    }
                    else {
                        audio.pause();
                    }

                }
            );


            audio.addEventListener(
                "play",
                function () {

                    playButton.textContent = "❚❚";

                    document
                        .querySelectorAll(
                            ".snap-voice-player audio"
                        )
                        .forEach(
                            function (otherAudio) {

                                if (
                                    otherAudio !==
                                    audio
                                ) {
                                    otherAudio.pause();
                                }

                            }
                        );

                }
            );


            audio.addEventListener(
                "pause",
                function () {
                    playButton.textContent = "▶";
                }
            );


            audio.addEventListener(
                "ended",
                function () {
                    playButton.textContent = "▶";
                }
            );


            audio.addEventListener(
                "loadedmetadata",
                function () {

                    if (
                        !isFinite(
                            audio.duration
                        )
                    ) {
                        return;
                    }

                    duration.textContent =
                        formatAudioDuration(
                            audio.duration
                        );

                }
            );


            wrapper.appendChild(playButton);
            wrapper.appendChild(wave);
            wrapper.appendChild(duration);
            wrapper.appendChild(audio);

            audio.load();

            return wrapper;

        }


        function formatAudioDuration(
            totalSeconds
        ) {

            const seconds =
                Math.max(
                    0,
                    Math.floor(totalSeconds)
                );

            const minutes =
                Math.floor(seconds / 60);

            const remainder =
                seconds % 60;

            return (
                minutes +
                ":" +
                String(remainder)
                    .padStart(2, "0")
            );

        }


        function mountSnapVoicePlayers() {

            document
                .querySelectorAll(
                    ".snap-voice-mount"
                )
                .forEach(
                    function (mount) {

                        if (
                            mount.dataset.mounted ===
                            "true"
                        ) {
                            return;
                        }

                        const fileUrl =
                            mount.dataset.audioUrl;

                        if (!fileUrl) {
                            return;
                        }

                        mount.innerHTML = "";
                        mount.appendChild(
                            createAudioPlayer(
                                fileUrl
                            )
                        );

                        mount.dataset.mounted =
                            "true";

                    }
                );

        }


        /* =========================================================
           SIGNALR
           ========================================================= */

        const connection =
            new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .withAutomaticReconnect()
                .build();

        window.chatConnection =
            connection;


        /* =========================================================
           SIGNALR STATUS
           ========================================================= */

        connection.onreconnecting(function() {

            setOnlineStatus(
                "Connecting...",
                false
            );

        });


        connection.onreconnected(function() {

            setOnlineStatus(
                "Online",
                true
            );

            checkRecipientStatus();

        });


        connection.onclose(function() {

            setOnlineStatus(
                "Offline",
                false
            );

        });


        /* =========================================================
           ONLINE STATUS
           ========================================================= */

        function setOnlineStatus(
            text,
            online
        ) {

            const textElement =
                document.getElementById(
                    "onlineText");

            const dot =
                document.getElementById(
                    "onlineDot");

            if (textElement) {

                textElement.textContent =
                    text;

            }

            if (dot) {

                dot.classList.toggle(
                    "online",
                    online
                );

            }

        }


        connection.on(
            "UserOnline",
            function(userId) {

                if (
                    String(userId) ===
                    String(recipientId)
                ) {

                    setOnlineStatus(
                        "Online",
                        true
                    );

                }

            }
        );


        connection.on(
            "UserOffline",
            function(userId) {

                if (
                    String(userId) ===
                    String(recipientId)
                ) {

                    setOnlineStatus(
                        "Offline",
                        false
                    );

                }

            }
        );


        connection.on(
            "UserStatus",
            function(
                userId,
                online
            ) {

                if (
                    String(userId) ===
                    String(recipientId)
                ) {

                    setOnlineStatus(
                        online
                            ? "Online"
                            : "Offline",
                        online
                    );

                }

            }
        );


        async function checkRecipientStatus() {

            if (
                connection.state !==
                signalR.HubConnectionState.Connected
            ) {

                return;

            }

            try {

                await connection.invoke(
                    "CheckUserStatus",
                    recipientId
                );

            }
            catch (error) {

                console.error(
                    error
                );

            }

        }


        /* =========================================================
           MESSAGE RECEIVING
           ========================================================= */

        connection.on(
            "NewMessage",
            function(message) {

                if (
                    String(message.senderId) !==
                    String(recipientId)
                ) {

                    return;

                }

                appendMessage(
                    message,
                    false
                );

            }
        );


        connection.on(
            "MessageSent",
            function(message) {

                if (
                    String(message.recipientId) !==
                    String(recipientId)
                ) {

                    return;

                }

                appendMessage(
                    message,
                    true
                );

            }
        );


        connection.on(
            "MessagesRead",
            function(userId) {

                if (
                    String(userId) !==
                    String(recipientId)
                ) {

                    return;

                }

                document
                    .querySelectorAll(
                        ".message-read-status"
                    )
                    .forEach(
                        element => {

                            element.textContent =
                                "✓✓";

                        }
                    );

            }
        );


        /* =========================================================
           BUILD MESSAGE
           ========================================================= */

        function appendMessage(
            message,
            isSent
        ) {

            if (
                message &&
                message.id
            ) {

                const existing =
                    messagesList.querySelector(
                        `[data-message-id="${message.id}"]`
                    );


                if (existing) {
                    return;
                }

            }


            const emptyChat =
                messagesList.querySelector(
                    ".empty-chat"
                );


            if (emptyChat) {
                emptyChat.remove();
            }


            const row =
                document.createElement("div");

            row.className =
                "message-row " +
                (isSent ? "sent" : "received");


            if (message.id) {
                row.dataset.messageId = message.id;
            }


            if (!isSent) {

                const avatar =
                    document.createElement("div");

                avatar.className = "message-avatar";

                if (
                    recipientProfileImage &&
                    recipientProfileImage.length > 0
                ) {

                    const avatarImage =
                        document.createElement("img");

                    avatarImage.src =
                        recipientProfileImage;

                    avatarImage.alt =
                        recipientName;

                    avatar.appendChild(
                        avatarImage
                    );

                }
                else {

                    const avatarFallback =
                        document.createElement("div");

                    avatarFallback.className =
                        "message-avatar-fallback";

                    avatarFallback.textContent =
                        recipientInitials;

                    avatar.appendChild(
                        avatarFallback
                    );

                }

                row.appendChild(avatar);

            }


            const stack =
                document.createElement("div");

            stack.className = "message-stack";


            let bubble =
                document.createElement("div");

            bubble.className =
                "message-bubble";


            const type =
                String(
                    message.messageType ||
                    "text"
                ).toLowerCase();


            if (
                type === "audio" &&
                message.fileUrl
            ) {

                bubble.classList.add(
                    "voice-bubble"
                );

                bubble.appendChild(
                    createAudioPlayer(
                        message.fileUrl
                    )
                );

            }
            else if (
                type === "image" &&
                message.fileUrl
            ) {

                bubble.classList.add(
                    "image-message"
                );


                const image =
                    document.createElement("img");

                image.src = message.fileUrl;
                image.className = "chat-image";
                image.alt = "Shared image";
                image.loading = "lazy";

                image.onclick =
                    function () {
                        openImageLightbox(this.src);
                    };


                bubble.appendChild(image);

            }
            else if (
                type === "file" &&
                message.fileUrl
            ) {

                const link =
                    document.createElement("a");

                link.href = message.fileUrl;
                link.download =
                    message.fileName || "file";

                link.className =
                    "file-message";

                link.innerHTML =
                    `<span class="file-icon">📎</span><span class="file-name">${escapeHtml(message.fileName || "File")}</span>`;

                bubble.appendChild(link);

            }
            else {

                bubble.textContent =
                    message.content || "";

            }


            stack.appendChild(bubble);


            const meta =
                document.createElement("div");

            meta.className = "message-meta";


            const time =
                document.createElement("span");

            time.textContent =
                formatTime(message.sentAt);

            meta.appendChild(time);


            if (isSent) {

                const read =
                    document.createElement("span");

                read.className =
                    "message-read-status";

                read.textContent =
                    message.isRead ? "✓✓" : "✓";

                meta.appendChild(read);

            }


            stack.appendChild(meta);
            row.appendChild(stack);
            messagesList.appendChild(row);

            scrollToBottom();

        }


        /* =========================================================
           ESCAPE HTML
           ========================================================= */

        function escapeHtml(
            value
        ) {

            return String(value)
                .replace(
                    /&/g,
                    "&amp;"
                )
                .replace(
                    /</g,
                    "&lt;"
                )
                .replace(
                    />/g,
                    "&gt;"
                )
                .replace(
                    /"/g,
                    "&quot;"
                )
                .replace(
                    /'/g,
                    "&#039;"
                );

        }


        /* =========================================================
           TIME
           ========================================================= */

        function formatTime(
            value
        ) {

            if (!value) {

                return "";

            }


            const date =
                new Date(value);


            if (
                Number.isNaN(
                    date.getTime()
                )
            ) {

                return "";

            }


            return date.toLocaleTimeString(
                [],
                {
                    hour: "numeric",
                    minute: "2-digit"
                }
            );

        }


        /* =========================================================
           SEND TEXT
           ========================================================= */

        async function sendText() {

            const text =
                messageInput.value.trim();


            if (!text) {

                return;

            }


            sendButton.disabled =
                true;


            try {

                const formData =
                    new URLSearchParams();


                formData.append(
                    "recipientId",
                    recipientId
                );


                formData.append(
                    "content",
                    text
                );


                const response =
                    await fetch(
                        "/Messages/Send",
                        {
                            method: "POST",

                            headers: {

                                "Content-Type":
                                    "application/x-www-form-urlencoded",

                                "RequestVerificationToken":
                                    antiForgeryToken

                            },

                            body:
                                formData.toString()

                        }
                    );


                if (!response.ok) {

                    const errorText =
                        await response.text();


                    console.error(
                        errorText
                    );


                    throw new Error(
                        "Message could not be sent."
                    );

                }


                messageInput.value =
                    "";

                resizeMessageBox();

            }
            catch (error) {

                console.error(
                    error
                );


                alert(
                    "Message could not be sent."
                );

            }
            finally {

                sendButton.disabled =
                    false;

            }

        }


        sendButton.addEventListener(
            "click",
            sendText
        );


