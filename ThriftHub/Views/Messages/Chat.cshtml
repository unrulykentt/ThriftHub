        );


        async function startVoiceCall() {

            try {

                if (
                    connection.state !==
                    signalR.HubConnectionState.Connected
                ) {

                    alert(
                        "Connecting to ThriftHub. Please try again."
                    );

                    return;

                }


                localStream =
                    await navigator.mediaDevices
                        .getUserMedia({
                            audio: true,
                            video: false
                        });


                currentCallUser =
                    recipientId;


                await createPeerConnection(
                    recipientId
                );


                showCallWindow(
                    "Calling..."
                );


                await connection.invoke(
                    "StartCall",
                    recipientId,
                    "audio"
                );

            }
            catch (error) {

                console.error(
                    "Voice call error:",
                    error
                );


                closeCall();


                if (
                    error.message &&
                    error.message.includes(
                        "not currently connected"
                    )
                ) {

                    alert(
                        "The other user is not currently online."
                    );

                }
                else {

                    alert(
                        "Unable to start the voice call. Check microphone permission."
                    );

                }

            }

        }


        /* =========================================================
           INCOMING CALL
           ========================================================= */

        connection.on(
            "IncomingVoiceCall",
            function(callerId) {

