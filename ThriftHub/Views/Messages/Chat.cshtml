        /* =========================================================
           UPLOAD IMAGE / FILE / AUDIO
           ========================================================= */

        async function uploadFile(
            file
        ) {

            if (!file) {

                return;

            }


            if (
                file.size >
                5 * 1024 * 1024
            ) {

                alert(
                    "The file must not exceed 5 MB."
                );


                clearSelectedFile();

                return;

            }


            const formData =
                new FormData();


            formData.append(
                "recipientId",
                recipientId
            );


            formData.append(
                "file",
                file
            );


            if (antiForgeryToken) {

                formData.append(
                    "__RequestVerificationToken",
                    antiForgeryToken
                );

            }


            try {

                const response =
                    await fetch(
                        "/Messages/SendFile",
                        {
                            method: "POST",

                            headers: {

                                "RequestVerificationToken":
                                    antiForgeryToken

                            },

                            body:
                                formData

                        }
                    );


                if (!response.ok) {

                    const error =
                        await response.text();


                    console.error(
                        error
                    );


                    throw new Error(
                        "Upload failed."
                    );

                }


                const payload =
                    await response.json();


                if (
                    payload &&
                    payload.fileUrl
                ) {

                    appendMessage(
                        payload,
                        true
                    );

                }


                clearSelectedFile();

            }
            catch (error) {

                console.error(
                    error
                );


                alert(
                    "The file could not be sent."
                );


                clearSelectedFile();

            }

        }


