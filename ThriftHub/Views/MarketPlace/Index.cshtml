<!-- =========================================================
     WISHLIST COUNT
     ========================================================= -->
@if (User.Identity?.IsAuthenticated == true)
{
    <script>

        async function updateWishlistCount() {

            try {

                const response =
                    await fetch(
                        '/Favorites/Count',
                        {
                            method: 'GET',
                            credentials: 'same-origin'
                        }
                    );


                if (!response.ok) {
                    return;
                }


                const data =
                    await response.json();


                const badge =
                    document.getElementById(
                        'thWishlistCount'
                    );


                if (!badge) {
                    return;
                }


                const count =
                    Number(data.count || 0);


                if (count > 0) {

                    badge.textContent =
                        count > 99
                            ? '99+'
                            : count;

                    badge.style.display =
                        'flex';

                }
                else {

                    badge.textContent =
                        '0';

                    badge.style.display =
                        'none';

                }

            }
            catch (error) {

                console.log(
                    'Unable to load wishlist count.'
                );

            }

        }


        updateWishlistCount();


        document
            .querySelectorAll(
                ".th-wishlist-form"
            )
            .forEach(
                function (form) {

                    form.addEventListener(
                        "submit",
                        async function (event) {

                            event.preventDefault();

                            const button =
                                form.querySelector(
                                    ".th-wishlist"
                                );

                            const productInput =
                                form.querySelector(
                                    'input[name="productId"]'
                                );

                            const tokenInput =
                                form.querySelector(
                                    'input[name="__RequestVerificationToken"]'
                                );


                            if (
                                !button ||
                                !productInput ||
                                !tokenInput
                            ) {
                                return;
                            }


                            const productId =
                                productInput.value;

                            const token =
                                tokenInput.value;


                            button.disabled =
                                true;


                            try {

                                const body =
                                    new URLSearchParams();


                                body.append(
                                    "productId",
                                    productId
                                );


                                body.append(
                                    "__RequestVerificationToken",
                                    token
                                );


                                const response =
                                    await fetch(
                                        "/Favorites/Toggle",
                                        {
                                            method: "POST",

                                            headers: {
                                                "Content-Type":
                                                    "application/x-www-form-urlencoded",
                                                "RequestVerificationToken":
                                                    token,
                                                "X-Requested-With":
                                                    "XMLHttpRequest"
                                            },

                                            body:
                                                body.toString(),

                                            credentials:
                                                "same-origin"
                                        }
                                    );


                                if (!response.ok) {
                                    throw new Error(
                                        "Wishlist update failed."
                                    );
                                }


                                const data =
                                    await response.json();


                                const isFavorite =
                                    !!data.isFavorite;


                                button.classList.toggle(
                                    "favorited",
                                    isFavorite
                                );


                                button.textContent =
                                    isFavorite
                                        ? "♥"
                                        : "♡";


                                button.title =
                                    isFavorite
                                        ? "Remove from wishlist"
                                        : "Add to wishlist";


                                button.setAttribute(
                                    "aria-label",
                                    button.title
                                );


                                updateWishlistCount();

                            }
                            catch (error) {

                                console.log(
                                    error
                                );

                            }
                            finally {

                                button.disabled =
                                    false;

                            }

                        }
                    );

                }
            );

    </script>
}