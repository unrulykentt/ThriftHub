@if (ViewBag.AppleEnabled == true)
{
    <div class="external-auth mb-4">

        <p class="text-center text-muted small mb-3">
            Continue with
        </p>

        <div class="d-grid gap-2">

            <form asp-controller="Account"
                  asp-action="ExternalLogin"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="provider"
                       value="Apple" />

                <input type="hidden"
                       name="returnUrl"
                       value="@ViewData["ReturnUrl"]" />

                <button type="submit"
                        class="btn btn-dark w-100 d-flex align-items-center justify-content-center gap-2">

                    <span style="font-size:18px;"></span>
                    Continue with Apple

                </button>

            </form>

        </div>

        <div class="text-center text-muted small my-3">
            or use email
        </div>

    </div>
}
