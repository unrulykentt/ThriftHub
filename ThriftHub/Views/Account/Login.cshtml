@model ThriftHub.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<style>
    .login-page {
        position: relative;
        isolation: isolate;
        display: grid;
        align-items: center;
        min-height: calc(100vh - 5rem);
        padding: 3rem 1rem;
        background:
            linear-gradient(115deg, rgba(8, 27, 29, .82), rgba(8, 27, 29, .44)),
            url('/images/login-marketplace-wallpaper.png') center / cover no-repeat;
    }

    .login-page::before {
        position: absolute;
        z-index: -1;
        inset: 0;
        content: "";
        background: radial-gradient(circle at center, transparent 0, rgba(3, 16, 18, .18) 72%);
    }

    .login-card {
        border: 1px solid rgba(255, 255, 255, .45) !important;
        border-radius: 1.25rem;
        background: rgba(255, 255, 255, .94);
        box-shadow: 0 1.5rem 3.5rem rgba(0, 0, 0, .32) !important;
        backdrop-filter: blur(12px);
    }

    .login-card .card-body {
        padding: clamp(1.75rem, 4vw, 2.5rem) !important;
    }

    .login-card h1 {
        color: #123b3f;
        letter-spacing: -.035em;
    }

    .login-card .btn-primary {
        border: 0;
        background: #0d6b68;
        box-shadow: 0 .5rem 1rem rgba(13, 107, 104, .22);
    }

    .login-card .btn-primary:hover,
    .login-card .btn-primary:focus {
        background: #095451;
    }

    @@media (max-width: 575.98px) {
        .login-page {
            min-height: calc(100vh - 4rem);
            padding: 1.5rem .75rem;
            background-position: 42% center;
        }
    }
</style>

<div class="login-page">

<div class="container">

    <div class="row justify-content-center">

        <div class="col-md-6 col-lg-5">

            <div class="card login-card shadow-sm border-0">

                <div class="card-body p-4">

                    <div class="text-center mb-4">

                        <h1 class="fw-bold">
                            Welcome Back
                        </h1>

                        <p class="text-muted">
                            Login to your ThriftHub account.
                        </p>

                    </div>


                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["SuccessMessage"]
                        </div>
                    }


                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["ErrorMessage"]
                        </div>
                    }


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <partial name="_ExternalAuthButtons" />


                    <form asp-action="Login"
                          asp-controller="Account"
                          method="post">

                        <input type="hidden"
                               name="returnUrl"
                               value="@ViewData["ReturnUrl"]" />


                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   autocomplete="email" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="Password"
                                   class="form-label">
                                Password
                            </label>

                            <input asp-for="Password"
                                   class="form-control"
                                   autocomplete="current-password" />

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>

                            <div class="text-end mt-1">
                                <a asp-action="ForgotPassword"
                                   asp-controller="Account"
                                   class="small text-decoration-none">
                                    Forgot password?
                                </a>
                            </div>

                        </div>


                        <div class="form-check mb-3">

                            <input asp-for="RememberMe"
                                   class="form-check-input" />

                            <label asp-for="RememberMe"
                                   class="form-check-label">
                                Remember Me
                            </label>

                        </div>


                        <button type="submit"
                                class="btn btn-primary w-100">
                            Login
                        </button>

                    </form>


                    <div class="text-center mt-4">

                        <span>
                            Don't have an account?
                        </span>

                        <a asp-action="Register"
                           asp-controller="Account">
                            Create one
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
