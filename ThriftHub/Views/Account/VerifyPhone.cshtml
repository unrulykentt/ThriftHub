@model ThriftHub.Models.VerifyPhoneModel

@{
    ViewData["Title"] = "Verify Phone";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <div class="text-center mb-4">
                        <h2 class="fw-bold">
                            Verify on WhatsApp
                        </h2>

                        <p class="text-muted mb-0">
                            We sent a 6-digit code to your WhatsApp number
                            <strong>@Model.PhoneNumber</strong>.
                        </p>
                    </div>

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-warning">
                            @TempData["ErrorMessage"]
                        </div>
                    }

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    @if (TempData["DevWhatsAppCode"] != null)
                    {
                        <div class="alert alert-info">
                            Development mode WhatsApp code:
                            <strong>@TempData["DevWhatsAppCode"]</strong>
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <form asp-controller="Account"
                          asp-action="VerifyPhone"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="Email" />

                        <input type="hidden"
                               asp-for="PhoneNumber" />

                        <div class="mb-3">
                            <label asp-for="Code"
                                   class="form-label fw-semibold">
                                WhatsApp Verification Code
                            </label>

                            <input asp-for="Code"
                                   class="form-control form-control-lg text-center"
                                   placeholder="Enter 6-digit code"
                                   maxlength="6"
                                   inputmode="numeric"
                                   autocomplete="one-time-code"
                                   autofocus />

                            <span asp-validation-for="Code"
                                  class="text-danger">
                            </span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary btn-lg w-100">
                            Verify Phone
                        </button>

                    </form>

                    <div class="text-center mt-4">
                        <small class="text-muted">
                            Didn't receive the WhatsApp message?
                        </small>

                        <br />

                        <form asp-controller="Account"
                              asp-action="ResendWhatsAppCode"
                              method="post"
                              class="d-inline">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="Email"
                                   value="@Model.Email" />

                            <button type="submit"
                                    class="btn btn-link p-0 align-baseline">
                                Resend WhatsApp code
                            </button>

                        </form>

                        <br />

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="text-decoration-none">
                            Return to Login
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
