@using Microsoft.AspNetCore.Identity
@using ThriftHub.Models
@using ThriftHub.Services
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "My Profile";
    var user = await UserManager.GetUserAsync(User);
    var displayName =
        UserPresentationHelper.GetDisplayName(user);
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-dark text-white">
                    <h3 class="mb-0">My Profile</h3>
                </div>

                <div class="card-body">

                    @if (user == null)
                    {
                        <div class="alert alert-danger">
                            Unable to load your profile.
                        </div>
                    }
                    else
                    {
                        <div class="mb-4">
                            <h4>Account Information</h4>
                            <hr />
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <strong>Name:</strong>
                            </div>

                            <div class="col-md-8">
                                @displayName
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <strong>Email:</strong>
                            </div>

                            <div class="col-md-8">
                                @user.Email
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <strong>Phone:</strong>
                            </div>

                            <div class="col-md-8">
                                @(user.PhoneNumber ?? "Not set")
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <strong>User Type:</strong>
                            </div>

                            <div class="col-md-8">
                                @user.UserType
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <strong>Country:</strong>
                            </div>

                            <div class="col-md-8">
                                @user.Country
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <strong>City:</strong>
                            </div>

                            <div class="col-md-8">
                                @user.City
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <strong>Verification Status:</strong>
                            </div>

                            <div class="col-md-8">

                                @if (user.VerificationStatus == "Verified")
                                {
                                    <span class="badge bg-success">
                                        Account Verified
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        @user.VerificationStatus
                                    </span>
                                }

                            </div>
                        </div>

                        <div class="mt-4 d-flex flex-wrap gap-2">

                            <a asp-controller="Dashboard"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Back to Dashboard
                            </a>

                            <a asp-controller="Account"
                               asp-action="EditProfile"
                               class="btn btn-primary">
                                Edit Name &amp; Profile
                            </a>

                        </div>

                        <div class="profile-session-section mt-4 pt-4">

                            <div class="mb-3">
                                <h4 class="mb-1">Session</h4>
                                <p class="profile-session-text mb-0">
                                    Sign out of ThriftHub on this device.
                                </p>
                            </div>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="profile-logout-form">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="profile-logout-button">
                                    Log Out
                                </button>

                            </form>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>

<style>
    .profile-session-section {
        border-top: 1px solid rgba(108, 61, 217, 0.12);
    }

    .profile-session-text {
        color: #777386;
        font-size: 14px;
    }

    .profile-logout-form {
        margin: 0;
    }

    .profile-logout-button {
        width: 100%;
        border: 1px solid rgba(220, 53, 69, 0.35);
        border-radius: 14px;
        background: #fff5f5;
        color: #c82333;
        font-size: 15px;
        font-weight: 700;
        padding: 12px 18px;
        cursor: pointer;
        transition: background 0.2s ease, border-color 0.2s ease;
    }

    .profile-logout-button:hover {
        background: #ffe8ea;
        border-color: rgba(220, 53, 69, 0.55);
    }

    @@media (min-width: 769px) {
        .profile-logout-button {
            width: auto;
            min-width: 180px;
        }
    }
</style>