@model ThriftHub.Models.ApplicationUser

@{
    ViewData["Title"] = "Seller Verification";

    var activeSubscription =
        ViewBag.ActiveSubscription
        as ThriftHub.Models.SellerSubscription;

    var hasActiveSubscription =
        ViewBag.HasActiveSubscription ?? false;
}


<div class="verification-page">

    <div class="verification-container">


        <!-- ============================================================
             HEADER
             ============================================================ -->

        <div class="page-header">

            <div>

                <div class="small-heading">
                    THRIFTHUB SELLER ACCOUNT
                </div>

                <h1>
                    Seller Verification
                </h1>

                <p>
                    Manage your seller application and verification status.
                </p>

            </div>


            <a asp-controller="Dashboard"
               asp-action="Index"
               class="dashboard-button">

                ← Back to Dashboard

            </a>

        </div>


        <!-- ============================================================
             SUCCESS MESSAGE
             ============================================================ -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert success-alert">

                <span class="alert-icon">
                    ✓
                </span>

                <span>
                    @TempData["SuccessMessage"]
                </span>

            </div>
        }


        <!-- ============================================================
             ERROR MESSAGE
             ============================================================ -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert error-alert">

                <span class="alert-icon">
                    !
                </span>

                <span>
                    @TempData["ErrorMessage"]
                </span>

            </div>
        }


        <!-- ============================================================
             APPROVED SELLER
             ============================================================ -->
        @if (
                    Model.IsVerified &&
                    string.Equals(
                        Model.VerificationStatus,
                        "Approved",
                        StringComparison.OrdinalIgnoreCase
                    )
                )
        {

            <div class="verification-card approved-card">


                <!-- ====================================================
                     APPROVED ICON
                     ==================================================== -->

                <div class="approved-icon">
                    ✓
                </div>


                <h2>
                    Seller Account Approved
                </h2>


                <p class="approved-text">
                    Congratulations! Your seller account has been
                    approved by ThriftHub.
                </p>


                <!-- ====================================================
                     ACTIVE SUBSCRIPTION
                     ==================================================== -->
                @if (
                                    hasActiveSubscription &&
                                    activeSubscription != null
                                )
                {

                    <div class="subscription-status subscribed">

                        <span class="subscription-icon">
                            ✓
                        </span>

                        <span>
                            Subscription Active
                        </span>

                    </div>


                    <!-- =================================================
                         SUBSCRIPTION DETAILS
                         ================================================= -->

                    <div class="subscription-details">

                        <h3>
                            Your Seller Subscription Is Active
                        </h3>


                        <div class="detail-row">

                            <span>
                                Plan
                            </span>

                            <strong>
                                @activeSubscription.PlanName
                            </strong>

                        </div>


                        <div class="detail-row">

                            <span>
                                Amount
                            </span>

                            <strong>
                                GH₵@activeSubscription.Amount.ToString("0.00")
                            </strong>

                        </div>


                        <div class="detail-row">

                            <span>
                                Duration
                            </span>

                            <strong>
                                @activeSubscription.DurationMonths months
                            </strong>

                        </div>


                        <div class="detail-row">

                            <span>
                                Started
                            </span>

                            <strong>
                                <strong>
                                    @(activeSubscription.StartDate.ToLocalTime().ToString("dd MMMM yyyy"))
                                </strong>
                            </strong>

                        </div>


                        <div class="detail-row">

                            <span>
                                Expires
                            </span>

                            <strong class="expiry-date">
                                @(activeSubscription.EndDate.ToLocalTime().ToString("dd MMMM yyyy"))
                            </strong>

                        </div>

                    </div>


                    <!-- =================================================
                         READY TO SELL
                         ================================================= -->

                    <div class="selling-message">

                        <strong>
                            ✓ You are ready to sell
                        </strong>

                        <p>
                            Your seller account is approved and your
                            subscription is active. You can now post
                            items for sale on ThriftHub.
                        </p>

                    </div>


                    <!-- =================================================
                         BUTTONS
                         ================================================= -->

                    <div class="action-buttons">

                        <a asp-controller="Dashboard"
                           asp-action="Index"
                           class="primary-button">

                            Go to Dashboard

                        </a>


                        <a asp-controller="Seller"
                           asp-action="Create"
                           class="secondary-button">

                            Post an Item

                        </a>

                    </div>

                }

                else
                {

                    <!-- =================================================
                         SUBSCRIPTION REQUIRED
                         ================================================= -->

                    <div class="subscription-status required">

                        <span class="subscription-icon">
                            !
                        </span>

                        <span>
                            Subscription Required
                        </span>

                    </div>


                    <div class="subscription-required-content">

                        <h3>
                            Activate your seller subscription
                        </h3>

                        <p>
                            Your seller account has been approved,
                            but you need an active subscription before
                            you can post items for sale.
                        </p>

                        <p>
                            You can still browse and buy items without
                            a subscription.
                        </p>


                        <div class="action-buttons">

                            <a asp-controller="Subscription"
                               asp-action="Index"
                               class="primary-button">

                                💳 Subscribe Now

                            </a>


                            <a asp-controller="Dashboard"
                               asp-action="Index"
                               class="secondary-button">

                                ← Back to Dashboard

                            </a>

                        </div>

                    </div>

                }

            </div>

        }

        else if (
            string.Equals(
                Model.VerificationStatus,
                "Verification Pending",
                StringComparison.OrdinalIgnoreCase
            )
        )
        {

            <!-- ========================================================
                 VERIFICATION PENDING
                 ======================================================== -->

            <div class="verification-card pending-card">

                <div class="pending-icon">
                    ⏳
                </div>


                <h2>
                    Verification Pending
                </h2>


                <p>
                    Your seller verification application has been
                    submitted and is currently being reviewed by
                    ThriftHub.
                </p>


                <div class="status-box">

                    Your application is under review.

                </div>


                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="secondary-button">

                    ← Back to Dashboard

                </a>

            </div>

        }

        else
        {

            <!-- ========================================================
                 NOT VERIFIED
                 ======================================================== -->

            <div class="verification-card not-approved-card">

                <div class="pending-icon">
                    !
                </div>


                <h2>
                    Seller Verification Required
                </h2>


                <p>
                    @if (ViewBag.NeedsIdentityDocuments == true)
                    {
                        @:To sell on ThriftHub, upload your government ID documents below. An administrator must verify your ID before your seller account can be approved.
                    }
                    else
                    {
                        @:Your seller application has been submitted. Please wait for administrator review.
                    }
                </p>

                @if (ViewBag.NeedsIdentityDocuments == true)
                {
                    <form asp-controller="Account"
                          asp-action="ApplyAsSeller"
                          method="post"
                          enctype="multipart/form-data"
                          class="seller-id-form">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label" for="IdCardType">
                                ID Type
                            </label>
                            <select class="form-select"
                                    id="IdCardType"
                                    name="IdCardType"
                                    required>
                                <option value="">Select ID type</option>
                                <option value="Ghana Card">Ghana Card</option>
                                <option value="Passport">Passport</option>
                                <option value="Driver's License">Driver's License</option>
                                <option value="Voter ID">Voter ID</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="IdCardNumber">
                                ID Number
                            </label>
                            <input class="form-control"
                                   id="IdCardNumber"
                                   name="IdCardNumber"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="IdCardFront">
                                ID Front (required)
                            </label>
                            <input class="form-control"
                                   type="file"
                                   id="IdCardFront"
                                   name="IdCardFront"
                                   accept=".jpg,.jpeg,.png,.webp,.pdf"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="IdCardBack">
                                ID Back (optional)
                            </label>
                            <input class="form-control"
                                   type="file"
                                   id="IdCardBack"
                                   name="IdCardBack"
                                   accept=".jpg,.jpeg,.png,.webp,.pdf" />
                        </div>

                        <button type="submit"
                                class="primary-button">
                            Submit Seller Application
                        </button>

                    </form>
                }
                else
                {
                    <form asp-controller="Account"
                          asp-action="SellerVerificationSubmit"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="primary-button">

                            Submit Seller Verification

                        </button>

                    </form>
                }


                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="secondary-button">

                    ← Back to Dashboard

                </a>

            </div>

        }


    </div>

</div>


<style>

    /* ============================================================
           PAGE
           ============================================================ */

    .verification-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 45px 25px 70px;
        font-family: Arial, Helvetica, sans-serif;
    }


    .verification-container {
        width: 100%;
    }


    /* ============================================================
           HEADER
           ============================================================ */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 25px;
        margin-bottom: 30px;
    }


    .small-heading {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.5px;
        color: #777;
        margin-bottom: 8px;
    }


    .page-header h1 {
        margin: 0;
        font-size: 34px;
        font-weight: 700;
        color: #252525;
    }


    .page-header p {
        margin: 8px 0 0;
        color: #777;
        font-size: 14px;
    }


    /* ============================================================
           DASHBOARD BUTTON
           ============================================================ */

    .dashboard-button {
        display: inline-block;
        background: #6c3df4;
        color: #fff;
        text-decoration: none;
        padding: 11px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }


        .dashboard-button:hover {
            background: #5830d4;
            color: #fff;
        }


    /* ============================================================
           ALERTS
           ============================================================ */

    .alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 18px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
    }


    .success-alert {
        background: #e9f9ef;
        color: #16803c;
        border: 1px solid #c7efd5;
    }


    .error-alert {
        background: #fff0f0;
        color: #b42318;
        border: 1px solid #f4c7c7;
    }


    .alert-icon {
        font-weight: bold;
    }


    /* ============================================================
           MAIN CARD
           ============================================================ */

    .verification-card {
        max-width: 700px;
        margin: 0 auto;
        padding: 35px;
        background: #fff;
        border-radius: 14px;
        text-align: center;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.05);
    }


    .approved-card {
        border-top: 4px solid #22c55e;
    }


    .pending-card {
        border-top: 4px solid #f59e0b;
    }


    .not-approved-card {
        border-top: 4px solid #6c3df4;
    }


    /* ============================================================
           APPROVED ICON
           ============================================================ */

    .approved-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: #e9f9ef;
        color: #22c55e;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        font-weight: 700;
    }


    .verification-card h2 {
        margin: 0 0 10px;
        color: #333;
        font-size: 24px;
    }


    .approved-text {
        color: #777;
        font-size: 13px;
        margin-bottom: 25px;
    }


    /* ============================================================
           SUBSCRIPTION STATUS
           ============================================================ */

    .subscription-status {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 9px;
        padding: 12px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        margin: 20px auto;
        max-width: 400px;
    }


        .subscription-status.subscribed {
            background: #e9f9ef;
            color: #16803c;
            border: 1px solid #c7efd5;
        }


        .subscription-status.required {
            background: #fff8df;
            color: #9a6700;
            border: 1px solid #f2df9a;
        }


    .subscription-icon {
        font-weight: 700;
    }


    /* ============================================================
           SUBSCRIPTION DETAILS
           ============================================================ */

    .subscription-details {
        text-align: left;
        margin: 25px auto;
        padding: 20px;
        max-width: 520px;
        background: #f8fff9;
        border: 1px solid #d9f0df;
        border-radius: 10px;
    }


        .subscription-details h3 {
            margin: 0 0 15px;
            text-align: center;
            color: #16803c;
            font-size: 17px;
        }


    .detail-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 10px 0;
        border-bottom: 1px solid #e7f1e9;
        font-size: 13px;
    }


        .detail-row:last-child {
            border-bottom: none;
        }


        .detail-row span {
            color: #777;
        }


        .detail-row strong {
            color: #333;
        }


    .expiry-date {
        color: #16803c !important;
    }


    /* ============================================================
           SELLING MESSAGE
           ============================================================ */

    .selling-message {
        max-width: 520px;
        margin: 20px auto;
        padding: 15px;
        background: #f5f5ff;
        border-radius: 9px;
        text-align: left;
    }


        .selling-message strong {
            color: #16803c;
            font-size: 14px;
        }


        .selling-message p {
            margin: 7px 0 0;
            color: #666;
            font-size: 12px;
            line-height: 1.6;
        }


    /* ============================================================
           REQUIRED CONTENT
           ============================================================ */

    .subscription-required-content {
        max-width: 520px;
        margin: 20px auto;
        text-align: left;
    }


        .subscription-required-content h3 {
            font-size: 16px;
            color: #333;
        }


        .subscription-required-content p {
            color: #777;
            font-size: 13px;
            line-height: 1.6;
        }


    /* ============================================================
           BUTTONS
           ============================================================ */

    .action-buttons {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 25px;
    }


    .primary-button {
        display: inline-block;
        border: none;
        background: #6c3df4;
        color: #fff;
        text-decoration: none;
        padding: 12px 20px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        text-align: center;
    }


        .primary-button:hover {
            background: #5830d4;
            color: #fff;
        }


    .secondary-button {
        display: inline-block;
        background: #fff;
        color: #555;
        text-decoration: none;
        border: 1px solid #ddd;
        padding: 11px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        text-align: center;
    }


        .secondary-button:hover {
            background: #f7f7f7;
            color: #333;
        }


    /* ============================================================
           PENDING ICON
           ============================================================ */

    .pending-icon {
        width: 60px;
        height: 60px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: #fff8df;
        color: #d38b00;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
        font-weight: 700;
    }


    /* ============================================================
           STATUS BOX
           ============================================================ */

    .status-box {
        margin: 25px auto;
        padding: 14px;
        max-width: 450px;
        background: #fff8df;
        color: #8a6500;
        border-radius: 8px;
        font-size: 13px;
    }


    /* ============================================================
           MOBILE
           ============================================================ */

    @@media (max-width: 650px) {

        .verification-page {
            padding: 25px 15px 50px;
        }


        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }


            .page-header h1 {
                font-size: 27px;
            }


        .dashboard-button {
            width: 100%;
            text-align: center;
        }


        .verification-card {
            padding: 25px 18px;
        }


        .detail-row {
            flex-direction: column;
            gap: 4px;
        }


        .action-buttons {
            flex-direction: column;
        }


        .primary-button,
        .secondary-button {
            width: 100%;
        }
    }

</style>