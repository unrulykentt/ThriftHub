@{
    ViewData["Title"] = "Access Denied";
}

<div style="
    max-width:700px;
    margin:100px auto;
    padding:50px 30px;
    text-align:center;
    background:white;
    border-radius:16px;
    box-shadow:0 10px 35px rgba(0,0,0,.08);
    ">

    <div style="font-size:60px;">
        🔒
    </div>

    <h1 style="
        color:#252238;
        font-weight:800;
        margin-top:20px;
        ">
        Access Denied
    </h1>

    <p style="
        color:#777386;
        margin-top:12px;
        ">
        You do not have permission to access this page.
    </p>

    <a asp-controller="Dashboard"
       asp-action="Index"
       style="
        display:inline-block;
        margin-top:25px;
        padding:12px 22px;
        background:#6f3cc3;
        color:white;
        text-decoration:none;
        border-radius:10px;
        font-weight:700;
        ">
        Back to Dashboard
    </a>

</div>