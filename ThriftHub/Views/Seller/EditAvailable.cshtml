@model ThriftHub.Models.Product

@{
    ViewData["Title"] = "Make Product Available";

    var product = Model;
}

<div class="edit-available-page">

    <!-- ============================================================
         BACK
         ============================================================ -->

    <div class="back-row">
        <a asp-controller="Seller"
           asp-action="MyProducts"
           class="back-link">

            ← Back to My Products

        </a>
    </div>


    <!-- ============================================================
         SUCCESS MESSAGE
         ============================================================ -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-box success">

            <span class="alert-icon">✓</span>

            <span>
                @TempData["SuccessMessage"]
            </span>

        </div>
    }


    <!-- ============================================================
         ERROR MESSAGE
         ============================================================ -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-box error">

            <span class="alert-icon">!</span>

            <span>
                @TempData["ErrorMessage"]
            </span>

        </div>
    }


    <!-- ============================================================
         PAGE HEADER
         ============================================================ -->

    <div class="page-header">

        <div class="header-icon">
            ↻
        </div>

        <div>

            <h1>
                Make Product Available
            </h1>

            <p>
                Update the product information before putting this
                item back on sale.
            </p>

        </div>

    </div>


    <!-- ============================================================
         PRODUCT CARD
         ============================================================ -->

    <div class="product-layout">


        <!-- ========================================================
             PRODUCT IMAGE
             ======================================================== -->

        <div class="product-image-card">

            @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
            {
                <img src="@product.ImageUrl"
                     alt="@product.Name"
                     class="product-image" />
            }
            else
            {
                <div class="no-image">

                    <div class="no-image-icon">
                        🛍️
                    </div>

                    <span>
                        No image available
                    </span>

                </div>
            }

            <div class="sold-badge">
                SOLD
            </div>

        </div>


        <!-- ========================================================
             EDIT FORM
             ======================================================== -->

        <div class="edit-card">

            <div class="edit-card-header">

                <h2>
                    Edit Product
                </h2>

                <p>
                    You can change the price and available sizes
                    before making the product available again.
                </p>

            </div>


            <form asp-controller="Seller"
                  asp-action="EditAvailable"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- ==================================================
                     PRODUCT ID
                     ================================================== -->

                <input type="hidden"
                       asp-for="Id" />


                <!-- ==================================================
                     PRODUCT NAME
                     ================================================== -->

                <div class="form-group">

                    <label asp-for="Name">
                        Product Name
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           readonly />

                    <span asp-validation-for="Name"
                          class="validation-error">
                    </span>

                </div>


                <!-- ==================================================
                     DESCRIPTION
                     ================================================== -->

                <div class="form-group">

                    <label asp-for="Description">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control description-box"
                              rows="4"></textarea>

                    <span asp-validation-for="Description"
                          class="validation-error">
                    </span>

                </div>


                <!-- ==================================================
                     PRICE
                     ================================================== -->

                <div class="form-group">

                    <label asp-for="Price">
                        Price
                    </label>

                    <div class="price-input-wrapper">

                        <span class="currency">
                            GH₵
                        </span>

                        <input asp-for="Price"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control price-input"
                               required />

                    </div>

                    <span asp-validation-for="Price"
                          class="validation-error">
                    </span>

                    <small class="form-help">
                        You can change the selling price before making
                        the item available again.
                    </small>

                </div>


                <!-- ==================================================
                     CATEGORY
                     ================================================== -->

                <div class="form-group">

                    <label asp-for="Category">
                        Category
                    </label>

                    <input asp-for="Category"
                           class="form-control"
                           readonly />

                    <span asp-validation-for="Category"
                          class="validation-error">
                    </span>

                </div>


                <!-- ==================================================
                     SUBCATEGORY
                     ================================================== -->

                <div class="form-group">

                    <label asp-for="Subcategory">
                        Subcategory
                    </label>

                    <input asp-for="Subcategory"
                           class="form-control" />

                    <span asp-validation-for="Subcategory"
                          class="validation-error">
                    </span>

                </div>


                <!-- ==================================================
                     CONDITION
                     ================================================== -->

                <div class="form-group">

                    <label asp-for="Condition">
                        Condition
                    </label>

                    <input asp-for="Condition"
                           class="form-control" />

                    <span asp-validation-for="Condition"
                          class="validation-error">
                    </span>

                </div>


                <!-- ==================================================
                     SIZES
                     ================================================== -->

                <div class="form-group">

                    <label asp-for="Sizes">
                        Available Size(s)
                    </label>

                    <input asp-for="Sizes"
                           type="text"
                           id="sizes"
                           name="Sizes"
                           class="form-control"
                           placeholder="Example: S, M, L, XL"
                           required />

                    <span asp-validation-for="Sizes"
                          class="validation-error">
                    </span>

                    <small class="form-help">

                        Separate multiple sizes with commas.

                        <br />

                        Example:
                        <strong>S, M, L, XL</strong>

                        <br />

                        For shoes:
                        <strong>38, 39, 40, 41, 42</strong>

                    </small>

                </div>


                <!-- ==================================================
                     IMPORTANT INFORMATION
                     ================================================== -->

                <div class="information-box">

                    <div class="information-icon">
                        ℹ️
                    </div>

                    <div>

                        <strong>
                            Before making this item available
                        </strong>

                        <p>
                            Check the price and available sizes carefully.
                            The updated information will be shown to
                            customers when the product becomes available.
                        </p>

                    </div>

                </div>


                <!-- ==================================================
                     BUTTONS
                     ================================================== -->

                <div class="button-group">

                    <a asp-controller="Seller"
                       asp-action="MyProducts"
                       class="cancel-button">

                        Cancel

                    </a>


                    <button type="submit"
                            class="available-button"
                            onclick="return confirm('Are you sure you want to update this product and make it available again?');">

                        ↻ Update & Make Available

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- ================================================================
     VALIDATION
     ================================================================ -->
@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}


<!-- ================================================================
     STYLING
     ================================================================ -->

<style>

    /* ============================================================
           PAGE
           ============================================================ */

    .edit-available-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 24px 70px;
        font-family: Arial, Helvetica, sans-serif;
        color: #252238;
    }


    /* ============================================================
           BACK
           ============================================================ */

    .back-row {
        margin-bottom: 25px;
    }


    .back-link {
        color: #6f3cc3;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
    }


        .back-link:hover {
            color: #54249c;
            text-decoration: underline;
        }


    /* ============================================================
           ALERTS
           ============================================================ */

    .alert-box {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px;
        border-radius: 10px;
        margin-bottom: 22px;
        font-size: 13px;
        font-weight: 600;
    }


        .alert-box.success {
            background: #eaf8ef;
            border: 1px solid #bce3c8;
            color: #176b35;
        }


        .alert-box.error {
            background: #fff1f1;
            border: 1px solid #f0c4c4;
            color: #9b1c1c;
        }


    .alert-icon {
        font-weight: 900;
        font-size: 16px;
    }


    /* ============================================================
           HEADER
           ============================================================ */

    .page-header {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 30px;
    }


    .header-icon {
        width: 55px;
        height: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #f1e9ff;
        color: #6f3cc3;
        font-size: 27px;
        font-weight: 900;
        flex-shrink: 0;
    }


    .page-header h1 {
        margin: 0 0 6px;
        font-size: 30px;
        font-weight: 800;
    }


    .page-header p {
        margin: 0;
        color: #777386;
        font-size: 14px;
        line-height: 1.5;
    }


    /* ============================================================
           LAYOUT
           ============================================================ */

    .product-layout {
        display: grid;
        grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
        gap: 35px;
        align-items: start;
    }


    /* ============================================================
           IMAGE CARD
           ============================================================ */

    .product-image-card {
        position: relative;
        background: #fff;
        border: 1px solid #eee9f5;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 6px 25px rgba(60, 40, 90, 0.06);
    }


    .product-image {
        width: 100%;
        height: 520px;
        display: block;
        object-fit: cover;
    }


    /* ============================================================
           NO IMAGE
           ============================================================ */

    .no-image {
        height: 520px;
        background: #f5f1fa;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #999;
        font-size: 13px;
    }


    .no-image-icon {
        font-size: 65px;
        margin-bottom: 12px;
    }


    /* ============================================================
           SOLD BADGE
           ============================================================ */

    .sold-badge {
        position: absolute;
        top: 15px;
        right: 15px;
        padding: 8px 13px;
        border-radius: 20px;
        background: #dc3545;
        color: white;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: .05em;
        box-shadow: 0 3px 10px rgba(0, 0, 0, .12);
    }


    /* ============================================================
           EDIT CARD
           ============================================================ */

    .edit-card {
        background: #fff;
        border: 1px solid #eee9f5;
        border-radius: 18px;
        padding: 28px;
        box-shadow: 0 6px 25px rgba(60, 40, 90, 0.06);
    }


    .edit-card-header {
        margin-bottom: 25px;
        padding-bottom: 20px;
        border-bottom: 1px solid #eee9f5;
    }


        .edit-card-header h2 {
            margin: 0 0 7px;
            font-size: 21px;
            font-weight: 800;
            color: #252238;
        }


        .edit-card-header p {
            margin: 0;
            color: #777386;
            font-size: 12px;
            line-height: 1.6;
        }


    /* ============================================================
           FORM
           ============================================================ */

    .form-group {
        margin-bottom: 20px;
    }


        .form-group label {
            display: block;
            margin-bottom: 7px;
            color: #302b3d;
            font-size: 13px;
            font-weight: 800;
        }


    .form-control {
        width: 100%;
        box-sizing: border-box;
        padding: 11px 13px;
        border: 1px solid #ddd8e5;
        border-radius: 9px;
        background: #fff;
        color: #252238;
        font-size: 13px;
        outline: none;
        transition: .2s ease;
    }


        .form-control:focus {
            border-color: #6f3cc3;
            box-shadow: 0 0 0 3px rgba(111, 60, 195, .10);
        }


        .form-control[readonly] {
            background: #f7f6f9;
            color: #777386;
            cursor: not-allowed;
        }


    .description-box {
        resize: vertical;
        min-height: 100px;
        line-height: 1.6;
    }


    /* ============================================================
           PRICE
           ============================================================ */

    .price-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }


    .currency {
        position: absolute;
        left: 13px;
        color: #6f3cc3;
        font-size: 13px;
        font-weight: 800;
        z-index: 2;
    }


    .price-input {
        padding-left: 48px;
    }


    /* ============================================================
           HELP TEXT
           ============================================================ */

    .form-help {
        display: block;
        margin-top: 7px;
        color: #8a8493;
        font-size: 11px;
        line-height: 1.6;
    }


    /* ============================================================
           VALIDATION
           ============================================================ */

    .validation-error {
        display: block;
        margin-top: 5px;
        color: #dc3545;
        font-size: 11px;
    }


    /* ============================================================
           INFORMATION BOX
           ============================================================ */

    .information-box {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 15px;
        margin-top: 25px;
        margin-bottom: 25px;
        background: #f8f5ff;
        border: 1px solid #ddd0ff;
        border-radius: 12px;
    }


    .information-icon {
        font-size: 20px;
        flex-shrink: 0;
    }


    .information-box strong {
        display: block;
        margin-bottom: 5px;
        color: #4f35a8;
        font-size: 13px;
    }


    .information-box p {
        margin: 0;
        color: #777386;
        font-size: 11px;
        line-height: 1.6;
    }


    /* ============================================================
           BUTTONS
           ============================================================ */

    .button-group {
        display: flex;
        gap: 10px;
    }


    .cancel-button {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 12px 15px;
        border: 1px solid #ddd8e5;
        border-radius: 9px;
        background: #fff;
        color: #555;
        text-decoration: none;
        font-size: 12px;
        font-weight: 800;
        transition: .2s ease;
    }


        .cancel-button:hover {
            background: #f7f6f9;
            color: #333;
            text-decoration: none;
        }


    .available-button {
        flex: 2;
        padding: 12px 15px;
        border: none;
        border-radius: 9px;
        background: #198754;
        color: #fff;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
        transition: .2s ease;
    }


        .available-button:hover {
            background: #146c43;
        }


    /* ============================================================
           TABLET
           ============================================================ */

    @@media (max-width: 900px) {

        .product-layout {
            grid-template-columns: 1fr;
        }


        .product-image {
            height: 450px;
        }


        .no-image {
            height: 450px;
        }
    }


    /* ============================================================
           MOBILE
           ============================================================ */

    @@media (max-width: 600px) {

        .edit-available-page {
            padding: 25px 14px 50px;
        }


        .page-header {
            align-items: flex-start;
        }


            .page-header h1 {
                font-size: 24px;
            }


            .page-header p {
                font-size: 12px;
            }


        .header-icon {
            width: 45px;
            height: 45px;
            font-size: 22px;
        }


        .edit-card {
            padding: 20px 16px;
        }


        .product-image {
            height: 380px;
        }


        .no-image {
            height: 380px;
        }


        .button-group {
            flex-direction: column;
        }


        .cancel-button,
        .available-button {
            flex: none;
            width: 100%;
        }
    }

</style>