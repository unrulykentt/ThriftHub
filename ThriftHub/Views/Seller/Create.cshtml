                "XXL",
                "XXXL"
            ],

            Kids: [
                "0-3M",
                "3-6M",
                "6-12M",
                "1-2T",
                "2-3T",
                "3-4T",
                "4-5T",
                "5-6T",
                "6-7Y",
                "8-9Y",
                "10-11Y",
                "12-13Y",
                "14-15Y"
            ],

            Shoes: [
                "36",
                "37",
                "38",
                "39",
                "40",
                "41",
                "42",
                "43",
