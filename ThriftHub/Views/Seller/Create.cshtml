                "47"
            ],

            Bags: [
                "One Size"
            ],

            Accessories: [
                "One Size"
            ],

            "Backpacks & School Bags": [
                "Small",
                "Medium",
                "Large",
                "One Size"
            ],

            "Hostel Essentials": [
                "Small",
                "Medium",
                "Large",
                "One Size"
            ],

            "Sports & Fitness": [
                "XS",
                "S",
                "M",
                "L",
                "XL",
                "XXL",
                "One Size"
            ]

        };


        // ============================================================
        // ELEMENTS
        // ============================================================

        const categorySelect =
            document.getElementById("categorySelect");

        const subcategorySelect =
            document.getElementById("subcategorySelect");

        const sizeOptionsContainer =
            document.getElementById("sizeOptions");

        const selectedSizesInput =
            document.getElementById("selectedSizes");

        const selectedSizeDisplay =
            document.getElementById("selectedSizeDisplay");

        const selectedSizeTags =
            document.getElementById("selectedSizeTags");

        const customSizeInput =
            document.getElementById("customSize");

        const addCustomSizeButton =
            document.getElementById("addCustomSize");


        // ============================================================
        // SELECTED SIZES
        // ============================================================

        let selectedSizes = [];


        // ============================================================
        // LOAD EXISTING SIZES
        // ============================================================

        if (selectedSizesInput.value) {

            selectedSizes =
                selectedSizesInput.value
                    .split(",")
                    .map(size => size.trim())
                    .filter(size => size !== "");

        }


        // ============================================================
        // UPDATE HIDDEN SIZE FIELD
        // ============================================================

        function updateHiddenSizes() {

            selectedSizesInput.value =
                selectedSizes.join(",");

        }


        // ============================================================
        // DISPLAY SELECTED SIZE TAGS
        // ============================================================

        function displaySelectedSizes() {

            selectedSizeTags.innerHTML = "";


            if (selectedSizes.length === 0) {

                selectedSizeDisplay.style.display =
                    "none";

                return;

            }


            selectedSizeDisplay.style.display =
                "block";


            selectedSizes.forEach(function(size) {

                const tag =
                    document.createElement("span");

                tag.className =
                    "selected-size-tag";


                const text =
                    document.createElement("span");

                text.textContent =
                    size;


                const removeButton =
                    document.createElement("button");

                removeButton.type =
                    "button";

                removeButton.className =
                    "remove-size";

                removeButton.innerHTML =
                    "×";

                removeButton.title =
                    "Remove size";


                removeButton.addEventListener(
                    "click",
                    function() {

                        selectedSizes =
                            selectedSizes.filter(
                                s => s !== size
                            );

                        updateHiddenSizes();

                        displaySelectedSizes();

                        updateCheckboxes();

                    }
                );


                tag.appendChild(text);

                tag.appendChild(removeButton);

                selectedSizeTags.appendChild(tag);

            });

        }


        // ============================================================
        // UPDATE CHECKBOXES
        // ============================================================

        function updateCheckboxes() {

            const checkboxes =
                sizeOptionsContainer.querySelectorAll(
                    "input[type='checkbox']"
                );


            checkboxes.forEach(function(checkbox) {

                checkbox.checked =
                    selectedSizes.includes(
                        checkbox.value
                    );

            });

        }


        // ============================================================
        // RENDER SIZE OPTIONS
        // ============================================================

        function renderSizeOptions() {

            const category =
                categorySelect.value;


            sizeOptionsContainer.innerHTML =
                "";


            if (!category ||
                !sizeOptions[category]) {

                sizeOptionsContainer.innerHTML =
                    '<div class="text-muted small">' +
                    'This product does not require a size.' +
                    '</div>';

                return;

            }


            const sizes =
                sizeOptions[category];


            sizes.forEach(function(size, index) {

                const wrapper =
                    document.createElement("div");

                wrapper.className =
                    "size-option";


                const checkbox =
                    document.createElement("input");

                checkbox.type =
                    "checkbox";

                checkbox.id =
                    "size_" + index;

                checkbox.value =
                    size;


                const label =
                    document.createElement("label");

                label.htmlFor =
                    checkbox.id;

                label.textContent =
                    size;


                checkbox.addEventListener(
                    "change",
                    function() {

                        if (checkbox.checked) {

                            if (!selectedSizes.includes(size)) {

                                selectedSizes.push(size);

                            }

                        }
                        else {

                            selectedSizes =
                                selectedSizes.filter(
                                    s => s !== size
                                );

                        }


                        updateHiddenSizes();

                        displaySelectedSizes();

                    }
                );


                wrapper.appendChild(checkbox);

                wrapper.appendChild(label);

                sizeOptionsContainer.appendChild(wrapper);

            });


            updateCheckboxes();

        }


        // ============================================================
        // RENDER SUBCATEGORIES
        // ============================================================

        function renderSubcategories() {

            const category =
                categorySelect.value;


            subcategorySelect.innerHTML =
                '<option value="">Select a subcategory</option>';


            if (!category ||
                !subcategories[category]) {

                return;

            }


            subcategories[category].forEach(
                function(subcategory) {

                    const option =
                        document.createElement("option");

                    option.value =
                        subcategory;

                    option.textContent =
                        subcategory;

                    subcategorySelect.appendChild(
                        option
                    );

                }
            );

        }


        // ============================================================
        // CATEGORY CHANGED
        // ============================================================

        categorySelect.addEventListener(
            "change",
            function() {

                selectedSizes = [];

                updateHiddenSizes();

                displaySelectedSizes();

                renderSubcategories();

                renderSizeOptions();

            }
        );


        // ============================================================
        // ADD CUSTOM SIZE
        // ============================================================

        addCustomSizeButton.addEventListener(
            "click",
            function() {

                const customSize =
                    customSizeInput.value.trim();


                if (!customSize) {

                    return;

                }


                if (!selectedSizes.includes(customSize)) {

                    selectedSizes.push(customSize);

                }


                customSizeInput.value =
                    "";


                updateHiddenSizes();

                displaySelectedSizes();

                updateCheckboxes();

            }
        );


        // ============================================================
        // ENTER KEY FOR CUSTOM SIZE
        // ============================================================

        customSizeInput.addEventListener(
            "keydown",
            function(event) {

                if (event.key === "Enter") {

                    event.preventDefault();

                    addCustomSizeButton.click();

                }

            }
        );


        // ============================================================
        // INITIALIZE
        // ============================================================

        renderSubcategories();

        renderSizeOptions();

        displaySelectedSizes();


        // ============================================================
        // IMAGE PREVIEW
        // ============================================================

        document
            .getElementById("productImage")
            .addEventListener(
                "change",
                function(event) {

                    const file =
                        event.target.files[0];


                    const preview =
                        document.getElementById(
                            "imagePreview"
                        );


                    if (file) {

                        const reader =
                            new FileReader();


                        reader.onload =
                            function(e) {

                                preview.src =
                                    e.target.result;

                                preview.style.display =
                                    "inline-block";

                            };


                        reader.readAsDataURL(file);

                    }
                    else {

                        preview.style.display =
                            "none";

                    }

                }
            );

    </script>
}