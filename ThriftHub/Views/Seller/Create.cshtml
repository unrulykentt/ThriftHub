        };


        // ============================================================
        // SIZE OPTIONS
        // ============================================================

        const sizeOptions = {

            "Women's Fashion": [
                "XS",
                "S",
                "M",
                "L",
                "XL",
                "XXL",
                "XXXL"
            ],

            "Men's Fashion": [
                "XS",
                "S",
                "M",
                "L",
