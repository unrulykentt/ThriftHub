@model ThriftHub.ViewModels.SellerProfileViewModel

@{
    ViewData["Title"] = "Seller Profile";

    var seller = Model.Seller;

    var sellerName =
        seller?.UserName ?? "Seller";

    var sellerEmail =
        seller?.Email ?? "";

    var currentUserId =
        User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier
        )?.Value;

    var isOwnProfile =
        User.Identity?.IsAuthenticated == true &&
        seller != null &&
        seller.Id == currentUserId;
}

<style>

    /* =========================================================
           PAGE
           ========================================================= */

    .seller-profile-page {
        max-width: 1150px;
        margin: 0 auto;
        padding: 40px 20px 70px;
    }


    /* =========================================================
           BACK LINK
           ========================================================= */

    .profile-back {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 25px;
        color: #6f3cc3;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
    }

        .profile-back:hover {
            color: #54249c;
        }


    /* =========================================================
           PROFILE HEADER
           ========================================================= */

    .profile-header {
        background: white;
        border: 1px solid #eee9f5;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 8px 28px rgba(70,40,110,.08);
        margin-bottom: 35px;
    }


    .profile-header-content {
        display: flex;
        align-items: center;
        gap: 25px;
    }


    /* =========================================================
           PROFILE IMAGE
           ========================================================= */

    .profile-image-wrapper {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        overflow: hidden;
        background: #f1e9ff;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 4px solid #f1e9ff;
    }

    .profile-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .profile-placeholder {
        font-size: 42px;
        color: #6f3cc3;
    }


    /* =========================================================
           PROFILE INFORMATION
           ========================================================= */

    .profile-information {
        flex: 1;
        min-width: 0;
    }

    .profile-name {
        margin: 0 0 7px;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 30px;
        color: #252238;
        word-break: break-word;
    }

    .profile-email {
        margin: 0 0 12px;
        color: #777386;
        font-size: 14px;
        word-break: break-word;
    }


    /* =========================================================
           SELLER BADGES
           ========================================================= */

    .seller-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .seller-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 11px;
        border-radius: 20px;
        background: #f1e9ff;
        color: #6f3cc3;
        font-size: 11px;
        font-weight: 800;
    }

    .verified-badge {
        background: #eaf8ef;
        color: #198754;
    }


    /* =========================================================
           PROFILE ACTIONS
           ========================================================= */

    .profile-actions {
        display: flex;
        flex-direction: column;
        gap: 9px;
        min-width: 190px;
    }

    .profile-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        padding: 11px 15px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 800;
        border: none;
        cursor: pointer;
    }

    .message-button {
        background: #6f3cc3;
        color: white;
    }

        .message-button:hover {
            background: #54249c;
            color: white;
        }

    .block-button {
        background: white;
        color: #dc3545;
        border: 1px solid #f0c4c8;
    }

        .block-button:hover {
            background: #fff1f1;
        }

    .report-button {
        background: white;
        color: #9a6700;
        border: 1px solid #ead9a6;
    }

        .report-button:hover {
            background: #fffaf0;
        }


    /* =========================================================
           STATISTICS
           ========================================================= */

    .profile-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-top: 25px;
        padding-top: 25px;
        border-top: 1px solid #eee9f5;
    }

    .profile-stat {
        text-align: center;
        padding: 15px;
        background: #faf9fc;
        border-radius: 12px;
    }

    .profile-stat-number {
        display: block;
        font-size: 22px;
        font-weight: 900;
        color: #252238;
    }

    .profile-stat-label {
        display: block;
        margin-top: 4px;
        color: #777386;
        font-size: 11px;
    }


    /* =========================================================
           PRODUCTS HEADER
           ========================================================= */

    .products-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .products-title {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 28px;
        color: #252238;
    }

    .products-subtitle {
        margin: 5px 0 0;
        color: #777386;
        font-size: 13px;
    }


    /* =========================================================
           PRODUCT GRID
           ========================================================= */

    .seller-products-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
    }


    /* =========================================================
           PRODUCT CARD
           ========================================================= */

    .seller-product-card {
        background: white;
        border: 1px solid #eee9f5;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(60,40,90,.05);
        transition: .25s ease;
    }

        .seller-product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 35px rgba(70,40,110,.14);
        }


    /* =========================================================
           PRODUCT IMAGE
           ========================================================= */

    .seller-product-image {
        height: 230px;
        background: #f5f1fa;
        overflow: hidden;
    }

        .seller-product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .3s ease;
        }

    .seller-product-card:hover .seller-product-image img {
        transform: scale(1.04);
    }

    .no-product-image {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        color: #aaa3b4;
        font-size: 12px;
    }

    .no-product-image-icon {
        font-size: 38px;
        margin-bottom: 8px;
    }


    /* =========================================================
           PRODUCT BODY
           ========================================================= */

    .seller-product-body {
        padding: 15px;
    }

    .seller-product-name {
        margin: 0 0 7px;
        font-size: 15px;
        font-weight: 800;
        color: #252238;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .seller-product-description {
        height: 36px;
        margin-bottom: 12px;
        color: #777386;
        font-size: 11px;
        line-height: 1.5;
        overflow: hidden;
    }

    .seller-product-price {
        margin-bottom: 12px;
        color: #252238;
        font-size: 17px;
        font-weight: 900;
    }

    .view-product-button {
        display: block;
        width: 100%;
        padding: 10px;
        background: #6f3cc3;
        color: white;
        text-align: center;
        text-decoration: none;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 800;
    }

        .view-product-button:hover {
            background: #54249c;
            color: white;
        }


    /* =========================================================
           EMPTY PRODUCTS
           ========================================================= */

    .empty-products {
        background: white;
        border: 1px dashed #ddd5e8;
        border-radius: 16px;
        padding: 50px 20px;
        text-align: center;
    }

    .empty-products-icon {
        font-size: 45px;
        margin-bottom: 10px;
    }

    .empty-products h3 {
        margin: 0 0 7px;
        font-size: 18px;
        color: #252238;
    }

    .empty-products p {
        margin: 0;
        color: #777386;
        font-size: 13px;
    }


    /* =========================================================
           MOBILE
           ========================================================= */

    @@media (max-width: 1000px) {

        .seller-products-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }


    @@media (max-width: 750px) {

        .profile-header-content {
            flex-direction: column;
            text-align: center;
        }

        .profile-information {
            width: 100%;
        }

        .seller-badges {
            justify-content: center;
        }

        .profile-actions {
            width: 100%;
            min-width: 0;
        }

        .seller-products-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }


    @@media (max-width: 500px) {

        .seller-profile-page {
            padding: 25px 13px 50px;
        }

        .profile-header {
            padding: 20px;
        }

        .profile-name {
            font-size: 25px;
        }

        .profile-stats {
            grid-template-columns: 1fr;
        }

        .seller-products-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .seller-product-image {
            height: 180px;
        }

        .seller-product-body {
            padding: 10px;
        }

        .seller-product-name {
            font-size: 13px;
        }

        .seller-product-price {
            font-size: 14px;
        }
    }

</style>


<div class="seller-profile-page">


    <!-- =========================================================
         BACK TO MARKETPLACE
         ========================================================= -->

    <a asp-controller="MarketPlace"
       asp-action="Index"
       class="profile-back">

        ← Back to Marketplace

    </a>


    <!-- =========================================================
         PROFILE HEADER
         ========================================================= -->

    <div class="profile-header">

        <div class="profile-header-content">


            <!-- =====================================================
                 PROFILE IMAGE
                 ===================================================== -->

            <div class="profile-image-wrapper">

                @if (seller != null &&
                     !string.IsNullOrWhiteSpace(
                         seller.ProfileImageUrl))
                {
                    <img src="@seller.ProfileImageUrl"
                         alt="@sellerName"
                         class="profile-image" />
                }
                else
                {
                    <div class="profile-placeholder">
                        👤
                    </div>
                }

            </div>


            <!-- =====================================================
                 SELLER INFORMATION
                 ===================================================== -->

            <div class="profile-information">

                <h1 class="profile-name">

                    @sellerName

                </h1>


                @if (!string.IsNullOrWhiteSpace(sellerEmail))
                {
                    <p class="profile-email">

                        @sellerEmail

                    </p>
                }


                <div class="seller-badges">

                    <span class="seller-badge">

                        🛍️ Seller

                    </span>


                    @if (seller != null && seller.IsVerified)
                    {
                        <span class="seller-badge verified-badge">

                            ✓ Verified Seller

                        </span>
                    }

                </div>

            </div>


            <!-- =====================================================
                 ACTIONS
                 ===================================================== -->
            @if (seller != null && !isOwnProfile)
            {
                <div class="profile-actions">


                    <!-- MESSAGE SELLER -->

                    <a asp-controller="Messages"
                       asp-action="Chat"
                       asp-route-sellerId="@seller.Id"
                       class="profile-action message-button">

                        💬 Message Seller

                    </a>


                    <!-- BLOCK SELLER -->

                    <form asp-controller="Safety"
                          asp-action="BlockUser"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="userId"
                               value="@seller.Id" />

                        <button type="submit"
                                class="profile-action block-button"
                                onclick="return confirm('Are you sure you want to block this seller? You will no longer be able to interact with this user.');">

                            🚫 Block Seller

                        </button>

                    </form>


                    <!-- REPORT SELLER -->

                    <a asp-controller="Safety"
                       asp-action="ReportUser"
                       asp-route-userId="@seller.Id"
                       class="profile-action report-button">

                        🚩 Report Seller

                    </a>

                </div>
            }

        </div>


        <!-- =========================================================
             SELLER STATISTICS
             ========================================================= -->

        <div class="profile-stats">


            <div class="profile-stat">

                <span class="profile-stat-number">

                    @Model.TotalProducts

                </span>

                <span class="profile-stat-label">

                    Available Items

                </span>

            </div>


            <div class="profile-stat">

                <span class="profile-stat-number">

                    @if (seller != null && seller.IsVerified)
                    {
                        @:✓
                    }
                    else
                    {
                        @:—
                    }

                </span>

                <span class="profile-stat-label">

                    Verification

                </span>

            </div>


            <div class="profile-stat">

                <span class="profile-stat-number">

                    🟢

                </span>

                <span class="profile-stat-label">

                    Seller

                </span>

            </div>

        </div>

    </div>


    <!-- =========================================================
         PRODUCTS HEADER
         ========================================================= -->

    <div class="products-header">

        <div>

            <h2 class="products-title">

                Seller's Items

            </h2>

            <p class="products-subtitle">

                Browse items currently available from this seller.

            </p>

        </div>

    </div>


    <!-- =========================================================
         PRODUCTS
         ========================================================= -->
    @if (Model.Products != null &&
             Model.Products.Any())
    {

        <div class="seller-products-grid">


            @foreach (var product in Model.Products)
            {

                <div class="seller-product-card">


                    <!-- =================================================
                         PRODUCT IMAGE
                         ================================================= -->

                    <div class="seller-product-image">

                        @if (!string.IsNullOrWhiteSpace(
                            product.ImageUrl))
                        {
                            <img src="@product.ImageUrl"
                                 alt="@product.Name" />
                        }
                        else
                        {
                            <div class="no-product-image">

                                <div class="no-product-image-icon">

                                    🛍️

                                </div>

                                No image available

                            </div>
                        }

                    </div>


                    <!-- =================================================
                         PRODUCT INFORMATION
                         ================================================= -->

                    <div class="seller-product-body">

                        <h3 class="seller-product-name">

                            @product.Name

                        </h3>


                        <div class="seller-product-description">

                            @if (!string.IsNullOrWhiteSpace(
                                product.Description))
                            {
                                @product.Description
                            }
                            else
                            {
                                <span>

                                    No description provided.

                                </span>
                            }

                        </div>


                        <div class="seller-product-price">

                            GH₵ @product.Price.ToString("N2")

                        </div>


                        <a asp-controller="MarketPlace"
                           asp-action="Details"
                           asp-route-id="@product.Id"
                           class="view-product-button">

                            View Item →

                        </a>

                    </div>

                </div>

            }

        </div>

    }
    else
    {

        <!-- =========================================================
             EMPTY PRODUCTS
             ========================================================= -->

        <div class="empty-products">

            <div class="empty-products-icon">

                🛍️

            </div>


            <h3>

                No items available

            </h3>


            <p>

                This seller currently has no items available
                for sale.

            </p>

        </div>

    }

</div>