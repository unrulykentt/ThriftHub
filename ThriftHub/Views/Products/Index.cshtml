@model IEnumerable<ThriftHub.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="products-page">

    <div class="page-header">

        <div>
            <h1>🛍️ ThriftHub Marketplace</h1>
            <p>Discover quality thrift items from our sellers.</p>
        </div>

        <a asp-controller="Products"
           asp-action="Create"
           class="post-button">
            + Post an Item
        </a>

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="message success">
            ✓ @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="message error">
            ⚠ @TempData["ErrorMessage"]
        </div>
    }


    @if (Model != null && Model.Any())
    {
        <div class="products-grid">

            @foreach (var product in Model)
            {
                <div class="product-card">

                    <div class="product-image">

                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl"
                                 alt="@product.Name" />
                        }
                        else
                        {
                            <div class="no-image">
                                🛍️
                                <span>No Image</span>
                            </div>
                        }


                        @if (product.IsSold)
                        {
                            <div class="sold-badge">
                                SOLD
                            </div>
                        }

                    </div>


                    <div class="product-content">

                        <div class="category">
                            @product.Category
                        </div>


                        <h2>
                            @product.Name
                        </h2>


                        @if (!string.IsNullOrWhiteSpace(product.Description))
                        {
                            <p class="description">
                                @product.Description
                            </p>
                        }


                        <div class="product-details">

                            @if (!string.IsNullOrWhiteSpace(product.Condition))
                            {
                                <span>
                                    Condition:
                                    <strong>
                                        @product.Condition
                                    </strong>
                                </span>
                            }


                            @if (!string.IsNullOrWhiteSpace(product.Sizes))
                            {
                                <span>
                                    Sizes:
                                    <strong>
                                        @product.Sizes
                                    </strong>
                                </span>
                            }

                        </div>


                        <div class="product-bottom">

                            <div class="price">
                                GH₵ @product.Price.ToString("N2")
                            </div>


                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@product.Id"
                               class="view-button">

                                View

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-state">

            <div class="empty-icon">
                🛍️
            </div>

            <h2>
                No products yet
            </h2>

            <p>
                Be the first seller to post an item on ThriftHub.
            </p>

            <a asp-controller="Products"
               asp-action="Create"
               class="post-button">

                + Post an Item

            </a>

        </div>
    }

</div>


<style>

    .products-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 24px 80px;
    }


    /* HEADER */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }


        .page-header h1 {
            margin: 0;
            color: #252238;
            font-size: 32px;
            font-weight: 800;
        }


        .page-header p {
            margin: 8px 0 0;
            color: #777386;
        }


    .post-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        background: #6f3cc3;
        color: white;
        padding: 12px 18px;
        border-radius: 9px;
        font-weight: 700;
        white-space: nowrap;
    }


        .post-button:hover {
            background: #54249c;
            color: white;
        }


    /* MESSAGES */

    .message {
        padding: 14px 18px;
        border-radius: 9px;
        margin-bottom: 20px;
        font-weight: 600;
    }


        .message.success {
            background: #e5f8ed;
            color: #27834d;
        }


        .message.error {
            background: #ffe7eb;
            color: #c23d55;
        }


    /* GRID */

    .products-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 22px;
    }


    /* CARD */

    .product-card {
        background: white;
        border: 1px solid #eee9f5;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(70, 40, 110, .06);
        transition: transform .2s ease, box-shadow .2s ease;
    }


        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(70, 40, 110, .12);
        }


    /* IMAGE */

    .product-image {
        position: relative;
        width: 100%;
        height: 270px;
        background: #f7f4fa;
        overflow: hidden;
    }


        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }


    .no-image {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #aaa4b4;
        font-size: 45px;
    }


        .no-image span {
            margin-top: 8px;
            font-size: 12px;
        }


    .sold-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: #c23d55;
        color: white;
        padding: 7px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 800;
    }


    /* CONTENT */

    .product-content {
        padding: 18px;
    }


    .category {
        display: inline-block;
        background: #eee5ff;
        color: #6f3cc3;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 800;
        margin-bottom: 9px;
    }


    .product-content h2 {
        margin: 0;
        color: #252238;
        font-size: 17px;
        font-weight: 800;
        line-height: 1.3;
    }


    .description {
        color: #777386;
        font-size: 12px;
        line-height: 1.5;
        margin: 9px 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }


    /* DETAILS */

    .product-details {
        display: flex;
        flex-direction: column;
        gap: 5px;
        margin-top: 12px;
        color: #9993a6;
        font-size: 11px;
    }


        .product-details strong {
            color: #555064;
        }


    /* BOTTOM */

    .product-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-top: 17px;
        padding-top: 14px;
        border-top: 1px solid #eee9f5;
    }


    .price {
        color: #6f3cc3;
        font-size: 17px;
        font-weight: 900;
    }


    .view-button {
        text-decoration: none;
        background: #f1eff5;
        color: #555064;
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
    }


        .view-button:hover {
            background: #6f3cc3;
            color: white;
        }


    /* EMPTY */

    .empty-state {
        text-align: center;
        background: white;
        border: 1px solid #eee9f5;
        border-radius: 15px;
        padding: 70px 20px;
        box-shadow: 0 5px 20px rgba(70, 40, 110, .05);
    }


    .empty-icon {
        font-size: 55px;
        margin-bottom: 15px;
    }


    .empty-state h2 {
        margin: 0;
        color: #252238;
    }


    .empty-state p {
        color: #777386;
        margin: 8px 0 22px;
    }


    /* RESPONSIVE */

    @@media (max-width: 1000px) {

        .products-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }


    @@media (max-width: 750px) {

        .products-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }


        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }


            .page-header .post-button {
                width: 100%;
            }
    }


    @@media (max-width: 500px) {

        .products-page {
            padding: 30px 15px 60px;
        }


        .products-grid {
            grid-template-columns: 1fr;
        }


        .page-header h1 {
            font-size: 26px;
        }
    }

</style>