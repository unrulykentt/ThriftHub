@{
    ViewData["Title"] = "Privacy Policy";
    ViewData["MetaDescription"] =
        "Learn how ThriftHub collects, uses, and protects your personal information on Ghana's student thrift marketplace.";
    ViewData["AllowIndexing"] = true;

    var effectiveDate = "31 August 2026";
    var contactEmail = "thrifthub372@gmail.com";
}

<div class="th-privacy-page">

    <div class="th-privacy-card">

        <div class="th-privacy-badge">
            Legal
        </div>

        <h1>
            Privacy Policy
        </h1>

        <p class="th-privacy-lead">
            ThriftHub ("we", "us", or "our") operates
            <a href="https://thrifthubgh.com">thrifthubgh.com</a>,
            a student thrift marketplace in Ghana. This policy explains what
            information we collect, how we use it, and the choices you have.
        </p>

        <p class="th-privacy-meta">
            <strong>Effective date:</strong> @effectiveDate
        </p>


        <section class="th-privacy-section">

            <h2>
                1. Information we collect
            </h2>

            <p>
                We collect information you provide directly and information
                generated when you use the platform.
            </p>

            <h3>
                Account and profile information
            </h3>

            <ul>
                <li>Name, email address, phone number, country, and city</li>
                <li>Password (stored in encrypted form — we never see your plain-text password)</li>
                <li>Account type (customer or seller), profile photo, and optional social links</li>
                <li>Email verification codes used to confirm your account</li>
            </ul>

            <h3>
                Seller verification information
            </h3>

            <ul>
                <li>ID card type, ID number, and photos of your ID (front and back) when you apply to sell</li>
                <li>Verification status and related review records</li>
            </ul>

            <p class="th-privacy-note">
                ID information is used for verification and safety. It is not
                shown on your public profile or marketplace listings.
            </p>

            <h3>
                Marketplace activity
            </h3>

            <ul>
                <li>Product listings (title, description, price, category, photos, condition, and sizes)</li>
                <li>Messages you send or receive through ThriftHub chat, including optional file attachments</li>
                <li>Wishlist/favourites, orders, and delivery details you provide at checkout</li>
                <li>Reports, blocks, and safety-related submissions</li>
                <li>Notifications related to your account and activity</li>
            </ul>

            <h3>
                Payments
            </h3>

            <ul>
                <li>Payment references, subscription plan details, and transaction status when you pay through Paystack</li>
                <li>
                    We do not store full card or mobile-money credentials.
                    Payment processing is handled by Paystack under their own privacy terms.
                </li>
            </ul>

            <h3>
                Technical information
            </h3>

            <ul>
                <li>Session cookies and authentication tokens needed to keep you signed in</li>
                <li>Basic server logs (such as IP address, browser type, and pages visited) for security and troubleshooting</li>
            </ul>

        </section>


        <section class="th-privacy-section">

            <h2>
                2. How we use your information
            </h2>

            <ul>
                <li>Create and manage your account</li>
                <li>Verify seller identity and maintain platform safety</li>
                <li>Display listings, enable messaging, and process orders</li>
                <li>Send account, verification, and service-related emails</li>
                <li>Process seller subscriptions and other payments</li>
                <li>Respond to support requests and enforce our rules</li>
                <li>Improve ThriftHub and protect against fraud or abuse</li>
            </ul>

        </section>


        <section class="th-privacy-section">

            <h2>
                3. What other people can see
            </h2>

            <p>
                When you use ThriftHub, certain information is visible to other users:
            </p>

            <ul>
                <li>
                    <strong>Sellers:</strong> display name, profile photo, listings, and public profile details you choose to share
                </li>
                <li>
                    <strong>Buyers and sellers in chat:</strong> messages and attachments you send in a conversation
                </li>
                <li>
                    <strong>Marketplace visitors:</strong> product listing details you publish
                </li>
            </ul>

            <p>
                Your email address, password, ID documents, and verification codes
                are not shown publicly.
            </p>

        </section>


        <section class="th-privacy-section">

            <h2>
                4. How we share information
            </h2>

            <p>
                We do not sell your personal information. We may share data only in these situations:
            </p>

            <ul>
                <li>
                    <strong>Service providers</strong> that help us run ThriftHub, such as hosting (Render),
                    email delivery (Resend or SMTP), and payment processing (Paystack)
                </li>
                <li>
                    <strong>Legal and safety reasons</strong> when required by law or to protect users,
                    ThriftHub, or the public
                </li>
                <li>
                    <strong>With your direction</strong>, such as when you contact another user or complete an order
                </li>
            </ul>

        </section>


        <section class="th-privacy-section">

            <h2>
                5. Data storage and security
            </h2>

            <p>
                Your data is stored on secure servers used to operate ThriftHub.
                Uploaded files (such as product photos and ID images) are stored in
                protected application storage.
            </p>

            <p>
                We use reasonable technical and organisational measures to protect
                your information, including encrypted passwords and access controls.
                No online service can guarantee absolute security, but we work to
                keep ThriftHub safe.
            </p>

        </section>


        <section class="th-privacy-section">

            <h2>
                6. How long we keep information
            </h2>

            <p>
                We keep your information for as long as your account is active or as
                needed to provide the service, comply with legal obligations, resolve
                disputes, and enforce our policies.
            </p>

            <p>
                If you delete your account, we remove or anonymise personal data
                where possible, except where we must retain certain records for legal,
                security, or fraud-prevention purposes.
            </p>

        </section>


        <section class="th-privacy-section">

            <h2>
                7. Your choices and rights
            </h2>

            <ul>
                <li>Update your profile details from your account settings</li>
                <li>Manage wishlist items, listings, and messages within the app</li>
                <li>Request help correcting inaccurate account information</li>
                <li>Delete your account by contacting us if you want your data removed</li>
            </ul>

            <p>
                To exercise these rights, email us at
                <a href="mailto:@contactEmail">@contactEmail</a>.
                We may need to verify your identity before processing certain requests.
            </p>

        </section>


        <section class="th-privacy-section">

            <h2>
                8. Cookies and similar technologies
            </h2>

            <p>
                ThriftHub uses essential cookies and session storage to keep you
                signed in, remember preferences, and operate core features such as
                messaging. These are required for the site to work properly.
            </p>

        </section>


        <section class="th-privacy-section">

            <h2>
                9. Children
            </h2>

            <p>
                ThriftHub is intended for university and student users. If you are
                under 18, you should use the platform only with permission from a
                parent or guardian. If you believe a child has provided personal
                information without consent, contact us and we will take appropriate steps.
            </p>

        </section>


        <section class="th-privacy-section">

            <h2>
                10. Changes to this policy
            </h2>

            <p>
                We may update this Privacy Policy from time to time. When we do, we
                will revise the effective date at the top of this page. Continued use
                of ThriftHub after changes means you accept the updated policy.
            </p>

        </section>


        <section class="th-privacy-section">

            <h2>
                11. Contact us
            </h2>

            <p>
                If you have questions about this Privacy Policy or how your data is handled, contact:
            </p>

            <div class="th-privacy-contact">

                <strong>ThriftHub Support</strong>
                <a href="mailto:@contactEmail">@contactEmail</a>
                <a asp-controller="ContactAdmin"
                   asp-action="Index">
                    Contact admin page →
                </a>

            </div>

        </section>

    </div>

</div>


<style>

    .th-privacy-page {
        max-width: 820px;
        margin: 0 auto;
        padding: 32px 20px 72px;
    }

    .th-privacy-card {
        background: #ffffff;
        border: 1px solid #eee9f5;
        border-radius: 24px;
        padding: clamp(24px, 4vw, 40px);
        box-shadow: 0 12px 40px rgba(108, 61, 217, 0.06);
    }

    .th-privacy-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 999px;
        background: #ede6ff;
        color: #6c3dd9;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        margin-bottom: 14px;
    }

    .th-privacy-card h1 {
        margin: 0 0 12px;
        font-size: clamp(28px, 5vw, 36px);
        color: #252238;
    }

    .th-privacy-lead {
        margin: 0 0 12px;
        color: #777386;
        line-height: 1.65;
        font-size: 16px;
    }

    .th-privacy-lead a,
    .th-privacy-section a {
        color: #6c3dd9;
        font-weight: 700;
        text-decoration: none;
    }

    .th-privacy-lead a:hover,
    .th-privacy-section a:hover {
        text-decoration: underline;
    }

    .th-privacy-meta {
        margin: 0 0 28px;
        color: #777386;
        font-size: 14px;
    }

    .th-privacy-section {
        margin-bottom: 28px;
        padding-top: 8px;
        border-top: 1px solid #f1ebfa;
    }

    .th-privacy-section:first-of-type {
        border-top: none;
        padding-top: 0;
    }

    .th-privacy-section h2 {
        margin: 0 0 12px;
        font-size: 22px;
        color: #252238;
    }

    .th-privacy-section h3 {
        margin: 18px 0 8px;
        font-size: 16px;
        color: #252238;
    }

    .th-privacy-section p,
    .th-privacy-section li {
        color: #555364;
        line-height: 1.65;
        font-size: 15px;
    }

    .th-privacy-section ul {
        margin: 0 0 12px;
        padding-left: 22px;
    }

    .th-privacy-note {
        padding: 14px 16px;
        border-radius: 14px;
        background: #f7f3ff;
        border: 1px solid #ece6f7;
        color: #666 !important;
        font-size: 14px !important;
    }

    .th-privacy-contact {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 18px;
        border-radius: 16px;
        background: #fcfbfe;
        border: 1px dashed #ddd3ef;
    }

    .th-privacy-contact strong {
        color: #252238;
        font-size: 16px;
    }

</style>
