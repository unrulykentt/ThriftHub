@{
    ViewData["Title"] = "Scan to Visit ThriftHub";

    var siteUrl =
        ViewBag.SiteUrl as string
        ?? "https://thrifthubgh.com";

    var displayUrl =
        siteUrl
            .Replace("https://", "", StringComparison.OrdinalIgnoreCase)
            .Replace("http://", "", StringComparison.OrdinalIgnoreCase)
            .TrimEnd('/');
}

<div class="th-qr-page">

    <div class="th-qr-card">

        <div class="th-qr-badge">
            Scan &amp; Shop
        </div>

        <h1>
            Visit ThriftHub
        </h1>

        <p class="th-qr-lead">
            Point your phone camera at the code below to open the marketplace instantly.
        </p>

        <div class="th-qr-image-wrap">

            <img src="@Url.Action("QrCode", "Home")"
                 alt="QR code for @siteUrl"
                 class="th-qr-image"
                 width="280"
                 height="280" />

        </div>

        <div class="th-qr-url">
            @displayUrl
        </div>

        <div class="th-qr-actions">

            <a asp-controller="Home"
               asp-action="QrCode"
               asp-route-download="true"
               class="th-qr-download">

                Download QR Code

            </a>

            <a href="@siteUrl"
               class="th-qr-open">

                Open Website

            </a>

        </div>

        <p class="th-qr-tip">
            Share this page or the downloaded image on posters, WhatsApp status, lecture slides, or hostel notice boards.
        </p>

    </div>

</div>


<style>

    .th-qr-page {
        min-height: calc(100vh - 180px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px 60px;
        background: linear-gradient(180deg, #f7f3ff 0%, #fafafa 100%);
    }

    .th-qr-card {
        width: min(100%, 460px);
        background: #ffffff;
        border: 1px solid #eee9f5;
        border-radius: 24px;
        padding: 32px 28px;
        text-align: center;
        box-shadow: 0 18px 50px rgba(60, 40, 90, 0.10);
    }

    .th-qr-badge {
        display: inline-block;
        background: #f1eaff;
        color: #6f3cc3;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        padding: 7px 12px;
        border-radius: 999px;
        margin-bottom: 14px;
    }

    .th-qr-card h1 {
        margin: 0 0 10px;
        font-size: 30px;
        font-weight: 900;
        color: #252238;
    }

    .th-qr-lead {
        margin: 0 0 24px;
        color: #777386;
        font-size: 14px;
        line-height: 1.55;
    }

    .th-qr-image-wrap {
        display: inline-flex;
        padding: 16px;
        border-radius: 20px;
        background: #ffffff;
        border: 1px solid #ece6f7;
        box-shadow: inset 0 0 0 1px rgba(111, 60, 195, 0.04);
        margin-bottom: 16px;
    }

    .th-qr-image {
        display: block;
        width: 280px;
        height: 280px;
        max-width: 100%;
    }

    .th-qr-url {
        font-size: 18px;
        font-weight: 800;
        color: #6f3cc3;
        margin-bottom: 22px;
    }

    .th-qr-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 18px;
    }

    .th-qr-download,
    .th-qr-open {
        display: block;
        text-decoration: none;
        padding: 13px 16px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 800;
    }

    .th-qr-download {
        background: #6f3cc3;
        color: #ffffff;
    }

    .th-qr-download:hover {
        background: #54249c;
        color: #ffffff;
    }

    .th-qr-open {
        background: #f5f1fa;
        color: #252238;
    }

    .th-qr-open:hover {
        background: #ece6f7;
        color: #252238;
    }

    .th-qr-tip {
        margin: 0;
        font-size: 12px;
        line-height: 1.55;
        color: #9993a8;
    }

</style>
