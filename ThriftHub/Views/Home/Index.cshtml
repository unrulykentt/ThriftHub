@model IEnumerable<ThriftHub.Models.Product>

@{
    ViewData["Title"] = "Home";
    ViewData["MetaDescription"] =
        "Shop pre-loved fashion, textbooks, phones, electronics, and hostel essentials on ThriftHub — Ghana's student thrift marketplace.";
    ViewData["AllowIndexing"] = true;
}

<div class="home-page">

    <!-- HERO SECTION -->

    <section class="hero-section">

        <div class="hero-content">

            <h1>Browse Marketplace</h1>

            <p>
                Discover thrift fashion from sellers around the world.
            </p>

            <div class="hero-buttons">

                <a asp-controller="Marketplace"
                   asp-action="Index"
                   class="primary-button">
                    Browse All Items
                </a>

                <a asp-controller="Seller"
                   asp-action="Create"
                   class="secondary-button">
                    Sell an Item
                </a>

            </div>

        </div>

    </section>


    <!-- PRODUCTS SECTION -->

    <section class="products-section">

        <div class="section-header">

            <div>
                <h2>Latest Items</h2>

                <p>
                    Recently posted items from ThriftHub sellers.
                </p>
            </div>

            <a asp-controller="Marketplace"
               asp-action="Index"
               class="view-all">
                View All →
            </a>

        </div>


        @if (Model != null && Model.Any())
        {
            <div class="products-grid">

                @foreach (var product in Model)
                {
                    <div class="product-card">

                        <!-- PRODUCT IMAGE -->

                        <partial name="_ProductImageWithDetails"
                                 model="product" />


                        <!-- PRODUCT INFORMATION -->

                        <div class="product-information">

                            <partial name="_ProductSellerLabel"
                                     model="product"
                                     view-data="@(new ViewDataDictionary(ViewData)
                                     {
                                         { "SellerLabelClass", "product-seller" }
                                     })" />

                            <span class="product-category">
                                @product.Category
                            </span>

                            <h3>
                                @product.Name
                            </h3>

                            @if (!string.IsNullOrEmpty(product.Description))
                            {
                                <p class="product-description">
                                    @product.Description
                                </p>
                            }

                            <div class="product-bottom">

                                <strong>
                                    GHS @product.Price.ToString("N2")
                                </strong>

                                <a asp-controller="Marketplace"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="view-product">
                                    View
                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-products">

                <div class="empty-icon">
                    🛍️
                </div>

                <h3>No Items Yet</h3>

                <p>
                    There are currently no products available.
                </p>

                <a asp-controller="Seller"
                   asp-action="Create"
                   class="primary-button">
                    Sell an Item
                </a>

            </div>
        }

    </section>

</div>


<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: #fafafa;
        font-family: Arial, Helvetica, sans-serif;
    }


    /* ============================================================
           HOME PAGE
           ============================================================ */

    .home-page {
        width: 92%;
        max-width: 1200px;
        margin: 0 auto 70px;
    }


    /* ============================================================
           HERO
           ============================================================ */

    .hero-section {
        padding: 70px 20px;
        text-align: center;
        background: linear-gradient( 135deg, #f5efff, #ffffff );
        border-radius: 20px;
        margin-top: 30px;
        margin-bottom: 55px;
    }

    .hero-content {
        max-width: 700px;
        margin: auto;
    }

    .hero-section h1 {
        margin: 0 0 15px;
        font-size: 42px;
        color: #222;
    }

    .hero-section p {
        margin: 0 0 28px;
        color: #777;
        font-size: 17px;
    }

    .hero-buttons {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .primary-button,
    .secondary-button {
        display: inline-block;
        text-decoration: none;
        padding: 12px 20px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
    }

    .primary-button {
        background: #7650e8;
        color: white;
    }

        .primary-button:hover {
            background: #6038d1;
        }

    .secondary-button {
        background: #eeeeee;
        color: #333;
    }

        .secondary-button:hover {
            background: #dddddd;
        }


    /* ============================================================
           PRODUCTS SECTION
           ============================================================ */

    .products-section {
        margin-top: 20px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 25px;
    }

        .section-header h2 {
            margin: 0 0 6px;
            font-size: 28px;
            color: #222;
        }

        .section-header p {
            margin: 0;
            color: #777;
            font-size: 14px;
        }

    .view-all {
        text-decoration: none;
        color: #7650e8;
        font-weight: 600;
        font-size: 14px;
    }


    /* ============================================================
           PRODUCT GRID
           ============================================================ */

    .products-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }


    /* ============================================================
           PRODUCT CARD
           ============================================================ */

    .product-card {
        background: white;
        border: 1px solid #eeeeee;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.04);
        transition: 0.2s ease;
    }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 28px rgba(0,0,0,0.08);
        }


    /* ============================================================
           PRODUCT IMAGE
           ============================================================ */

    .product-image {
        width: 100%;
        height: 280px;
        background: #f5f1fa;
        overflow: hidden;
    }

    .no-image {
        color: #999;
        font-size: 14px;
    }


    /* ============================================================
           PRODUCT INFORMATION
           ============================================================ */

    .product-information {
        padding: 18px;
    }

    .product-seller {
        display: inline-block;
        margin-bottom: 8px;
        font-size: 12px;
        font-weight: 800;
        color: #7650e8;
        text-decoration: none;
    }

    .product-seller:hover {
        color: #5b35c8;
        text-decoration: underline;
    }

    .product-category {
        display: inline-block;
        background: #f1eaff;
        color: #7650e8;
        padding: 5px 9px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        margin-bottom: 9px;
    }

    .product-information h3 {
        margin: 0 0 8px;
        font-size: 18px;
        color: #222;
    }

    .product-description {
        color: #777;
        font-size: 13px;
        line-height: 1.5;
        margin: 0 0 15px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }


    /* ============================================================
           PRICE
           ============================================================ */

    .product-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

        .product-bottom strong {
            color: #7650e8;
            font-size: 17px;
        }

    .view-product {
        text-decoration: none;
        background: #7650e8;
        color: white;
        padding: 8px 12px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
    }

        .view-product:hover {
            background: #6038d1;
        }


    /* ============================================================
           EMPTY PRODUCTS
           ============================================================ */

    .empty-products {
        background: white;
        border: 1px solid #eeeeee;
        border-radius: 14px;
        padding: 60px 20px;
        text-align: center;
    }

    .empty-icon {
        font-size: 40px;
        margin-bottom: 15px;
    }

    .empty-products h3 {
        margin: 0 0 8px;
        color: #333;
    }

    .empty-products p {
        color: #777;
        margin: 0 0 20px;
    }


    /* ============================================================
           TABLET
           ============================================================ */

    @@media (max-width: 1000px) {

        .products-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }


    /* ============================================================
           MOBILE
           ============================================================ */

    @@media (max-width: 700px) {

        .home-page {
            width: 94%;
        }

        .hero-section {
            padding: 50px 18px;
        }

            .hero-section h1 {
                font-size: 32px;
            }

            .hero-section p {
                font-size: 15px;
            }

        .products-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .section-header {
            align-items: flex-start;
            flex-direction: column;
        }
    }


    @@media (max-width: 480px) {

        .products-grid {
            grid-template-columns: 1fr;
        }

        .product-image {
            height: 280px;
        }
    }

</style>