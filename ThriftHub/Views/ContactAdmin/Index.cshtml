<style>

    /* ============================================================
           PAGE
           ============================================================ */

    .contact-page {
        max-width: 950px;
        margin: 0 auto;
        padding: 45px 25px 70px;
        font-family: Arial, Helvetica, sans-serif;
    }


    /* ============================================================
           HEADER
           ============================================================ */

    .contact-header {
        text-align: center;
        margin-bottom: 38px;
    }

    .small-heading {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.7px;
        color: #777;
        margin-bottom: 9px;
    }

    .contact-header h1 {
        margin: 0;
        font-size: 32px;
        font-weight: 600;
        color: #252525;
    }

    .contact-header p {
        max-width: 650px;
        margin: 11px auto 0;
        color: #888;
        font-size: 14px;
        line-height: 1.6;
    }


    /* ============================================================
           CONTACT GRID
           ============================================================ */

    .contact-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
    }


    /* ============================================================
           CONTACT CARD
           ============================================================ */

    .contact-card {
        background: #fff;
        border: 1px solid #e9e9e9;
        border-radius: 13px;
        padding: 22px 20px;
        display: flex;
        align-items: center;
        gap: 17px;
        min-height: 105px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.03);
        transition: all 0.2s ease;
    }

        .contact-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 7px 22px rgba(0, 0, 0, 0.06);
            border-color: #ded8ff;
        }


    /* ============================================================
           CONTACT ICON
           ============================================================ */

    .contact-icon {
        width: 50px;
        height: 50px;
        min-width: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        font-weight: 600;
    }


    /* ============================================================
           ICON COLORS
           ============================================================ */

    .email-icon {
        background: #f1ecff;
        color: #6c3df4;
    }

    .phone-icon {
        background: #fff0f5;
        color: #e83e8c;
    }

    .whatsapp-icon {
        background: #eaf9ef;
        color: #1b9b4b;
    }

    .instagram-icon {
        background: #fff0f6;
        color: #d62976;
    }

    .tiktok-icon {
        background: #f1f1f1;
        color: #111;
        font-size: 26px;
    }

    .youtube-icon {
        background: #fff0f0;
        color: #e62117;
    }

    .x-icon {
        background: #f2f2f2;
        color: #111;
        font-size: 21px;
    }

    .snapchat-icon {
        background: #fff8a6;
        color: #111;
        font-size: 24px;
    }


    /* ============================================================
           CONTACT DETAILS
           ============================================================ */

    .contact-details {
        min-width: 0;
    }

        .contact-details h3 {
            margin: 0 0 5px;
            font-size: 15px;
            font-weight: 600;
            color: #333;
        }

        .contact-details p {
            margin: 0 0 7px;
            color: #777;
            font-size: 13px;
            word-break: break-word;
        }

        .contact-details a {
            color: #6c3df4;
            text-decoration: none;
            font-size: 12px;
            font-weight: 600;
        }

            .contact-details a:hover {
                color: #5830d4;
                text-decoration: underline;
            }


    /* ============================================================
           SUPPORT BOX
           ============================================================ */

    .support-box {
        margin-top: 30px;
        padding: 20px 22px;
        border-radius: 13px;
        background: #f8f6ff;
        border: 1px solid #e7e0ff;
        display: flex;
        align-items: flex-start;
        gap: 15px;
    }

    .support-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 10px;
        background: #eee8ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

    .support-box h3 {
        margin: 0 0 6px;
        color: #3d2a7a;
        font-size: 16px;
    }

    .support-box p {
        margin: 0;
        color: #665a86;
        font-size: 12px;
        line-height: 1.7;
    }


    /* ============================================================
           MOBILE
           ============================================================ */

    @@media (max-width: 700px) {

        .contact-page {
            padding: 30px 15px 55px;
        }

        .contact-header h1 {
            font-size: 27px;
        }

        .contact-header p {
            font-size: 13px;
        }

        .contact-grid {
            grid-template-columns: 1fr;
            gap: 14px;
        }

        .contact-card {
            padding: 18px;
        }

        .support-box {
            flex-direction: column;
        }
    }


    /* ============================================================
           SMALL PHONES
           ============================================================ */

    @@media (max-width: 400px) {

        .contact-page {
            padding-left: 12px;
            padding-right: 12px;
        }

        .contact-header h1 {
            font-size: 24px;
        }

        .contact-icon {
            width: 45px;
            height: 45px;
            min-width: 45px;
        }

        .contact-details p {
            font-size: 12px;
        }
    }

</style>