@model IEnumerable<ThriftHub.Models.BlockedUser>

@{
    ViewData["Title"] = "Blocked Users";

    var users = ViewBag.Users as List<ThriftHub.Models.ApplicationUser>
                 ?? new List<ThriftHub.Models.ApplicationUser>();
}

<div class="safety-page">

    <div class="page-header">
        <div>
            <div class="small-heading">
                THRIFTHUB SAFETY
            </div>

            <h1>Blocked Users</h1>

            <p>
                Manage the people you have blocked on ThriftHub.
            </p>
        </div>

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="back-button">
            ← Back to Dashboard
        </a>
    </div>


    <!-- ============================================================
         SUCCESS MESSAGE
         ============================================================ -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert success">
            ✓ @TempData["SuccessMessage"]
        </div>
    }


    <!-- ============================================================
         ERROR MESSAGE
         ============================================================ -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert error">
            ⚠ @TempData["ErrorMessage"]
        </div>
    }


    <!-- ============================================================
         BLOCKED USERS
         ============================================================ -->
    @if (!Model.Any())
    {
        <div class="empty-state">

            <div class="empty-icon">
                🛡️
            </div>

            <h2>No Blocked Users</h2>

            <p>
                You have not blocked anyone yet.
            </p>

            <a asp-controller="MarketPlace"
               asp-action="Index"
               class="primary-button">
                Browse Marketplace
            </a>

        </div>
    }
    else
    {
        <div class="blocked-list">

            @foreach (var blocked in Model)
            {
                var blockedUser = users
                    .FirstOrDefault(u => u.Id == blocked.BlockedUserId);

                <div class="blocked-card">

                    <!-- PROFILE -->

                    <div class="blocked-user-info">

                        @if (!string.IsNullOrWhiteSpace(
                            blockedUser?.ProfileImageUrl))
                        {
                            <img src="@blockedUser.ProfileImageUrl"
                                 alt="Profile"
                                 class="profile-image" />
                        }
                        else
                        {
                            <div class="default-profile">
                                👤
                            </div>
                        }


                        <div class="user-details">

                            <h3>
                                @(blockedUser?.FullName ?? "ThriftHub User")
                            </h3>

                            @if (!string.IsNullOrWhiteSpace(
                                blockedUser?.UserName))
                            {
                                <p>
                                    @@@(blockedUser.UserName)
                                </p>
                            }

                            <span class="blocked-date">
                                Blocked
                                @blocked.CreatedAt.ToLocalTime()
                                .ToString("dd MMM yyyy")
                            </span>

                        </div>

                    </div>


                    <!-- UNBLOCK -->

                    <form asp-controller="Safety"
                          asp-action="UnblockUser"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@blocked.Id" />

                        <button type="submit"
                                class="unblock-button"
                                onclick="return confirm('Are you sure you want to unblock this user?');">

                            Unblock

                        </button>

                    </form>

                </div>
            }

        </div>
    }


    <!-- ============================================================
         SAFETY INFORMATION
         ============================================================ -->

    <div class="safety-info">

        <div class="safety-icon">
            🛡️
        </div>

        <div>

            <h3>
                Your Safety Matters
            </h3>

            <p>
                Blocking a user helps prevent unwanted interaction.
                If someone is behaving suspiciously, threatening you,
                attempting to scam you or violating ThriftHub rules,
                you can also report them to an administrator.
            </p>

        </div>

    </div>

</div>


<style>

    /* ============================================================
           PAGE
           ============================================================ */

    .safety-page {
        max-width: 950px;
        margin: 0 auto;
        padding: 45px 25px 70px;
        font-family: Arial, Helvetica, sans-serif;
    }


    /* ============================================================
           HEADER
           ============================================================ */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 30px;
    }

    .small-heading {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.5px;
        color: #777;
        margin-bottom: 8px;
    }

    .page-header h1 {
        margin: 0;
        font-size: 32px;
        color: #252525;
    }

    .page-header p {
        margin: 9px 0 0;
        color: #888;
        font-size: 14px;
    }


    /* ============================================================
           BACK BUTTON
           ============================================================ */

    .back-button {
        text-decoration: none;
        color: #6c3df4;
        border: 1px solid #ddd;
        padding: 10px 15px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        background: #fff;
    }

        .back-button:hover {
            background: #f7f5ff;
            color: #5830d4;
            text-decoration: none;
        }


    /* ============================================================
           ALERTS
           ============================================================ */

    .alert {
        padding: 14px 18px;
        border-radius: 9px;
        margin-bottom: 20px;
        font-size: 13px;
    }

        .alert.success {
            background: #eaf9ef;
            border: 1px solid #bce8c9;
            color: #16763a;
        }

        .alert.error {
            background: #fff0f0;
            border: 1px solid #f1c3c3;
            color: #b42318;
        }


    /* ============================================================
           BLOCKED LIST
           ============================================================ */

    .blocked-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }


    /* ============================================================
           BLOCKED CARD
           ============================================================ */

    .blocked-card {
        background: #fff;
        border: 1px solid #e9e9e9;
        border-radius: 12px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    }

    .blocked-user-info {
        display: flex;
        align-items: center;
        gap: 15px;
        min-width: 0;
    }


    /* ============================================================
           PROFILE IMAGE
           ============================================================ */

    .profile-image,
    .default-profile {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .profile-image {
        object-fit: cover;
        border: 2px solid #eee;
    }

    .default-profile {
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1ecff;
        border: 2px solid #eee;
        font-size: 25px;
    }


    /* ============================================================
           USER DETAILS
           ============================================================ */

    .user-details h3 {
        margin: 0 0 4px;
        color: #333;
        font-size: 16px;
    }

    .user-details p {
        margin: 0 0 5px;
        color: #888;
        font-size: 12px;
    }

    .blocked-date {
        color: #999;
        font-size: 11px;
    }


    /* ============================================================
           UNBLOCK
           ============================================================ */

    .unblock-button {
        border: 1px solid #ddd;
        background: #fff;
        color: #555;
        padding: 9px 15px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
    }

        .unblock-button:hover {
            background: #f5f5f5;
            border-color: #ccc;
        }


    /* ============================================================
           EMPTY STATE
           ============================================================ */

    .empty-state {
        text-align: center;
        background: #fff;
        border: 1px solid #eee;
        border-radius: 14px;
        padding: 60px 25px;
    }

    .empty-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: #f1ecff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
    }

    .empty-state h2 {
        margin: 0;
        color: #333;
        font-size: 21px;
    }

    .empty-state p {
        color: #888;
        font-size: 13px;
        margin: 8px 0 20px;
    }


    /* ============================================================
           PRIMARY BUTTON
           ============================================================ */

    .primary-button {
        display: inline-block;
        background: #6c3df4;
        color: #fff;
        text-decoration: none;
        padding: 10px 17px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
    }

        .primary-button:hover {
            background: #5830d4;
            color: #fff;
            text-decoration: none;
        }


    /* ============================================================
           SAFETY INFORMATION
           ============================================================ */

    .safety-info {
        margin-top: 30px;
        padding: 20px;
        border-radius: 12px;
        background: #f8f6ff;
        border: 1px solid #e7e0ff;
        display: flex;
        gap: 15px;
        align-items: flex-start;
    }

    .safety-icon {
        font-size: 26px;
    }

    .safety-info h3 {
        margin: 0 0 6px;
        font-size: 16px;
        color: #3d2a7a;
    }

    .safety-info p {
        margin: 0;
        font-size: 12px;
        color: #665a86;
        line-height: 1.6;
    }


    /* ============================================================
           MOBILE
           ============================================================ */

    @@media (max-width: 600px) {

        .safety-page {
            padding: 25px 15px 50px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

            .page-header h1 {
                font-size: 27px;
            }

        .blocked-card {
            align-items: flex-start;
        }

        .blocked-user-info {
            min-width: 0;
        }

        .user-details {
            min-width: 0;
        }

            .user-details h3 {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                max-width: 180px;
            }

        .safety-info {
            flex-direction: column;
        }
    }

</style>