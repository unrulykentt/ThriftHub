@model ThriftHub.Models.Report

@{
    ViewData["Title"] = "Review Report";

    var reportedUser =
        ViewBag.ReportedUser as ThriftHub.Models.ApplicationUser;

    var reporter =
        ViewBag.Reporter as ThriftHub.Models.ApplicationUser;
}

<div class="review-page">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <div class="page-header">

        <div>
            <h1>🛡️ Review Report</h1>

            <p>
                Review the report and take the appropriate administrative action.
            </p>
        </div>

        <a asp-controller="Safety"
           asp-action="AdminReports"
           class="back-button">
            ← Reports & Safety
        </a>

    </div>


    <!-- ========================================================= -->
    <!-- SUCCESS MESSAGE -->
    <!-- ========================================================= -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="message success">
            ✓ @TempData["SuccessMessage"]
        </div>
    }


    <!-- ========================================================= -->
    <!-- ERROR MESSAGE -->
    <!-- ========================================================= -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="message error">
            ⚠ @TempData["ErrorMessage"]
        </div>
    }


    <!-- ========================================================= -->
    <!-- REPORT INFORMATION -->
    <!-- ========================================================= -->

    <div class="card">

        <div class="card-header">

            <div>
                <h2>Report Information</h2>

                <p>
                    Details submitted by the ThriftHub user.
                </p>
            </div>

            <span class="status-badge
                @(Model.Status?.ToLower() == "resolved"
                    ? "resolved"
                    : Model.Status?.ToLower() == "rejected"
                        ? "rejected"
                        : Model.Status?.ToLower() == "reviewed"
                            ? "reviewed"
                            : "pending")">

                @Model.Status

            </span>

        </div>


        <div class="information-grid">

            <div class="information-item">

                <span class="label">
                    Report ID
                </span>

                <strong>
                    #@Model.Id
                </strong>

            </div>


            <div class="information-item">

                <span class="label">
                    Reason
                </span>

                <strong>
                    @Model.Reason
                </strong>

            </div>


            <div class="information-item">

                <span class="label">
                    Submitted
                </span>

                <strong>
                    @Model.CreatedAt.ToLocalTime()
                    .ToString("dd MMM yyyy, hh:mm tt")
                </strong>

            </div>


            <div class="information-item">

                <span class="label">
                    Reporter
                </span>

                <strong>
                    @(reporter?.FullName ?? "Unknown user")
                </strong>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- DESCRIPTION -->
        <!-- ===================================================== -->

        <div class="description-section">

            <h3>
                Report Description
            </h3>

            <div class="description-box">

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    @Model.Description
                }
                else
                {
                    <span class="muted">
                        No additional description was provided.
                    </span>
                }

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- REPORTED USER -->
    <!-- ========================================================= -->

    <div class="card">

        <div class="card-header">

            <div>
                <h2>Reported User</h2>

                <p>
                    Account involved in this report.
                </p>
            </div>

        </div>


        @if (reportedUser != null)
        {
            <div class="user-profile">

                <!-- PROFILE IMAGE -->

                <div class="profile-image">

                    @if (!string.IsNullOrWhiteSpace(
                        reportedUser.ProfileImageUrl))
                    {
                        <img src="@reportedUser.ProfileImageUrl"
                             alt="Profile picture" />
                    }
                    else
                    {
                        <div class="profile-placeholder">
                            👤
                        </div>
                    }

                </div>


                <!-- USER INFORMATION -->

                <div class="user-information">

                    <h3>
                        @(string.IsNullOrWhiteSpace(
                            reportedUser.FullName)
                            ? "No name"
                            : reportedUser.FullName)
                    </h3>


                    <p>
                        @reportedUser.Email
                    </p>


                    <div class="user-badges">

                        <span class="account-badge">
                            @reportedUser.UserType
                        </span>


                        @if (reportedUser.IsVerified)
                        {
                            <span class="verified-badge">
                                ✓ Verified
                            </span>
                        }


                        @if (reportedUser.IsSuspended)
                        {
                            <span class="suspended-badge">
                                ⚠ Suspended
                            </span>
                        }
                        else
                        {
                            <span class="active-badge">
                                ● Active
                            </span>
                        }

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- ACCOUNT STATUS -->
            <!-- ================================================= -->

            <div class="account-status">

                <div>

                    <span class="label">
                        Account Status
                    </span>


                    @if (reportedUser.IsSuspended)
                    {
                        <strong class="danger-text">
                            Suspended
                        </strong>
                    }
                    else
                    {
                        <strong class="success-text">
                            Active
                        </strong>
                    }

                </div>


                @if (reportedUser.IsSuspended)
                {
                    <div>

                        <span class="label">
                            Suspended At
                        </span>

                        <strong>
                            @(reportedUser.SuspendedAt.HasValue
                                ? reportedUser.SuspendedAt.Value
                                    .ToLocalTime()
                                    .ToString(
                                        "dd MMM yyyy, hh:mm tt")
                                : "Unknown")
                        </strong>

                    </div>


                    <div class="reason-full">

                        <span class="label">
                            Suspension Reason
                        </span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(
                                reportedUser.SuspensionReason)
                                ? "No reason provided."
                                : reportedUser.SuspensionReason)
                        </strong>

                    </div>
                }

            </div>


            <!-- ================================================= -->
            <!-- SUSPEND / UNSUSPEND -->
            <!-- ================================================= -->

            <div class="security-actions">

                @if (reportedUser.IsSuspended)
                {
                    <div class="action-warning">

                        <div>

                            <strong>
                                Account is currently suspended
                            </strong>

                            <p>
                                This user cannot use normal
                                ThriftHub account functions while
                                suspended.
                            </p>

                        </div>


                        <form asp-controller="Safety"
                              asp-action="UnsuspendUser"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="reportId"
                                   value="@Model.Id" />

                            <input type="hidden"
                                   name="userId"
                                   value="@reportedUser.Id" />

                            <button type="submit"
                                    class="unsuspend-button"
                                    onclick="return confirm('Are you sure you want to unsuspend this user?');">

                                ✓ Unsuspend User

                            </button>

                        </form>

                    </div>
                }
                else
                {
                    <div class="action-danger">

                        <div>

                            <strong>
                                Suspend this account
                            </strong>

                            <p>
                                Use this option if the report
                                requires the user's account to
                                be temporarily suspended.
                            </p>

                        </div>


                        <button type="button"
                                class="suspend-button"
                                onclick="openSuspendModal()">

                            ⚠ Suspend User

                        </button>

                    </div>
                }

            </div>

        }
        else
        {
            <div class="not-found">

                <div>
                    ⚠
                </div>

                <h3>
                    Reported user not found
                </h3>

                <p>
                    The account associated with this report
                    could not be found.
                </p>

            </div>
        }

    </div>


    <!-- ========================================================= -->
    <!-- ADMINISTRATIVE ACTION -->
    <!-- ========================================================= -->

    <div class="card">

        <div class="card-header">

            <div>

                <h2>
                    Administrative Action
                </h2>

                <p>
                    Update the report status and provide a response.
                </p>

            </div>

        </div>


        <form asp-controller="Safety"
              asp-action="UpdateReport"
              method="post"
              class="report-form">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />


            <!-- STATUS -->

            <div class="form-group">

                <label for="status">
                    Report Status
                </label>

                <select id="status"
                        name="status"
                        class="form-control"
                        required>

                    <option value="Pending"
                            selected="@(Model.Status == "Pending")">

                        Pending

                    </option>

                    <option value="Reviewed"
                            selected="@(Model.Status == "Reviewed")">

                        Reviewed

                    </option>

                    <option value="Resolved"
                            selected="@(Model.Status == "Resolved")">

                        Resolved

                    </option>

                    <option value="Rejected"
                            selected="@(Model.Status == "Rejected")">

                        Rejected

                    </option>

                </select>

            </div>


            <!-- ADMIN RESPONSE -->

            <div class="form-group">

                <label for="adminResponse">
                    Admin Response
                </label>

                <textarea id="adminResponse"
                          name="adminResponse"
                          class="form-control textarea"
                          maxlength="1000"
                          placeholder="Write your response to this report...">@Model.AdminResponse</textarea>

                <small>
                    Maximum 1000 characters.
                </small>

            </div>


            <!-- BUTTONS -->

            <div class="form-actions">

                <a asp-controller="Safety"
                   asp-action="AdminReports"
                   class="cancel-button">

                    Cancel

                </a>


                <button type="submit"
                        class="update-button">

                    ✓ Update Report

                </button>

            </div>

        </form>

    </div>

</div>


<!-- ============================================================= -->
<!-- SUSPEND MODAL -->
<!-- ============================================================= -->
@if (reportedUser != null &&
     !reportedUser.IsSuspended)
{
    <div id="suspendModal"
         class="modal-overlay">

        <div class="modal">

            <div class="modal-icon">
                ⚠️
            </div>

            <h2>
                Suspend User
            </h2>

            <p>
                You are about to suspend:
            </p>

            <strong class="modal-user">
                @(string.IsNullOrWhiteSpace(
                    reportedUser.FullName)
                    ? reportedUser.Email
                    : reportedUser.FullName)
            </strong>


            <form asp-controller="Safety"
                  asp-action="SuspendUser"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="reportId"
                       value="@Model.Id" />

                <input type="hidden"
                       name="userId"
                       value="@reportedUser.Id" />


                <div class="form-group">

                    <label for="reason">
                        Suspension Reason
                    </label>

                    <textarea id="reason"
                              name="reason"
                              class="form-control textarea"
                              maxlength="1000"
                              required
                              placeholder="Enter the reason for suspending this account..."></textarea>

                </div>


                <div class="modal-actions">

                    <button type="button"
                            class="cancel-button"
                            onclick="closeSuspendModal()">

                        Cancel

                    </button>


                    <button type="submit"
                            class="confirm-suspend-button">

                        ⚠ Confirm Suspension

                    </button>

                </div>

            </form>

        </div>

    </div>
}


<!-- ============================================================= -->
<!-- JAVASCRIPT -->
<!-- ============================================================= -->

<script>

    function openSuspendModal() {

        const modal =
            document.getElementById("suspendModal");

        if (modal) {

            modal.classList.add("show");

        }

    }


    function closeSuspendModal() {

        const modal =
            document.getElementById("suspendModal");

        if (modal) {

            modal.classList.remove("show");

        }

    }


    window.addEventListener(
        "click",
        function(event) {

            const modal =
                document.getElementById("suspendModal");

            if (
                modal &&
                event.target === modal
            ) {

                closeSuspendModal();

            }

        }
    );

</script>


<!-- ============================================================= -->
<!-- STYLES -->
<!-- ============================================================= -->

<style>

    .review-page {
        max-width: 1050px;
        margin: 0 auto;
        padding: 40px 24px 80px;
    }


    /* HEADER */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }


        .page-header h1 {
            margin: 0;
            color: #252238;
            font-size: 32px;
            font-weight: 800;
        }


        .page-header p {
            margin-top: 8px;
            color: #777386;
        }


    .back-button {
        text-decoration: none;
        background: #6f3cc3;
        color: white;
        padding: 11px 18px;
        border-radius: 9px;
        font-weight: 700;
    }


        .back-button:hover {
            background: #54249c;
            color: white;
        }


    /* MESSAGES */

    .message {
        padding: 14px 18px;
        border-radius: 9px;
        margin-bottom: 20px;
        font-weight: 600;
    }


        .message.success {
            background: #e5f8ed;
            color: #27834d;
        }


        .message.error {
            background: #ffe7eb;
            color: #c23d55;
        }


    /* CARD */

    .card {
        background: white;
        border: 1px solid #eee9f5;
        border-radius: 14px;
        box-shadow: 0 5px 20px rgba(70, 40, 110, .06);
        padding: 25px;
        margin-bottom: 24px;
    }


    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 25px;
    }


        .card-header h2 {
            margin: 0;
            color: #252238;
            font-size: 21px;
        }


        .card-header p {
            margin: 7px 0 0;
            color: #777386;
            font-size: 13px;
        }


    /* STATUS */

    .status-badge {
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 800;
    }


        .status-badge.pending {
            background: #fff4d8;
            color: #9b7200;
        }


        .status-badge.reviewed {
            background: #e7f0ff;
            color: #3568b8;
        }


        .status-badge.resolved {
            background: #e5f8ed;
            color: #27834d;
        }


        .status-badge.rejected {
            background: #ffe7eb;
            color: #c23d55;
        }


    /* INFORMATION */

    .information-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }


    .information-item {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }


    .label {
        display: block;
        color: #9993a6;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
    }


    .information-item strong {
        color: #252238;
        font-size: 13px;
    }


    /* DESCRIPTION */

    .description-section {
        margin-top: 30px;
    }


        .description-section h3 {
            font-size: 14px;
            color: #252238;
            margin-bottom: 10px;
        }


    .description-box {
        background: #f8f6fb;
        border-radius: 10px;
        padding: 18px;
        color: #555064;
        min-height: 80px;
        white-space: pre-wrap;
        line-height: 1.6;
    }


    .muted {
        color: #9993a6;
    }


    /* USER */

    .user-profile {
        display: flex;
        align-items: center;
        gap: 18px;
        padding-bottom: 25px;
        border-bottom: 1px solid #eee9f5;
    }


    .profile-image {
        width: 75px;
        height: 75px;
        border-radius: 50%;
        overflow: hidden;
        flex-shrink: 0;
    }


        .profile-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }


    .profile-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eee5ff;
        font-size: 30px;
    }


    .user-information h3 {
        margin: 0 0 5px;
        color: #252238;
    }


    .user-information p {
        margin: 0 0 10px;
        color: #777386;
        font-size: 13px;
    }


    .user-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
    }


    .account-badge,
    .verified-badge,
    .suspended-badge,
    .active-badge {
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 800;
    }


    .account-badge {
        background: #eee5ff;
        color: #6f3cc3;
    }


    .verified-badge {
        background: #e5f8ed;
        color: #27834d;
    }


    .suspended-badge {
        background: #ffe7eb;
        color: #c23d55;
    }


    .active-badge {
        background: #e5f8ed;
        color: #27834d;
    }


    /* ACCOUNT STATUS */

    .account-status {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        padding: 20px 0;
    }


        .account-status > div {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }


    .danger-text {
        color: #c23d55;
    }


    .success-text {
        color: #27834d;
    }


    .reason-full {
        grid-column: span 1;
    }


    /* SECURITY ACTIONS */

    .security-actions {
        border-top: 1px solid #eee9f5;
        padding-top: 20px;
    }


    .action-danger,
    .action-warning {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 18px;
        border-radius: 10px;
    }


    .action-danger {
        background: #fff5f6;
        border: 1px solid #ffd9df;
    }


    .action-warning {
        background: #fff8e7;
        border: 1px solid #ffe7a9;
    }


    .action-danger strong {
        color: #b3324a;
    }


    .action-warning strong {
        color: #936b00;
    }


    .action-danger p,
    .action-warning p {
        margin: 5px 0 0;
        color: #777386;
        font-size: 12px;
    }


    .suspend-button {
        border: none;
        background: #c23d55;
        color: white;
        padding: 11px 16px;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
    }


    .unsuspend-button {
        border: none;
        background: #27834d;
        color: white;
        padding: 11px 16px;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
    }


        .suspend-button:hover,
        .unsuspend-button:hover {
            opacity: .85;
        }


    /* FORM */

    .form-group {
        margin-bottom: 22px;
    }


        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #555064;
            font-size: 13px;
            font-weight: 700;
        }


    .form-control {
        width: 100%;
        box-sizing: border-box;
        border: 1px solid #ddd7e8;
        border-radius: 9px;
        padding: 12px 14px;
        background: white;
        color: #252238;
        font-family: inherit;
    }


        .form-control:focus {
            outline: none;
            border-color: #6f3cc3;
            box-shadow: 0 0 0 3px rgba(111, 60, 195, .1);
        }


    .textarea {
        min-height: 150px;
        resize: vertical;
        line-height: 1.6;
    }


    .form-group small {
        display: block;
        margin-top: 6px;
        color: #9993a6;
        font-size: 11px;
    }


    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 10px;
    }


    .cancel-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border: none;
        background: #f1eff5;
        color: #555064;
        padding: 11px 18px;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
    }


    .update-button {
        border: none;
        background: #6f3cc3;
        color: white;
        padding: 11px 18px;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
    }


        .update-button:hover {
            background: #54249c;
        }


    /* NOT FOUND */

    .not-found {
        text-align: center;
        padding: 35px;
    }


        .not-found > div {
            font-size: 40px;
        }


        .not-found h3 {
            color: #252238;
        }


        .not-found p {
            color: #777386;
        }


    /* MODAL */

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(20, 15, 30, .55);
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        z-index: 9999;
    }


        .modal-overlay.show {
            display: flex;
        }


    .modal {
        width: 100%;
        max-width: 500px;
        background: white;
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, .2);
    }


    .modal-icon {
        width: 55px;
        height: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff0f2;
        border-radius: 50%;
        font-size: 25px;
        margin-bottom: 15px;
    }


    .modal h2 {
        margin: 0;
        color: #252238;
    }


    .modal p {
        color: #777386;
        margin-bottom: 5px;
    }


    .modal-user {
        display: block;
        color: #252238;
        margin-bottom: 20px;
    }


    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 20px;
    }


    .confirm-suspend-button {
        border: none;
        background: #c23d55;
        color: white;
        padding: 11px 16px;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
    }


    /* RESPONSIVE */

    @@media (max-width: 800px) {

        .review-page {
            padding: 30px 15px 60px;
        }


        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }


        .back-button {
            width: 100%;
            text-align: center;
        }


        .information-grid {
            grid-template-columns: repeat(2, 1fr);
        }


        .account-status {
            grid-template-columns: 1fr;
        }


        .action-danger,
        .action-warning {
            flex-direction: column;
            align-items: flex-start;
        }
    }


    @@media (max-width: 500px) {

        .information-grid {
            grid-template-columns: 1fr;
        }


        .user-profile {
            align-items: flex-start;
        }


        .form-actions,
        .modal-actions {
            flex-direction: column;
        }


        .cancel-button,
        .update-button,
        .confirm-suspend-button {
            width: 100%;
            box-sizing: border-box;
            text-align: center;
        }
    }

</style>