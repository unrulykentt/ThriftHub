{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=thrifthub.db"
  },

  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "YOUR_GMAIL_HERE@gmail.com",
    "SenderPassword": "YOUR_GMAIL_APP_PASSWORD_HERE",
    "SenderName": "ThriftHub"
  },

  "Resend": {
    "ApiKey": "YOUR_RESEND_API_KEY_HERE",
    "FromEmail": "noreply@thrifthubgh.com",
    "FromName": "ThriftHub"
  },

  "ThriftHub": {
    "DataPath": "/data"
  },

  "Paystack": {
    "SecretKey": "YOUR_PAYSTACK_SECRET_KEY_HERE",
    "PublicKey": "YOUR_PAYSTACK_PUBLIC_KEY_HERE",
    "callbackUrl": "https://localhost:7071/subscription/callback"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
