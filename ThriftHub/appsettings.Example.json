{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=thrifthub.db"
  },

  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "YOUR_GMAIL_HERE@gmail.com",
    "SenderPassword": "YOUR_GMAIL_APP_PASSWORD_HERE",
    "SenderName": "ThriftHub"
  },

  "Resend": {
    "ApiKey": "YOUR_RESEND_API_KEY_HERE",
    "FromEmail": "noreply@thrifthubgh.com",
    "FromName": "ThriftHub"
  },

  "Authentication": {
    "Apple": {
      "ClientId": "com.yourdomain.thrifthub.service",
      "TeamId": "YOUR_APPLE_TEAM_ID",
      "KeyId": "YOUR_APPLE_KEY_ID",
      "PrivateKey": "-----BEGIN PRIVATE KEY-----\\nYOUR_KEY\\n-----END PRIVATE KEY-----"
    }
  },

  "ThriftHub": {
    "DataPath": "/data",
    "PublicUrl": "https://thrifthubgh.com",
    "GoogleSiteVerification": "YOUR_GOOGLE_SEARCH_CONSOLE_VERIFICATION_CODE"
  },

  "Paystack": {
    "SecretKey": "YOUR_PAYSTACK_SECRET_KEY_HERE",
    "PublicKey": "YOUR_PAYSTACK_PUBLIC_KEY_HERE",
    "callbackUrl": "https://localhost:7071/subscription/callback"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
